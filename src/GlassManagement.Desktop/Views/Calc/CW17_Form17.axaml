<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GlassManagement.Desktop.Views.Calc.CW17_Form17"
             FontFamily="SimSun" FontSize="12">
  <!-- VB6 form: 埋件系统计算 | client 787x489 | 212 nodes (117 labels) | pairs=50 spread=11px dropped=0 declutter:drop=0 move=2 -->
  <DockPanel>
    <Border DockPanel.Dock="Top" Height="19" Background="{DynamicResource HbTitleBarBg}" BorderBrush="{DynamicResource HbBorder}" BorderThickness="0,0,0,1">
      <TextBlock Text="埋件系统计算" FontSize="11" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource HbText}"/>
    </Border>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
    <Canvas Width="787" Height="489" Background="{DynamicResource HbFormBg}" ClipToBounds="True">
      <!-- 互斥参数面板（源程序按选项切换显示），共 7 套 -->
      <TabControl Canvas.Left="6" Canvas.Top="7" Width="775" Height="456">
        <TabItem Header="焊缝计算">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <Canvas Width="467" Height="449" Background="{DynamicResource HbFormBg}" ClipToBounds="True">
