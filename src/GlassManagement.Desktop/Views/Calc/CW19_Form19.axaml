<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GlassManagement.Desktop.Views.Calc.CW19_Form19"
             FontFamily="SimSun" FontSize="12">
  <!-- VB6 form: 幕墙（门窗）物理性能计算 | client 885x541 | 160 nodes (90 labels) | pairs=38 spread=16px dropped=0 declutter:drop=0 move=0 -->
  <DockPanel>
    <Border DockPanel.Dock="Top" Height="19" Background="{DynamicResource HbTitleBarBg}" BorderBrush="{DynamicResource HbBorder}" BorderThickness="0,0,0,1">
      <TextBlock Text="幕墙（门窗）物理性能计算" FontSize="11" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource HbText}"/>
    </Border>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
    <Canvas Width="885" Height="541" Background="{DynamicResource HbFormBg}" ClipToBounds="True">
      <!-- 互斥参数面板（源程序按选项切换显示），共 6 套 -->
