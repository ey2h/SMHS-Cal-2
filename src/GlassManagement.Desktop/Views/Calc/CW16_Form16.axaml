<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GlassManagement.Desktop.Views.Calc.CW16_Form16"
             FontFamily="SimSun" FontSize="12">
  <!-- VB6 form: 幕墙计算-埋件与焊缝计算 | client 788x490 | 178 nodes (78 labels) | pairs=19 spread=15px dropped=0 declutter:drop=4 move=1 -->
  <DockPanel>
    <Border DockPanel.Dock="Top" Height="19" Background="{DynamicResource HbTitleBarBg}" BorderBrush="{DynamicResource HbBorder}" BorderThickness="0,0,0,1">
      <TextBlock Text="幕墙计算-埋件与焊缝计算" FontSize="11" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource HbText}"/>
    </Border>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
    <Canvas Width="788" Height="490" Background="{DynamicResource HbFormBg}" ClipToBounds="True">
      <!-- 互斥参数面板（源程序按选项切换显示），共 8 套 -->
      <TabControl Canvas.Left="7" Canvas.Top="5" Width="773" Height="460">
        <TabItem Header="焊缝计算">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <Canvas Width="466" Height="449" Background="{DynamicResource HbFormBg}" ClipToBounds="True">
          <Border Classes="hbFrame" Canvas.Left="4" Canvas.Top="70" Width="161" Height="160"/>
          <TextBlock Classes="hbFrameTitle" Canvas.Left="10" Canvas.Top="61" Text="后锚固参数"/>
          <Button Classes="hb" Canvas.Left="397" Canvas.Top="72" Width="40" Height="20" FontSize="12" HorizontalContentAlignment="Center"><TextBlock Classes="hb" Text="说明" FontSize="12" TextTrimming="CharacterEllipsis"/></Button>
          <TextBox Classes="hb" Canvas.Left="104" Canvas.Top="78" Width="60" Height="19" FontSize="12" Text="28"/>
          <Button Classes="hb" Canvas.Left="10" Canvas.Top="96" Width="147" MinHeight="31" FontSize="10" HorizontalContentAlignment="Left"><TextBlock Classes="hb" Text="&gt;&gt;完善后锚固参数&lt;&lt;" FontSize="10" TextWrapping="Wrap" LineHeight="13"/></Button>
          <TextBox Classes="hb" Canvas.Left="128" Canvas.Top="99" Width="60" Height="19" FontSize="12" Text="90"/>
          <TextBox Classes="hb" Canvas.Left="102" Canvas.Top="120" Width="60" Height="19" FontSize="12" Text="120"/>
          <ComboBox Classes="hb" Canvas.Left="101" Canvas.Top="147" Width="61" Height="20"/>
          <TextBlock Classes="hb" Canvas.Left="264" Canvas.Top="152" Width="48" Height="13" Text="构件材质" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
          <ComboBox Classes="hb" Canvas.Left="121" Canvas.Top="169" Width="94" Height="20"/>
          <TextBlock Classes="hb" Canvas.Left="21" Canvas.Top="171" Width="84" Height="13" Text="混凝土基材类型" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
          <TextBox Classes="hb" Canvas.Left="121" Canvas.Top="191" Width="60" Height="19" FontSize="12" Text="250"/>
          <Border Classes="hbFrame" Canvas.Left="4" Canvas.Top="231" Width="465" Height="224"/>
          <TextBlock Classes="hbFrameTitle" Canvas.Left="10" Canvas.Top="222" Text="受力方式"/>
          <Border Classes="hbPanel" Canvas.Left="60" Canvas.Top="280" Width="185" Height="145"/>
          <DataGrid Classes="hb" Canvas.Left="7" Canvas.Top="305" Width="496" Height="145"/>
          <TextBlock Classes="hb" Canvas.Left="331" Canvas.Top="306" Width="90" Height="13" Text="b=           mm" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
          <Border Classes="hbFrame" Canvas.Left="268" Canvas.Top="320" Width="145" Height="89"/>
          <TextBlock Classes="hbFrameTitle" Canvas.Left="274" Canvas.Top="311" Text="左图参数(mm)"/>
          <TextBlock Classes="hb" Canvas.Left="331" Canvas.Top="330" Width="90" Height="13" Text="c=           mm" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
          <TextBox Classes="hb" Canvas.Left="316" Canvas.Top="352" Width="65" Height="25" FontSize="12" Text="80"/>
          <TextBlock Classes="hb" Canvas.Left="331" Canvas.Top="354" Width="90" Height="13" Text="c1=          mm" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
          <TextBlock Classes="hb" Canvas.Left="27" Canvas.Top="379" Width="156" Height="13" Text="埋板钢板厚度t           mm" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
          <TextBlock Classes="hb" Canvas.Left="331" Canvas.Top="379" Width="90" Height="13" Text="c2=          mm" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
          <TextBlock Classes="hb" Canvas.Left="3" Canvas.Top="392" Width="433" Height="49" Text="对L型焊缝或三边围焊，软件会自动套用公式求得有效抵抗矩，其它焊缝样式，需要用户自己求得焊缝有效截面积以及有效抵抗矩，具体求法和计算截面一样，用SMHS其它计算菜单下截面计算功能，参看L型或三边围焊的示意图做成面域后操作即可。" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
          </Canvas>
          </ScrollViewer>
        </TabItem>
