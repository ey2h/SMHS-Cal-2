          <TextBox Classes="hb" Canvas.Left="104" Canvas.Top="101" Width="60" Height="19" FontSize="12" Text="90"/>
          <TextBox Classes="hb" Canvas.Left="104" Canvas.Top="122" Width="60" Height="19" FontSize="12" Text="120"/>
          <ComboBox Classes="hb" Canvas.Left="101" Canvas.Top="149" Width="61" Height="20"/>
          <TextBlock Classes="hb" Canvas.Left="264" Canvas.Top="152" Width="48" Height="13" Text="构件材质" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
          <TextBlock Classes="hb" Canvas.Left="21" Canvas.Top="171" Width="84" Height="13" Text="混凝土基材类型" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
          <TextBox Classes="hb" Canvas.Left="121" Canvas.Top="193" Width="60" Height="19" FontSize="12" Text="250"/>
          <Border Classes="hbFrame" Canvas.Left="10" Canvas.Top="219" Width="491" Height="88"/>
          <TextBlock Classes="hbFrameTitle" Canvas.Left="16" Canvas.Top="210" Text="混凝土裂缝及配筋情况"/>
          <CheckBox Classes="hb" Canvas.Left="295" Canvas.Top="232" Width="194" MinHeight="53" FontSize="10" HorizontalContentAlignment="Left"><TextBlock Classes="hb" Text="当混凝土内箍筋的直径φ≥12mm且间距不大于150mm或箍筋的直径φ≤10mm且间距不大于100mm" FontSize="10" TextWrapping="Wrap" LineHeight="13"/></CheckBox>
