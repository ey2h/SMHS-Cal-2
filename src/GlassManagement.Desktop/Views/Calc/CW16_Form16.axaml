          <ComboBox Classes="hb" Canvas.Left="164" Canvas.Top="3" Width="94" Height="20"/>
          <TextBlock Classes="hb" Canvas.Left="0" Canvas.Top="7" Width="409" Height="39" Text="画出焊缝断面实际形状，参看左图示意的方法绘制有效截面（剖面线部分），之后做出面域，用SMHS截面计算功能求得参数后，输入到右侧的参数框中。（hf为焊脚高度，he=0.7hf为焊缝有效厚度），输入的焊缝有效抵抗矩取wx1与wx2两者中的较小值，注意单位。" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
          <DataGrid Classes="hb" Canvas.Left="0" Canvas.Top="13" Width="762" Height="92"/>
          <ComboBox Classes="hb" Canvas.Left="62" Canvas.Top="24" Width="53" Height="20"/>
