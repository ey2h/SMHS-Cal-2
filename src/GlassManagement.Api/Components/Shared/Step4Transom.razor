@using System.Text.Json
@using static GlassManagement.Api.Components.Pages.Wizard
@inject GlassApiClient GlassApi

<!-- 标题条 -->
<div class="hb-title-bar">@CurtainWallType 幕墙计算 - 横梁计算</div>

<div style="display:flex;gap:10px;align-items:flex-start">
    <!-- ====== 左侧参数区 ====== -->
    <div style="flex:1;min-width:0">

        <!-- 横梁参数 -->
        <fieldset class="groupbox">
            <legend class="groupbox-title">横梁参数</legend>
            <div class="param-row">
                <span class="param-label">横梁跨度 L</span>
                <input class="hb-input" style="width:70px" type="number" @bind="Input.Span" step="1" @bind:after="Recalc"/>
                <span class="param-unit">mm</span>
            </div>
            <div class="param-row" style="margin-top:4px">
                <span class="param-label">荷载模型</span>
                <div class="hb-radio-group horizontal">
                    <label><input type="radio" name="loadmodel" value="三角形分布" checked="@(Input.LoadModel=="三角形分布")"
                        @onchange='() => { Input.LoadModel="三角形分布"; Recalc(); }'/>三角形</label>
                    <label><input type="radio" name="loadmodel" value="均布" checked="@(Input.LoadModel=="均布")"
                        @onchange='() => { Input.LoadModel="均布"; Recalc(); }'/>均布</label>
                </div>
            </div>
        </fieldset>

        <!-- 横梁选材 -->
        <fieldset class="groupbox">
            <legend class="groupbox-title">横梁选材</legend>
            <div class="hb-radio-group horizontal" style="margin-bottom:4px">
                @foreach (var g in new[] { "6063-T5", "6063-T6", "6061-T4", "6061-T6", "6063A-T5", "6063A-T6" })
                {
                    var grade = g;
                    <label><input type="radio" name="materialGrade4" checked="@(Input.Material=="铝合金" && Input.AluminumGrade==grade)" @onchange="() => SelectAluGrade(grade)" />@grade</label>
                }
            </div>
            <div class="hb-radio-group horizontal" style="margin-bottom:4px">
                @foreach (var g in new[] { "Q235", "Q355" })
                {
                    var grade = g;
                    <label><input type="radio" name="materialGrade4" checked="@(Input.Material=="钢材" && Input.SteelGrade==grade)" @onchange="() => SelectSteelGrade(grade)" />@grade</label>
                }
                <label><input type="radio" name="materialGrade4" checked="@(Input.Material=="其它")" @onchange="() => SelectOtherMaterial()" />其它材质</label>
            </div>

            @if (Input.Material == "其它")
            {
                <fieldset class="groupbox" style="margin-top:4px;background:var(--bg-page)">
                    <legend class="groupbox-title" style="font-size:11px">其它材质参数</legend>
                    <div style="display:grid;grid-template-columns:auto 1fr auto 1fr auto;gap:4px;align-items:center;font-size:11px">
                        <span class="param-label">名称</span>
                        <input class="hb-input" @bind="Input.OtherMaterialName" />
                        <span class="param-label">弹性模量</span>
                        <input class="hb-input" style="width:70px" type="number" @bind="Input.ElasticModulus" step="100" @bind:after="Recalc" />
                        <span class="param-unit">MPa</span>
                        <span class="param-label">类别</span>
                        <select class="hb-input" @bind="Input.MaterialCategory"><option>铝</option><option>钢</option></select>
                        <span class="param-label">抗弯强度</span>
                        <input class="hb-input" style="width:70px" type="number" @bind="Input.AllowableStress" step="1" @bind:after="Recalc" />
                        <span class="param-unit">MPa</span>
                        <span></span><span></span>
                        <span class="param-label">抗剪强度</span>
                        <input class="hb-input" style="width:70px" type="number" @bind="Input.AllowableShear" step="1" @bind:after="Recalc" />
                        <span class="param-unit">MPa</span>
                    </div>
                </fieldset>
            }

            <div style="margin-top:4px;display:flex;gap:12px;flex-wrap:wrap">
                @if (IsAluminum)
                {
                    <label class="hb-checkbox"><input type="checkbox" @bind="Input.IsThermalBreak" />断热</label>
                }
                @if (IsSteel)
                {
                    <label class="hb-checkbox"><input type="checkbox" @bind="Input.ColdFormedSteel" />冷弯薄壁型钢</label>
                }
            </div>
        </fieldset>

        <!-- 横梁特有选项 -->
        <fieldset class="groupbox">
            <legend class="groupbox-title">横梁选项</legend>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:4px;font-size:12px">
                <label class="hb-checkbox"><input type="checkbox" @bind="Input.SteelAlumComposite" @bind:after="OnSteelAlumChanged" />钢铝结合</label>
                <label class="hb-checkbox" title="挂式结构的横龙骨承受的自重是下分格施加的，非挂式结构则反之。">
                    <input type="checkbox" @bind="Input.HangingStructure" @bind:after="Recalc" />挂式结构
                </label>
                <label class="hb-checkbox" title="对于玻璃下面有2个托块的明框、半隐显横等结构请选中此项，这种模式对横框受力非常有力。">
                    <input type="checkbox" @bind="Input.GlassWeightConcentrated" @bind:after="Recalc" />玻璃自重为集中力
                </label>
                <label class="hb-checkbox"><input type="checkbox" @bind="Input.ConcentratedForceModel" @bind:after="Recalc" />按集中力模型</label>
                <label class="hb-checkbox"><input type="checkbox" @bind="Input.CalculateTorsion" @bind:after="Recalc" />计算抗扭</label>
            </div>

            <div class="param-row" style="margin-top:6px">
                <span class="param-label">受力点到横梁与立柱连接点距离</span>
                <input class="hb-input" style="width:70px" type="number" @bind="Input.ForcePointDistance" step="1"
                       disabled="@(!Input.GlassWeightConcentrated)" @bind:after="Recalc"/>
                <span class="param-unit">mm</span>
                @if (!Input.GlassWeightConcentrated)
                {
                    <span style="font-size:10px;color:var(--text-muted);margin-left:4px">（勾选"玻璃自重为集中力"后启用）</span>
                }
            </div>

            <div style="margin-top:4px;display:flex;gap:8px;align-items:center">
                <label class="hb-checkbox"><input type="checkbox" @bind="Input.ShortCantilever" @bind:after="Recalc" />短悬臂结构</label>
                @if (Input.ShortCantilever)
                {
                    <span class="param-label">悬臂总尺寸</span>
                    <input class="hb-input" style="width:70px" type="number" @bind="Input.CantileverSize" step="1" @bind:after="Recalc"/>
                    <span class="param-unit">mm</span>
                }
            </div>

            <div style="margin-top:6px">
                <button class="hb-btn" style="height:24px;padding:0 10px;font-size:11px" type="button" disabled="@(!Input.CalculateTorsion)">
                    &gt;&gt;完善抗扭参数&lt;&lt;
                </button>
            </div>
        </fieldset>
    </div>

    <!-- ====== 中间：型材表格 / 钢铝结合面板 ====== -->
    @if (Input.SteelAlumComposite)
    {
        <div style="flex:1.4;min-width:0">
            <!-- 铝框型材 -->
            <fieldset class="groupbox">
                <legend class="groupbox-title">铝框型材（钢铝结合）</legend>
                <div class="hb-search" style="margin-bottom:4px">
                    <input class="hb-input" style="width:100%" placeholder="搜索铝框型材..." @bind="_saAluSearch" @bind:event="oninput" @bind:after="FilterSaAluProfiles"/>
                </div>
                @if (_saLoading)
                {
                    <div style="text-align:center;padding:12px;color:var(--text-muted)"><span class="spinner"></span> 加载中...</div>
                }
                else
                {
                    <div style="max-height:200px;overflow:auto">
                        <table class="hb-table" style="font-size:11px">
                            <thead><tr><th>型材代号</th><th>Ix</th><th>Iy</th><th>Wx1</th><th>Wx2</th><th>壁厚</th><th>截面积</th></tr></thead>
                            <tbody>
                                @foreach (var p in _filteredSaAluProfiles)
                                {
                                    var pCode = GetStr(p, "code");
                                    var sel = pCode == _selectedSaAluCode;
                                    <tr class="@(sel?"selected":"")" style="cursor:pointer" @onclick="() => { _selectedSaAluCode = pCode; }">
                                        <td style="font-weight:600">@pCode</td>
                                        <td>@GetNum(p,"ix")</td><td>@GetNum(p,"iy")</td>
                                        <td>@GetNum(p,"wx1")</td><td>@GetNum(p,"wx2")</td>
                                        <td>@GetNum(p,"wallThickness")</td><td>@GetNum(p,"area")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div style="font-size:10px;color:var(--text-muted);text-align:right">共 @(_allSaAluProfiles?.Count ?? 0) 条</div>
                }
            </fieldset>
            <!-- 钢框型材 -->
            <fieldset class="groupbox">
                <legend class="groupbox-title">钢框型材（钢铝结合）</legend>
                <div class="hb-search" style="margin-bottom:4px">
                    <input class="hb-input" style="width:100%" placeholder="搜索钢框型材..." @bind="_saSteelSearch" @bind:event="oninput" @bind:after="FilterSaSteelProfiles"/>
                </div>
                @if (_saLoading)
                {
                    <div style="text-align:center;padding:12px;color:var(--text-muted)"><span class="spinner"></span> 加载中...</div>
                }
                else
                {
                    <div style="max-height:200px;overflow:auto">
                        <table class="hb-table" style="font-size:11px">
                            <thead><tr><th>型材代号</th><th>Ix</th><th>Iy</th><th>Wx1</th><th>Wx2</th><th>壁厚</th><th>截面积</th></tr></thead>
                            <tbody>
                                @foreach (var p in _filteredSaSteelProfiles)
                                {
                                    var pCode = GetStr(p, "code");
                                    var sel = pCode == _selectedSaSteelCode;
                                    <tr class="@(sel?"selected":"")" style="cursor:pointer" @onclick="() => { _selectedSaSteelCode = pCode; }">
                                        <td style="font-weight:600">@pCode</td>
                                        <td>@GetNum(p,"ix")</td><td>@GetNum(p,"iy")</td>
                                        <td>@GetNum(p,"wx1")</td><td>@GetNum(p,"wx2")</td>
                                        <td>@GetNum(p,"wallThickness")</td><td>@GetNum(p,"area")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div style="font-size:10px;color:var(--text-muted);text-align:right">共 @(_allSaSteelProfiles?.Count ?? 0) 条</div>
                }
            </fieldset>
        </div>
    }
    else
    {
        <div style="flex:1.4;min-width:0">
            <fieldset class="groupbox">
                <legend class="groupbox-title">横梁型材库（@(_allProfiles?.Count ?? 0) 条）</legend>
                <div style="margin-bottom:4px;font-size:11px;color:var(--text-muted)">
                    快速查找型材 → 请在此处输入待查找型材代号或其关键字
                    <span style="float:right;color:var(--primary);font-weight:600;cursor:pointer" @onclick="() => _showUnitModal = true">单位说明</span>
                </div>
                <div class="hb-search" style="margin-bottom:4px">
                    <input class="hb-input" style="width:100%" placeholder="搜索型材代号..." @bind="_profileSearch" @bind:event="oninput" @bind:after="FilterProfiles"/>
                </div>
                @if (_loading)
                {
                    <div style="text-align:center;padding:20px;color:var(--text-muted)"><span class="spinner"></span> 加载中...</div>
                }
                else
                {
                    <div style="max-height:420px;overflow:auto">
                        <table class="hb-table" style="font-size:11px">
                            <thead>
                                <tr>
                                    <th style="min-width:90px">型材代号</th>
                                    <th>Ix惯性矩</th><th>Iy惯性矩</th><th>Wx1抵抗矩</th><th>Wx2抵抗矩</th>
                                    <th>Wy1抵抗矩</th><th>Wy2抵抗矩</th><th>连接面壁厚</th><th>截面积</th>
                                    <th>面积矩Sx</th><th>面积矩Sy</th><th>备</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in _filteredProfiles)
                                {
                                    var pCode = GetStr(p, "code");
                                    var sel = pCode == Input.ProfileCode;
                                    <tr class="@(sel?"selected":"")" style="cursor:pointer" @onclick="() => SelectProfile(p)">
                                        <td style="text-align:left;font-weight:600">@pCode</td>
                                        <td>@GetNum(p,"ix")</td><td>@GetNum(p,"iy")</td>
                                        <td>@GetNum(p,"wx1")</td><td>@GetNum(p,"wx2")</td>
                                        <td>@GetNum(p,"wy1")</td><td>@GetNum(p,"wy2")</td>
                                        <td>@GetNum(p,"wallThickness")</td><td>@GetNum(p,"area")</td>
                                        <td>@GetNum(p,"staticMomentSx")</td><td>@GetNum(p,"staticMomentSy")</td><td></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div style="font-size:11px;color:var(--text-muted);margin-top:4px;text-align:right">
                        共 @(_allProfiles?.Count ?? 0) 条型材 · 显示 @_filteredProfiles.Count 条
                    </div>
                }
            </fieldset>
        </div>
    }

    <!-- ====== 右侧：验算结果 ====== -->
    <div style="flex:0.8;min-width:220px">
        <fieldset class="groupbox" style="background:var(--bg-page)">
            <legend class="groupbox-title">横梁验算结果</legend>
            <div style="font-size:11px;line-height:1.8;font-family:'Consolas','Microsoft YaHei UI',monospace">

                <div style="margin-bottom:4px">
                    <div>双向弯曲应力：<b>@(Input.CombinedStress.ToString("F1")) MPa</b></div>
                    <div>容许应力：<b>@(Input.AllowableStress.ToString("F1")) MPa</b></div>
                    <div class="@(Input.StressPass ? "result-pass" : "result-fail")">
                        @(Input.StressPass ? "满足要求(√)" : "● 不满足要求(✗)")
                    </div>
                </div>

                <div style="margin-bottom:4px">
                    <div>合成挠度：<b>@(Input.CombinedDeflection.ToString("F2")) mm</b></div>
                    <div>挠度限值：<b>@(Input.DeflectionLimit.ToString("F2")) mm</b></div>
                    <div class="@(Input.DeflectionPass ? "result-pass" : "result-fail")">
                        @(Input.DeflectionPass ? "满足要求(√)" : "● 不满足要求(✗)")
                    </div>
                </div>

                <div style="border-top:1px solid var(--border-color);padding-top:6px;margin-top:8px">
                    <div>支反力：<b>@(Input.ReactionForce.ToString("F3")) kN</b></div>
                </div>
            </div>
        </fieldset>

        @if (Input.SteelAlumComposite)
        {
            <fieldset class="groupbox" style="background:var(--bg-page);margin-top:8px">
                <legend class="groupbox-title">钢铝结合验算</legend>
                <div style="font-size:11px;line-height:1.6">
                    <div><b>铝框：</b>@(_selectedSaAluCode != "" ? _selectedSaAluCode : "未选择")</div>
                    <div><b>钢框：</b>@(_selectedSaSteelCode != "" ? _selectedSaSteelCode : "未选择")</div>
                </div>
            </fieldset>
        }
    </div>
</div>

<!-- ====== 横梁力学模型 SVG 图 ====== -->
<fieldset class="groupbox" style="margin-top:10px">
    <legend class="groupbox-title">📐 横梁力学模型图 — @Input.LoadModel@(Input.ShortCantilever ? "（短悬臂）" : "")@(Input.ConcentratedForceModel ? "（集中力）" : "")</legend>
    <div style="display:flex;justify-content:center">
        @if (Input.ShortCantilever)
        {
            @* 短悬臂横梁 *@
            <svg width="100%" viewBox="0 0 500 480" xmlns="http://www.w3.org/2000/svg" style="max-width:600px" font-family="'Segoe UI','Microsoft YaHei UI',sans-serif">
                <defs><marker id="arrT1" markerWidth="6" markerHeight="4" refX="6" refY="2" orient="auto"><polygon points="0,0 6,2 0,4" fill="var(--accent-red,#e74c3c)"/></marker></defs>
                <text x="20" y="16" font-size="10" font-weight="600" fill="var(--text-muted,#888)" letter-spacing="0.6">STRUCTURAL MODEL · 短悬臂横梁</text>
                <rect x="80" y="55" width="280" height="12" rx="2" fill="var(--primary,#007AFF)" opacity="0.15" stroke="var(--primary,#007AFF)" stroke-width="1"/>
                <!-- fixed at wall -->
                <rect x="348" y="35" width="12" height="55" fill="var(--text-muted,#888)" opacity="0.3"/>
                <g stroke="var(--text-muted,#888)" stroke-width="0.6"><line x1="360" y1="38" x2="370" y2="48"/><line x1="360" y1="46" x2="370" y2="56"/><line x1="360" y1="54" x2="370" y2="64"/><line x1="360" y1="62" x2="370" y2="72"/><line x1="360" y1="70" x2="370" y2="80"/></g>
                <!-- UDL (self weight downward) -->
                <g stroke="var(--accent-red,#e74c3c)" stroke-width="0.8" opacity="0.6" marker-end="url(#arrT1)">@for(int x=95;x<=345;x+=25){<line x1="@x" y1="75" x2="@x" y2="95"/>}</g>
                <line x1="95" y1="75" x2="345" y2="75" stroke="var(--accent-red,#e74c3c)" stroke-width="1" opacity="0.6"/>
                <text x="220" y="72" font-size="10" fill="var(--accent-red,#e74c3c)" text-anchor="middle" font-weight="600">q (自重)</text>
                <line x1="80" y1="110" x2="360" y2="110" stroke="var(--text-muted,#888)" stroke-width="0.6"/>
                <text x="220" y="108" font-size="9" fill="var(--text-muted,#888)" text-anchor="middle">L</text>
                <text x="80" y="124" font-size="8" fill="var(--text-muted,#888)" text-anchor="middle">自由端</text>
                <text x="360" y="124" font-size="8" fill="var(--text-muted,#888)" text-anchor="middle">固定端</text>

                <!-- V -->
                <line x1="20" y1="138" x2="480" y2="138" stroke="var(--border-color,#ddd)" stroke-width="0.5"/>
                <text x="20" y="153" font-size="10" font-weight="600" fill="var(--text-muted,#888)" letter-spacing="0.6">SHEAR FORCE · 剪力图 V(x)</text>
                <line x1="80" y1="190" x2="360" y2="190" stroke="var(--text-muted,#888)" stroke-width="0.6"/>
                <polygon points="80,190 360,170 360,190" fill="#FF9500" opacity="0.12"/>
                <line x1="80" y1="190" x2="360" y2="170" stroke="#FF9500" stroke-width="1.5"/>
                <text x="365" y="173" font-size="9" fill="#FF9500" font-weight="600">qL</text>
                <text x="30" y="193" font-size="10" fill="var(--text-muted,#888)" font-weight="600">V</text>

                <!-- M -->
                <line x1="20" y1="215" x2="480" y2="215" stroke="var(--border-color,#ddd)" stroke-width="0.5"/>
                <text x="20" y="230" font-size="10" font-weight="600" fill="var(--text-muted,#888)" letter-spacing="0.6">BENDING MOMENT · 弯矩图 M(x)</text>
                <line x1="80" y1="250" x2="360" y2="250" stroke="var(--text-muted,#888)" stroke-width="0.6"/>
                <path d="M80,250 Q220,252 360,290" fill="#FF3B30" opacity="0.08"/>
                <path d="M80,250 Q220,252 360,290" fill="none" stroke="#FF3B30" stroke-width="1.5"/>
                <circle cx="360" cy="290" r="3" fill="#FF3B30" opacity="0.7"/>
                <text x="370" y="294" font-size="9" fill="#FF3B30" font-weight="600">M = qL²/2</text>
                <text x="30" y="270" font-size="10" fill="var(--text-muted,#888)" font-weight="600">M</text>

                <!-- δ -->
                <line x1="20" y1="310" x2="480" y2="310" stroke="var(--border-color,#ddd)" stroke-width="0.5"/>
                <text x="20" y="325" font-size="10" font-weight="600" fill="var(--text-muted,#888)" letter-spacing="0.6">DEFLECTION · 挠度曲线 δ(x)</text>
                <line x1="80" y1="350" x2="360" y2="350" stroke="var(--text-muted,#888)" stroke-width="0.6" stroke-dasharray="4,3"/>
                <path d="M360,350 C300,350 200,370 80,390" fill="#34C759" opacity="0.08"/>
                <path d="M360,350 C300,350 200,370 80,390" fill="none" stroke="#34C759" stroke-width="1.5"/>
                <circle cx="80" cy="390" r="3" fill="#34C759" opacity="0.7"/>
                <text x="90" y="393" font-size="9" fill="#34C759" font-weight="600">δmax = qL⁴/8EI</text>
                <text x="30" y="375" font-size="10" fill="var(--text-muted,#888)" font-weight="600">δ</text>

                <rect x="60" y="415" width="380" height="45" rx="6" fill="var(--primary,#007AFF)" opacity="0.08" stroke="var(--primary,#007AFF)" stroke-width="0.5"/>
                <text x="75" y="433" font-size="9" fill="var(--text-muted,#888)" font-weight="600">短悬臂公式</text>
                <text x="75" y="449" font-size="10" fill="var(--text-primary,#333)">M = qL²/2　　δ = qL⁴/(8EI)　　V = qL</text>
            </svg>
        }
        else if (Input.ConcentratedForceModel)
        {
            @* 简支梁-集中荷载 *@
            <svg width="100%" viewBox="0 0 500 480" xmlns="http://www.w3.org/2000/svg" style="max-width:600px" font-family="'Segoe UI','Microsoft YaHei UI',sans-serif">
                <defs><marker id="arrT2" markerWidth="6" markerHeight="4" refX="6" refY="2" orient="auto"><polygon points="0,0 6,2 0,4" fill="var(--accent-red,#e74c3c)"/></marker></defs>
                <text x="20" y="16" font-size="10" font-weight="600" fill="var(--text-muted,#888)" letter-spacing="0.6">STRUCTURAL MODEL · 横梁（集中力）</text>
                <rect x="80" y="55" width="340" height="12" rx="2" fill="var(--primary,#007AFF)" opacity="0.15" stroke="var(--primary,#007AFF)" stroke-width="1"/>
                <!-- pin A -->
                <polygon points="80,69 70,87 90,87" fill="none" stroke="var(--text-primary,#333)" stroke-width="1.2"/>
                <line x1="65" y1="89" x2="95" y2="89" stroke="var(--text-primary,#333)" stroke-width="1"/>
