          <TextBlock Classes="hbFrameTitle" Canvas.Left="7" Canvas.Top="314" Text="立柱与主体(钢转接件)"/>
          <TextBox Classes="hb" Canvas.Left="103" Canvas.Top="323" Width="45" Height="18" FontSize="12" Text="180"/>
          <TextBox Classes="hb" Canvas.Left="295" Canvas.Top="323" Width="45" Height="18" FontSize="12" Text="10"/>
          <TextBlock Classes="hb" Canvas.Left="31" Canvas.Top="326" Width="54" Height="13" Text="尺寸参数A" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
          <TextBlock Classes="hb" Canvas.Left="207" Canvas.Top="326" Width="72" Height="13" Text="单元挂件壁厚" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
          <CheckBox Classes="hb" Canvas.Left="16" Canvas.Top="338" Width="110" Height="15" FontSize="12" HorizontalContentAlignment="Left"><TextBlock Classes="hb" Text="单侧转接件" FontSize="12" TextTrimming="CharacterEllipsis"/></CheckBox>
          <TextBlock Classes="hb" Canvas.Left="25" Canvas.Top="338" Width="58" Height="13" Text="角片材质" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
          <TextBlock Classes="hb" Canvas.Left="94" Canvas.Top="338" Width="48" Height="13" Text="角片壁厚" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
