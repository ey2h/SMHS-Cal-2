          <ComboBox Classes="hb" Canvas.Left="85" Canvas.Top="235" Width="129" Height="20"/>
          <TextBox Classes="hb" Canvas.Left="327" Canvas.Top="245" Width="47" Height="18" FontSize="12" Text="50"/>
          <TextBlock Classes="hb" Canvas.Left="259" Canvas.Top="248" Width="132" Height="13" Text="焊缝尺寸B           mm" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
          <Border Classes="hbFrame" Canvas.Left="3" Canvas.Top="250" Width="462" Height="206"/>
          <TextBlock Classes="hbFrameTitle" Canvas.Left="9" Canvas.Top="241" Text="基本力学参数"/>
