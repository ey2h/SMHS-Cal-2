@page "/login"
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject HttpClient Http

<div class="login-page">
    <div class="login-card">
        <div class="login-header">
            <span class="material-symbols-outlined" style="font-size:48px;color:#0078d4">engineering</span>
            <h2>幕墙结构计算系统</h2>
            <p style="color:#888;margin:0">请登录您的账号</p>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="login-error">@_error</div>
        }

        <div class="login-tabs">
            <button class="tab-btn @(_loginMode == "password" ? "active" : "")" @onclick='() => _loginMode = "password"'>账号密码</button>
            <button class="tab-btn @(_loginMode == "token" ? "active" : "")" @onclick='() => _loginMode = "token"'>API Token</button>
        </div>

        @if (_loginMode == "password")
        {
            <div class="login-form">
                <div class="form-group">
                    <label>用户名</label>
                    <input type="text" @bind="_username" @bind:event="oninput"
                           @onkeydown="HandleKeyDown" placeholder="请输入用户名" autofocus />
                </div>
                <div class="form-group">
                    <label>密码</label>
                    <input type="password" @bind="_password" @bind:event="oninput"
                           @onkeydown="HandleKeyDown" placeholder="请输入密码" />
                </div>
                <button class="login-btn" @onclick="DoLogin" disabled="@_loading">
                    @(_loading ? "登录中..." : "登 录")
                </button>
            </div>
        }
        else
        {
            <div class="login-form">
                <div class="form-group">
                    <label>API Token</label>
                    <input type="text" @bind="_apiToken" @bind:event="oninput"
                           @onkeydown="HandleKeyDown" placeholder="请输入 API Token" autofocus />
                </div>
                <button class="login-btn" @onclick="DoTokenLogin" disabled="@_loading">
                    @(_loading ? "登录中..." : "Token 登录")
                </button>
            </div>
        }
    </div>
</div>

<style>
    .login-page {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }
    .login-card {
        background: #fff;
        border-radius: 12px;
        padding: 40px;
        width: 380px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    }
    .login-header {
        text-align: center;
        margin-bottom: 24px;
    }
    .login-header h2 {
        margin: 10px 0 5px;
        font-size: 20px;
        color: #333;
    }
    .login-error {
        background: #fff3f3;
        color: #d32f2f;
        padding: 10px 14px;
        border-radius: 6px;
        margin-bottom: 16px;
        font-size: 13px;
        border: 1px solid #ffcdd2;
    }
    .login-tabs {
        display: flex;
        gap: 0;
        margin-bottom: 20px;
        border-bottom: 2px solid #eee;
    }
    .tab-btn {
        flex: 1;
        padding: 10px;
        border: none;
        background: none;
        font-size: 14px;
        font-weight: 600;
        color: #888;
        cursor: pointer;
        border-bottom: 2px solid transparent;
        margin-bottom: -2px;
        transition: all 0.2s;
    }
    .tab-btn.active {
        color: #0078d4;
        border-bottom-color: #0078d4;
    }
    .login-form .form-group {
        margin-bottom: 18px;
    }
    .login-form label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: #555;
        margin-bottom: 6px;
    }
    .login-form input {
        width: 100%;
        padding: 10px 14px;
        border: 1px solid #ddd;
        border-radius: 8px;
        font-size: 14px;
        transition: border-color 0.2s;
        box-sizing: border-box;
    }
    .login-form input:focus {
        border-color: #0078d4;
        outline: none;
        box-shadow: 0 0 0 3px rgba(0,120,212,0.1);
    }
    .login-btn {
        width: 100%;
        padding: 12px;
        background: #0078d4;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
        margin-top: 8px;
    }
    .login-btn:hover:not(:disabled) {
        background: #106ebe;
    }
    .login-btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }
</style>

@code {
    private string _username = "";
    private string _password = "";
    private string _apiToken = "";
    private string _error = "";
    private bool _loading;
    private string _loginMode = "password";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "smhs-token");
            if (!string.IsNullOrEmpty(token))
            {
                Nav.NavigateTo("/wizard", forceLoad: false);
            }
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            if (_loginMode == "password") await DoLogin();
            else await DoTokenLogin();
        }
    }

    private async Task DoLogin()
    {
        _error = "";
        if (string.IsNullOrWhiteSpace(_username) || string.IsNullOrWhiteSpace(_password))
        {
            _error = "请输入用户名和密码";
            return;
        }

        _loading = true;
        StateHasChanged();

        try
        {
            var response = await JS.InvokeAsync<LoginResult>("smhsAuth.login", _username, _password);
            if (response.Success)
            {
                await JS.InvokeVoidAsync("localStorage.setItem", "smhs-token", response.Token);
                await JS.InvokeVoidAsync("localStorage.setItem", "smhs-user", response.UserJson);
                Nav.NavigateTo("/wizard", forceLoad: true);
            }
            else
            {
                _error = response.Error ?? "登录失败";
            }
        }
        catch (Exception ex)
        {
            _error = "登录失败：" + ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DoTokenLogin()
    {
        _error = "";
        if (string.IsNullOrWhiteSpace(_apiToken))
        {
            _error = "请输入 API Token";
            return;
        }

        _loading = true;
        StateHasChanged();

        try
        {
            var response = await JS.InvokeAsync<LoginResult>("smhsAuth.tokenLogin", _apiToken);
            if (response.Success)
            {
                await JS.InvokeVoidAsync("localStorage.setItem", "smhs-token", response.Token);
                await JS.InvokeVoidAsync("localStorage.setItem", "smhs-user", response.UserJson);
                Nav.NavigateTo("/wizard", forceLoad: true);
            }
            else
            {
                _error = response.Error ?? "登录失败";
            }
        }
        catch (Exception ex)
        {
            _error = "登录失败：" + ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private class LoginResult
    {
        public bool Success { get; set; }
        public string? Token { get; set; }
        public string? UserJson { get; set; }
        public string? Error { get; set; }
    }
}
