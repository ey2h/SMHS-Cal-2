    <!-- 底部状态栏 -->
    <div class="statusbar">
        <span class="status-item">
            <span class="material-symbols-outlined" style="font-size:13px">help</span>
            帮助（有问题点这里）
        </span>
        <span class="statusbar-sep"></span>
        <span class="status-item" style="color:#FFD700">幕墙结构计算系统 V2.0 — 做最专业的幕墙计算软件</span>
        <span class="spacer"></span>
        <span class="status-item">
            <span class="material-symbols-outlined" style="font-size:13px">calendar_today</span>
            @DateTime.Now.ToString("yyyy/M/d")
        </span>
        <span class="statusbar-sep"></span>
        <span class="status-item">
            <span class="api-dot" style="width:6px;height:6px;background:@(_apiOnline ? "#28A745" : "#DC3545")"></span>
            @(_apiOnline ? "服务就绪" : "服务离线")
        </span>
    </div>
</div>

@code {
    private string _currentTheme = "classic";
    private bool _apiOnline;
    private string _displayName = "";

    [Inject] private GlassApiClient Api { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _apiOnline = await Api.CheckHealthAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var saved = await JS.InvokeAsync<string>("localStorage.getItem", "smhs-theme");
                if (!string.IsNullOrEmpty(saved) && saved is "classic" or "apple" or "xkool")
                {
                    _currentTheme = saved;
                }
            }
            catch { }

            // 检查登录状态
            try
            {
                var token = await JS.InvokeAsync<string>("localStorage.getItem", "smhs-token");
                if (string.IsNullOrEmpty(token))
                {
                    // 未登录，如果不在login页面则重定向
                    var uri = "/" + Nav.ToBaseRelativePath(Nav.Uri);
                    if (!uri.StartsWith("/login"))
                    {
                        Nav.NavigateTo("/login", forceLoad: false);
                        return;
                    }
                }
                else
                {
                    // 读取用户信息
                    var userJson = await JS.InvokeAsync<string>("localStorage.getItem", "smhs-user");
                    if (!string.IsNullOrEmpty(userJson))
                    {
                        var user = System.Text.Json.JsonSerializer.Deserialize<UserInfo>(userJson,
                            new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                        _displayName = user?.DisplayName ?? user?.Username ?? "";
                    }

                    // 启动脉冲检测
                    _dotNetRef = DotNetObjectReference.Create(this);
                    await JS.InvokeVoidAsync("smhsAuth.startPulse", _dotNetRef);

                    // 启动脉冲检测
                    _dotNetRef = DotNetObjectReference.Create(this);
                    await JS.InvokeVoidAsync("smhsAuth.startPulse", _dotNetRef);
                }
            }
            catch { }

            StateHasChanged();
        }
    }

    private async Task Logout()
    {
        try { await JS.InvokeVoidAsync("smhsAuth.logout"); } catch { }
        Nav.NavigateTo("/login", forceLoad: true);
    }

    private DotNetObjectReference<MainLayout>? _dotNetRef;

    [JSInvokable]
    public void OnPulseExpired(string message)
    {
        // JS 端已处理跳转，这里可做额外清理
    }

    public void Dispose()
    {
        try { JS.InvokeVoidAsync("smhsAuth.stopPulse"); } catch { }
        _dotNetRef?.Dispose();
    }

    private class UserInfo
    {
        public string? Username { get; set; }
        public string? DisplayName { get; set; }
    }

    private async Task SetTheme(string theme)
    {
        _currentTheme = theme;
        try { await JS.InvokeVoidAsync("localStorage.setItem", "smhs-theme", theme); } catch { }
    }

    private string IsActive(params string[] paths)
    {
        var uri = "/" + Nav.ToBaseRelativePath(Nav.Uri);
        if (uri == "/" && paths.Contains("/project")) return "active";
        return paths.Any(p => uri.StartsWith(p)) ? "active" : "";
    }
}
