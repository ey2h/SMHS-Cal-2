          <ComboBox Classes="hb" Canvas.Left="227" Canvas.Top="286" Width="209" Height="20"/>
          <TextBox Classes="hb" Canvas.Left="320" Canvas.Top="293" Width="57" Height="18" FontSize="12" Text="6"/>
          <TextBlock Classes="hb" Canvas.Left="259" Canvas.Top="296" Width="132" Height="13" Text="焊角高度            mm" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
          <TextBox Classes="hb" Canvas.Left="358" Canvas.Top="307" Width="49" Height="20" FontSize="12" Text="60"/>
          <DataGrid Classes="hb" Canvas.Left="7" Canvas.Top="308" Width="496" Height="145"/>
          <TextBox Classes="hb" Canvas.Left="85" Canvas.Top="308" Width="81" Height="20" FontSize="12" Text="4000"/>
          <Border Classes="hbFrame" Canvas.Left="261" Canvas.Top="330" Width="140" Height="41"/>
