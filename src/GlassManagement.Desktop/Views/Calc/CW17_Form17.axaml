          <TextBlock Classes="hb" Canvas.Left="163" Canvas.Top="389" Width="30" Height="13" Text="N·mm" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
          <TextBlock Classes="hb" Canvas.Left="3" Canvas.Top="392" Width="433" Height="49" Text="对L型焊缝或三边围焊，软件会自动套用公式求得有效抵抗矩，其它焊缝样式，需要用户自己求得焊缝有效截面积以及有效抵抗矩，具体求法和计算截面一样，用SMHS其它计算菜单下截面计算功能，参看L型或三边围焊的示意图做成面域后操作即可。" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
