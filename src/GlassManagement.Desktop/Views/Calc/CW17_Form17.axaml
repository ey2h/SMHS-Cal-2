          <TextBox Classes="hb" Canvas.Left="85" Canvas.Top="259" Width="97" Height="20" FontSize="12" Text="200000"/>
          <TextBlock Classes="hb" Canvas.Left="27" Canvas.Top="266" Width="166" Height="56" Text="说明：轴力、剪力、弯矩只填写数值的绝对值，不能填写正负号。基本荷载请输入已考虑结构重要性系数后的值。" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
