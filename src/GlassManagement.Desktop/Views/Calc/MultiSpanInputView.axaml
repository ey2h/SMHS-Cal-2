<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GlassManagement.Desktop.Views.Calc.MultiSpanInputView"
             FontFamily="SimSun" FontSize="12"
             Width="919" Height="408">
  <!--
    V31「多跨数据输入」面板复刻（复刻自 2026-10-23 V31 实测 PrintWindow 截图）。
    坐标基准：客户区左上角（窗体 936x442，Frame1 位于客户区 9,29，尺寸 919x408）。
    本控件自身画布 919x408 = Frame1 客户区，坐标为 Frame 内相对坐标。
  -->
  <Canvas Width="919" Height="408" Background="#F0F0F0" ClipToBounds="True">

    <!-- 示意图（自绘 PictureBoxDC，519x103，底色实测 #00FFFF） -->
    <Canvas Canvas.Left="8" Canvas.Top="16" Width="519" Height="103" Background="#00FFFF">
      <Path Stroke="#000000" StrokeThickness="1.4" Data="M 26,22 L 500,22" />
      <Path Stroke="#000000" StrokeThickness="1.2" Fill="#00FFFF" Data="M 26,36 L 20,22 L 32,22 Z" />
      <Ellipse Canvas.Left="108" Canvas.Top="16" Width="10" Height="10" Stroke="#000000" StrokeThickness="1.2" Fill="#00FFFF"/>
      <Path Stroke="#000000" StrokeThickness="1.2" Fill="#00FFFF" Data="M 133,36 L 127,22 L 139,22 Z" />
      <Path Stroke="#000000" StrokeThickness="1.2" Fill="#00FFFF" Data="M 330,36 L 324,22 L 336,22 Z" />
      <Ellipse Canvas.Left="352" Canvas.Top="16" Width="10" Height="10" Stroke="#000000" StrokeThickness="1.2" Fill="#00FFFF"/>
      <Path Stroke="#000000" StrokeThickness="1.2" Fill="#00FFFF" Data="M 377,36 L 371,22 L 383,22 Z" />
      <Path Stroke="#000000" StrokeThickness="1.2" Fill="#00FFFF" Data="M 494,36 L 488,22 L 500,22 Z" />

      <TextBlock Canvas.Left="20" Canvas.Top="2" Text="A" FontSize="11"/>
      <TextBlock Canvas.Left="104" Canvas.Top="2" Text="B" FontSize="11"/>
      <TextBlock Canvas.Left="128" Canvas.Top="2" Text="A" FontSize="11"/>
      <TextBlock Canvas.Left="325" Canvas.Top="2" Text="B" FontSize="11"/>
      <TextBlock Canvas.Left="372" Canvas.Top="2" Text="A" FontSize="11"/>
      <TextBlock Canvas.Left="489" Canvas.Top="2" Text="B" FontSize="11"/>

      <TextBlock Canvas.Left="26" Canvas.Top="34" Text="A1" FontSize="12"/>
      <TextBlock Canvas.Left="66" Canvas.Top="34" Text="L1" FontSize="12"/>
      <TextBlock Canvas.Left="139" Canvas.Top="34" Text="A2" FontSize="12"/>
      <TextBlock Canvas.Left="184" Canvas.Top="34" Text="L2" FontSize="12"/>
      <TextBlock Canvas.Left="333" Canvas.Top="34" Text="AN-1" FontSize="12"/>
      <TextBlock Canvas.Left="393" Canvas.Top="34" Text="LN-1" FontSize="12"/>
      <TextBlock Canvas.Left="377" Canvas.Top="48" Text="AN" FontSize="12"/>
      <TextBlock Canvas.Left="446" Canvas.Top="34" Text="LN" FontSize="12"/>

      <TextBlock Canvas.Left="238" Canvas.Top="40" Text="············" FontSize="12" Foreground="#000000"/>

      <TextBlock Canvas.Left="44" Canvas.Top="52" Text="顶部" Foreground="#0000FF" FontSize="12"/>
      <TextBlock Canvas.Left="38" Canvas.Top="68" Text="第1跨" FontSize="12"/>
      <TextBlock Canvas.Left="150" Canvas.Top="68" Text="第2跨" FontSize="12"/>
      <TextBlock Canvas.Left="336" Canvas.Top="68" Text="第n-1跨" FontSize="12"/>
      <TextBlock Canvas.Left="437" Canvas.Top="52" Text="底部" Foreground="#0000FF" FontSize="12"/>
      <TextBlock Canvas.Left="437" Canvas.Top="68" Text="第n跨" FontSize="12"/>

      <Path Stroke="#000000" StrokeThickness="1" Data="M 26,88 L 26,94 M 26,91 L 133,91 M 133,88 L 133,94" />
      <Path Stroke="#000000" StrokeThickness="1" Data="M 139,88 L 139,94 M 139,91 L 246,91 M 246,88 L 246,94" />
      <Path Stroke="#000000" StrokeThickness="1" Data="M 330,88 L 330,94 M 330,91 L 371,91 M 371,88 L 371,94" />
      <Path Stroke="#000000" StrokeThickness="1" Data="M 377,88 L 377,94 M 377,91 L 494,91 M 494,88 L 494,94" />
    </Canvas>

    <!-- 左侧三个输入项（绑定会话：跨窗体沿用） -->
    <TextBlock Classes="hb" Canvas.Left="28" Canvas.Top="150" Width="60" Height="18" Text="总跨数" FontSize="12" TextWrapping="Wrap" LineHeight="15"/>
    <TextBox Classes="hb" Canvas.Left="93" Canvas.Top="150" Width="53" Height="18" FontSize="12"
             Text="{Binding Session.TotalSpans, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

    <TextBlock Classes="hb" Canvas.Left="28" Canvas.Top="192" Width="60" Height="18" Text="跨长A₁" FontSize="12" TextWrapping="Wrap" LineHeight="15"/>
    <TextBox Classes="hb" Canvas.Left="93" Canvas.Top="192" Width="53" Height="18" FontSize="12"
             Text="{Binding Session.SegmentAMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    <TextBlock Classes="hb" Canvas.Left="152" Canvas.Top="192" Width="30" Height="18" Text="mm" FontSize="12"/>

    <TextBlock Classes="hb" Canvas.Left="28" Canvas.Top="267" Width="60" Height="18" Text="跨长L₁" FontSize="12" TextWrapping="Wrap" LineHeight="15"/>
    <TextBox Classes="hb" Canvas.Left="93" Canvas.Top="267" Width="53" Height="18" FontSize="12"
             Text="{Binding Session.SegmentLMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    <TextBlock Classes="hb" Canvas.Left="152" Canvas.Top="267" Width="30" Height="18" Text="mm" FontSize="12"/>

    <Button Classes="hb" Canvas.Left="162" Canvas.Top="317" Width="65" Height="25" FontSize="12" HorizontalContentAlignment="Center"
            Content="确认数据" Command="{Binding ConfirmDataCommand}"/>
    <Button Classes="hb" Canvas.Left="146" Canvas.Top="349" Width="97" Height="25" FontSize="12" HorizontalContentAlignment="Center"
            Content="右表清空" Command="{Binding ClearRightCommand}"/>

    <!-- 中间数据表：自绘三列表格（序号 / 代号 / 长度），1:1 还原 VB6 DataGrid 外观 -->
    <Canvas Canvas.Left="320" Canvas.Top="128" Width="178" Height="265" Background="#FFFFFF">
      <!-- 表头行（客户区 y=157 起，行高 17；分隔线实测 x=350/385/430/484） -->
      <Border Canvas.Left="0" Canvas.Top="0" Width="178" Height="17" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1"/>
      <Border Canvas.Left="21" Canvas.Top="1" Width="35" Height="15" Background="#F0F0F0" BorderBrush="#808080" BorderThickness="1"/>
      <Border Canvas.Left="56" Canvas.Top="1" Width="45" Height="15" Background="#F0F0F0" BorderBrush="#808080" BorderThickness="1"/>
      <Border Canvas.Left="101" Canvas.Top="1" Width="54" Height="15" Background="#F0F0F0" BorderBrush="#808080" BorderThickness="1"/>
      <TextBlock Canvas.Left="21" Canvas.Top="1" Width="35" Height="15" Text="序号" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <TextBlock Canvas.Left="56" Canvas.Top="1" Width="45" Height="15" Text="代号" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <TextBlock Canvas.Left="101" Canvas.Top="1" Width="54" Height="15" Text="长度" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <!-- 行头三角（V31 当前行指示） -->
      <Path Canvas.Left="5" Canvas.Top="23" Fill="#000000" Data="M 0,0 L 8,7 L 0,14 Z"/>

      <!-- 数据行（浅青底 #C0FFFF，行高 16px；V31 实测 16 行可见，10 行数据 + 6 行 0/0 占位） -->
      <ScrollViewer Name="GridScroll" Canvas.Left="21" Canvas.Top="17" Width="135" Height="248"
                    VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Segments}" Width="135">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Height="16" ColumnDefinitions="35,45,54">
              <Border Grid.Column="0" Background="#C0FFFF" BorderBrush="#808080" BorderThickness="0,0,1,1">
                <TextBlock Text="{Binding Index}" FontSize="12" Margin="4,0" VerticalAlignment="Center"/>
              </Border>
              <Border Grid.Column="1" Background="#C0FFFF" BorderBrush="#808080" BorderThickness="0,0,1,1">
                <TextBlock Text="{Binding Code}" FontSize="12" Margin="4,0" VerticalAlignment="Center"/>
              </Border>
              <Border Grid.Column="2" Background="#C0FFFF" BorderBrush="#808080" BorderThickness="0,0,0,1">
                <TextBlock Text="{Binding Length}" FontSize="12" Margin="4,0" VerticalAlignment="Center"/>
              </Border>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </ScrollViewer>

      <!-- 外框与竖向滚动条（VB6 DataGrid 样式：上下三角箭头 + 浅灰滑道） -->
      <Border Canvas.Left="0" Canvas.Top="0" Width="178" Height="265" BorderBrush="#646464" BorderThickness="1" IsHitTestVisible="False"/>
      <Border Canvas.Left="161" Canvas.Top="17" Width="16" Height="248" Background="#F0F0F0" BorderBrush="#808080" BorderThickness="1" IsHitTestVisible="False"/>
      <Path Canvas.Left="165" Canvas.Top="21" Fill="#000000" Data="M 0,7 L 8,0 L 8,7 Z" IsHitTestVisible="False"/>
      <Path Canvas.Left="165" Canvas.Top="253" Fill="#000000" Data="M 0,0 L 8,0 L 8,7 Z" IsHitTestVisible="False"/>
    </Canvas>

    <!-- 右侧结果区（实测底色 #C0FFFF） -->
    <Border Canvas.Left="545" Canvas.Top="12" Width="364" Height="335" Background="#C0FFFF" BorderBrush="#808080" BorderThickness="1"/>
    <TextBlock Canvas.Left="553" Canvas.Top="20" Width="348" Text="点「预演」查看计算结果"
               FontFamily="SimSun" FontSize="12" Foreground="#6B6B6B" TextWrapping="Wrap"
               IsVisible="{Binding !HasResults}"/>
    <ScrollViewer Canvas.Left="546" Canvas.Top="13" Width="362" Height="333"
                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Results}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Text}" FontFamily="SimSun" FontSize="12"
                       Foreground="{Binding Color}" TextDecorations="{Binding Decoration}"
                       Margin="4,0" Height="15" LineHeight="15" TextWrapping="NoWrap"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- 右下按钮组（命令绑定；上一步/下一步/退出由宿主 VM 的向导命令接管） -->
    <Button Classes="hb" Canvas.Left="792" Canvas.Top="354" Width="59" Height="24" FontSize="12" HorizontalContentAlignment="Center"
            Content="预演" Command="{Binding PreviewCommand}"/>
    <Button Classes="hb" Canvas.Left="852" Canvas.Top="354" Width="59" Height="24" FontSize="12" HorizontalContentAlignment="Center"
            Content="上一步" Command="{Binding WizardPrevCommand}"/>
    <Button Classes="hb" Canvas.Left="792" Canvas.Top="378" Width="59" Height="24" FontSize="12" HorizontalContentAlignment="Center"
            Content="退出" Command="{Binding WizardExitCommand}"/>
    <Button Classes="hb" Canvas.Left="851" Canvas.Top="378" Width="59" Height="24" FontSize="12" HorizontalContentAlignment="Center"
            Content="下一步" Command="{Binding WizardNextCommand}"/>
  </Canvas>
</UserControl>
