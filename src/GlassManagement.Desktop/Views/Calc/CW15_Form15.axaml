<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GlassManagement.Desktop.Views.Calc.CW15_Form15"
             FontFamily="SimSun" FontSize="12">
  <!-- VB6 form: 幕墙计算-连接计算 | client 796x513 | 85 nodes (40 labels) | pairs=15 spread=0px dropped=0 declutter:drop=0 move=1 -->
  <DockPanel>
    <Border DockPanel.Dock="Top" Height="19" Background="#E8EEF7" BorderBrush="#A0A0A0" BorderThickness="0,0,0,1">
      <TextBlock Text="幕墙计算-连接计算" FontSize="11" Margin="8,0" VerticalAlignment="Center" Foreground="#1F2937"/>
    </Border>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
    <Canvas Width="796" Height="513" Background="#F0F0F0" ClipToBounds="True">
      <TextBox Classes="hb" Canvas.Left="435" Canvas.Top="14" Width="346" Height="407" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" IsReadOnly="True"/>
      <Button Classes="hb" Canvas.Left="657" Canvas.Top="433" Width="59" Height="24" FontSize="12" HorizontalContentAlignment="Left"><TextBlock Classes="hb" Text="预演" FontSize="12" TextTrimming="CharacterEllipsis"/></Button>
      <Button Classes="hb" Canvas.Left="717" Canvas.Top="433" Width="59" Height="24" FontSize="12" HorizontalContentAlignment="Left"><TextBlock Classes="hb" Text="上一步" FontSize="12" TextTrimming="CharacterEllipsis"/></Button>
      <TextBlock Classes="hb" Canvas.Left="451" Canvas.Top="439" Width="183" Height="33" Text="frame6必须在前才行，否则半栓半焊出错" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
      <Button Classes="hb" Canvas.Left="657" Canvas.Top="457" Width="59" Height="24" FontSize="12" HorizontalContentAlignment="Left"><TextBlock Classes="hb" Text="退出" FontSize="12" TextTrimming="CharacterEllipsis"/></Button>
      <Button Classes="hb" Canvas.Left="717" Canvas.Top="457" Width="59" Height="24" FontSize="12" HorizontalContentAlignment="Left"><TextBlock Classes="hb" Text="下一步" FontSize="12" TextTrimming="CharacterEllipsis"/></Button>
      <!-- 互斥参数面板（源程序按选项切换显示），共 4 套 -->
      <TabControl Canvas.Left="10" Canvas.Top="12" Width="418" Height="471">
        <TabItem Header="连接形式">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <Canvas Width="415" Height="36" Background="#F0F0F0" ClipToBounds="True">
