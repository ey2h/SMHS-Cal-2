@using static GlassManagement.Api.Components.Pages.Wizard

<!-- 标题条 -->
<div class="hb-title-bar">@CurtainWallType 幕墙计算 - 预埋件与其他验算</div>

<div style="display:flex;gap:12px;align-items:flex-start">
    <!-- 左侧参数区 -->
    <div style="flex:5;min-width:0">

        <!-- 受力模式 -->
        <fieldset class="groupbox">
            <legend class="groupbox-title">受力模式</legend>
            <div class="hb-radio-group horizontal">
                @foreach (var mode in new[] { "梁底吊挂", "侧埋", "梁顶埋", "梁底埋" })
                {
                    var m = mode;
                    var disabled = m == "梁底吊挂" && !_isAbsoluteSpan;
                    <label style="@(disabled ? "opacity:0.45;cursor:not-allowed" : "")"
                           title="@(disabled ? "仅在Step3勾选\"绝对单跨\"时可选" : "")">
                        <input type="radio" name="forceMode" value="@m"
                               checked="@(Input.ForceMode == m)"
                               disabled="@disabled"
                               @onchange="() => { Input.ForceMode = m; RunCalculation(); }" />@m
                    </label>
                }
            </div>
            <!-- 偏心距参数 -->
            <div style="display:grid;grid-template-columns:auto 1fr auto 1fr auto 1fr auto 1fr;gap:4px 8px;align-items:center;font-size:12px;margin-top:6px">
                @if (Input.ForceMode == "梁底吊挂" || Input.ForceMode == "侧埋")
                {
                    <span class="param-label">e₀</span>
                    <div style="display:flex;align-items:center;gap:2px">
                        <input class="hb-input" style="width:60px" type="number" @bind="Input.ForceE0" step="5" @bind:after="RunCalculation"/>
                        <span class="param-unit">mm</span>
                    </div>
                    <span></span><span></span><span></span><span></span><span></span><span></span>
                }
                else
                {
                    <span class="param-label">e₁</span>
                    <div style="display:flex;align-items:center;gap:2px">
                        <input class="hb-input" style="width:60px" type="number" @bind="Input.ForceE1" step="5" @bind:after="RunCalculation"/>
                        <span class="param-unit">mm</span>
                    </div>
                    <span class="param-label">e₂</span>
                    <div style="display:flex;align-items:center;gap:2px">
                        <input class="hb-input" style="width:60px" type="number" @bind="Input.ForceE2" step="5" @bind:after="RunCalculation"/>
                        <span class="param-unit">mm</span>
                    </div>
                    <span class="param-label">e₃</span>
                    <div style="display:flex;align-items:center;gap:2px">
                        <input class="hb-input" style="width:60px" type="number" @bind="Input.ForceE3" step="5" @bind:after="RunCalculation"/>
                        <span class="param-unit">mm</span>
                    </div>
                    <span></span><span></span>
                }
            </div>
        </fieldset>

        <!-- 埋件类型 -->
        <fieldset class="groupbox">
            <legend class="groupbox-title">埋件类型</legend>
            <div class="hb-radio-group horizontal" style="margin-bottom:6px">
                @foreach (var t in new[] { "土建预埋", "后补锚栓", "槽型埋件", "对穿螺栓" })
                {
                    var et = t;
                    <label><input type="radio" name="embedType" value="@et"
                                  checked="@(Input.EmbedType == et)"
                                  @onchange="() => { Input.EmbedType = et; RunCalculation(); }" />@et</label>
                }
            </div>

            @if (Input.EmbedType == "土建预埋")
            {
                <!-- 锚筋参数 -->
                <fieldset class="groupbox" style="background:var(--bg-page)">
                    <legend class="groupbox-title" style="font-size:11px">锚筋参数</legend>
                    <div style="display:grid;grid-template-columns:auto 1fr auto 1fr auto 1fr;gap:4px 8px;align-items:center;font-size:12px">
                        <span class="param-label">锚筋材料</span>
                        <select class="hb-input" @bind="Input.AnchorMaterial" @bind:after="RunCalculation">
                            <option>HPB300</option><option>HRB335</option><option>HRB400</option>
                        </select>
                        <span class="param-label">锚筋直径</span>
                        <select class="hb-input" @bind="Input.AnchorDiameter" @bind:after="RunCalculation">
                            <option value="8">8</option><option value="10">10</option><option value="12">12</option>
                            <option value="14">14</option><option value="16">16</option>
                        </select>
                        <span class="param-label">锚筋长度</span>
                        <div style="display:flex;align-items:center;gap:2px">
                            <input class="hb-input" style="width:60px" type="number" @bind="Input.AnchorLength" step="10" @bind:after="RunCalculation"/>
                            <span class="param-unit">mm</span>
                        </div>

                        <span class="param-label">锚筋根数</span>
                        <input class="hb-input" style="width:60px" type="number" @bind="Input.AnchorCount" min="2" @bind:after="RunCalculation"/>
                        <span class="param-label">每面锚筋数</span>
                        <input class="hb-input" style="width:60px" type="number" @bind="Input.AnchorPerSide" min="1" @bind:after="RunCalculation"/>
                        <span class="param-label">混凝土等级</span>
                        <select class="hb-input" @bind="Input.ConcreteGrade" @bind:after="RunCalculation">
                            @foreach (var g in new[] { "C20","C25","C30","C35","C40","C45","C50","C55","C60" })
                            { <option>@g</option> }
                        </select>

                        <span class="param-label">锚筋中心距</span>
                        <div style="display:flex;align-items:center;gap:2px">
                            <input class="hb-input" style="width:60px" type="number" @bind="Input.AnchorCenterDistance" step="5" @bind:after="RunCalculation"/>
                            <span class="param-unit">mm</span>
                        </div>
                        <span></span><span></span><span></span><span></span>
                    </div>
                    <div style="margin-top:6px">
                        <span class="param-label" style="margin-right:8px">锚筋形式：</span>
                        <div class="hb-radio-group horizontal" style="display:inline-flex">
                            <label><input type="radio" name="anchorShape" value="L形弯钩"
                                          checked="@(Input.AnchorShape=="L形弯钩")"
                                          @onchange='() => Input.AnchorShape="L形弯钩"'/>①L形弯钩</label>
                            <label><input type="radio" name="anchorShape" value="三边围焊"
                                          checked="@(Input.AnchorShape=="三边围焊")"
                                          @onchange='() => Input.AnchorShape="三边围焊"'/>②三边围焊</label>
                        </div>
                    </div>
                    <div style="margin-top:4px">
                        <label class="hb-checkbox">
                            <input type="checkbox" @bind="Input.AnchorHasMechanicalAnchor" />
                            锚筋末端有符合规范要求的锚头或机械锚固措施
                        </label>
                    </div>
                </fieldset>

                <!-- 锚板参数 -->
                <fieldset class="groupbox" style="background:var(--bg-page)">
                    <legend class="groupbox-title" style="font-size:11px">锚板参数</legend>
                    <div style="display:grid;grid-template-columns:auto 1fr auto 1fr auto 1fr;gap:4px 8px;align-items:center;font-size:12px">
                        <span class="param-label">板长</span>
                        <div style="display:flex;align-items:center;gap:2px">
                            <input class="hb-input" style="width:60px" type="number" @bind="Input.AnchorPlateLength" step="5" @bind:after="RunCalculation"/>
                            <span class="param-unit">mm</span>
                        </div>
                        <span class="param-label">板宽</span>
                        <div style="display:flex;align-items:center;gap:2px">
                            <input class="hb-input" style="width:60px" type="number" @bind="Input.AnchorPlateWidth" step="5" @bind:after="RunCalculation"/>
                            <span class="param-unit">mm</span>
                        </div>
                        <span class="param-label">板厚</span>
                        <div style="display:flex;align-items:center;gap:2px">
                            <input class="hb-input" style="width:60px" type="number" @bind="Input.AnchorPlateThickness" step="1" @bind:after="RunCalculation"/>
                            <span class="param-unit">mm</span>
                        </div>
                    </div>
                </fieldset>
            }
            else if (Input.EmbedType == "后补锚栓")
            {
                <fieldset class="groupbox" style="background:var(--bg-page)">
                    <legend class="groupbox-title" style="font-size:11px">后补锚栓参数</legend>
                    <div style="display:grid;grid-template-columns:auto 1fr auto 1fr;gap:4px 8px;align-items:center;font-size:12px">
                        <span class="param-label">锚栓型号</span>
                        <select class="hb-input" @bind="Input.PostAnchorSpec" @bind:after="RunCalculation">
                            <option>M8</option><option>M10</option><option>M12</option><option>M16</option><option>M20</option>
                        </select>
                        <span class="param-label">锚栓类型</span>
                        <select class="hb-input" @bind="Input.PostAnchorType" @bind:after="RunCalculation">
                            <option>扩底型锚栓</option><option>扭矩控制膨胀型锚栓</option><option>普通化学锚栓</option>
                            <option>特殊倒锥形化学锚栓(GB50367)</option><option>特殊倒锥形化学锚栓(JGJ145)</option>
                        </select>
                        <span class="param-label">锚栓材质</span>
                        <select class="hb-input" @bind="Input.PostAnchorMaterial" @bind:after="RunCalculation">
                            <option>碳钢4.8</option><option>碳钢5.8</option><option>碳钢8.8</option><option>不锈钢A2-70</option>
                        </select>
                        <span class="param-label">数量</span>
                        <input class="hb-input" style="width:60px" type="number" @bind="Input.PostAnchorCount" min="2" @bind:after="RunCalculation"/>
                        <span class="param-label">有效锚固深度</span>
                        <div style="display:flex;align-items:center;gap:2px">
                            <input class="hb-input" style="width:60px" type="number" @bind="Input.PostAnchorDepth" step="5" @bind:after="RunCalculation"/>
                            <span class="param-unit">mm</span>
                        </div>
                    </div>
                    <div style="margin-top:4px">
                        <span class="param-label">混凝土等级：</span>
                        <select class="hb-input" style="width:80px" @bind="Input.ConcreteGrade" @bind:after="RunCalculation">
                            @foreach (var g in new[] { "C20","C25","C30","C35","C40","C45","C50","C55","C60","C70","C80" })
                            { <option>@g</option> }
                        </select>
                    </div>
                </fieldset>
            }
            else if (Input.EmbedType == "槽型埋件")
            {
                <fieldset class="groupbox" style="background:var(--bg-page)">
                    <legend class="groupbox-title" style="font-size:11px">槽型埋件参数</legend>
                    <div style="display:grid;grid-template-columns:auto 1fr auto 1fr auto 1fr;gap:4px 8px;align-items:center;font-size:12px">
                        <span class="param-label">槽体材质</span>
                        <select class="hb-input" @bind="Input.SlotChannelMaterial" @bind:after="RunCalculation">
                            <option>Q235</option><option>Q355</option>
                        </select>
                        <span class="param-label">槽体长度lch</span>
                        <div style="display:flex;align-items:center;gap:2px">
                            <input class="hb-input" style="width:60px" type="number" @bind="Input.SlotChannelLength" step="10" @bind:after="RunCalculation"/>
                            <span class="param-unit">mm</span>
                        </div>
                        <span class="param-label">槽体宽度bch</span>
                        <div style="display:flex;align-items:center;gap:2px">
                            <input class="hb-input" style="width:60px" type="number" @bind="Input.SlotChannelWidth" step="1" @bind:after="RunCalculation"/>
                            <span class="param-unit">mm</span>
                        </div>

                        <span class="param-label">槽体高度hch</span>
                        <div style="display:flex;align-items:center;gap:2px">
                            <input class="hb-input" style="width:60px" type="number" @bind="Input.SlotChannelHeight" step="1" @bind:after="RunCalculation"/>
                            <span class="param-unit">mm</span>
                        </div>
                        <span class="param-label">锚筋材质</span>
                        <select class="hb-input" @bind="Input.SlotAnchorMaterial" @bind:after="RunCalculation">
                            <option>Q235</option><option>Q355</option>
                        </select>
                        <span class="param-label">锚筋截面积</span>
                        <div style="display:flex;align-items:center;gap:2px">
                            <input class="hb-input" style="width:60px" type="number" @bind="Input.SlotAnchorArea" step="1" @bind:after="RunCalculation"/>
                            <span class="param-unit">mm²</span>
                        </div>

                        <span class="param-label">锚筋数量</span>
                        <select class="hb-input" @bind="Input.SlotAnchorCount" @bind:after="RunCalculation">
                            <option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option>
                        </select>
                        <span class="param-label">锚筋间距s</span>
                        <div style="display:flex;align-items:center;gap:2px">
                            <input class="hb-input" style="width:60px" type="number" @bind="Input.SlotAnchorSpacing" step="5" @bind:after="RunCalculation"/>
                            <span class="param-unit">mm</span>
                        </div>
                        <span class="param-label">有效锚固深度hef</span>
                        <div style="display:flex;align-items:center;gap:2px">
                            <input class="hb-input" style="width:60px" type="number" @bind="Input.SlotHef" step="5" @bind:after="RunCalculation"/>
                            <span class="param-unit">mm</span>
                        </div>

                        <span class="param-label">槽口厚度t</span>
                        <div style="display:flex;align-items:center;gap:2px">
                            <input class="hb-input" style="width:60px" type="number" @bind="Input.SlotThicknessT" step="0.5" @bind:after="RunCalculation"/>
                            <span class="param-unit">mm</span>
                        </div>
                        <span class="param-label">混凝土等级</span>
                        <select class="hb-input" @bind="Input.SlotConcreteGrade" @bind:after="RunCalculation">
                            @foreach (var g in new[] { "C20","C25","C30","C35","C40","C45","C50","C55","C60","C70","C80" })
                            { <option>@g</option> }
                        </select>
                        <span class="param-label">基材类型</span>
                        <select class="hb-input" @bind="Input.SlotBaseType" @bind:after="RunCalculation">
                            <option>开裂混凝土</option><option>非开裂混凝土</option>
                        </select>

                        <span class="param-label">T型螺栓数</span>
                        <select class="hb-input" @bind="Input.SlotTBoltCount" @bind:after="RunCalculation">
                            <option value="2">2</option><option value="3">3</option><option value="4">4</option>
                        </select>
                        <span class="param-label">边距c₁</span>
                        <div style="display:flex;align-items:center;gap:2px">
                            <input class="hb-input" style="width:60px" type="number" @bind="Input.SlotEdgeC1" step="5" @bind:after="RunCalculation"/>
                            <span class="param-unit">mm</span>
                        </div>
                        <span class="param-label">边距c₂</span>
                        <div style="display:flex;align-items:center;gap:2px">
                            <input class="hb-input" style="width:60px" type="number" @bind="Input.SlotEdgeC2" step="5" @bind:after="RunCalculation"/>
                            <span class="param-unit">mm</span>
                        </div>
                    </div>
                </fieldset>
            }
            else
            {
                <!-- 对穿螺栓 -->
                <fieldset class="groupbox" style="background:var(--bg-page)">
                    <legend class="groupbox-title" style="font-size:11px">对穿螺栓参数</legend>
                    <div style="display:grid;grid-template-columns:auto 1fr auto 1fr;gap:4px 8px;align-items:center;font-size:12px">
                        <span class="param-label">螺栓型号</span>
                        <select class="hb-input" @bind="Input.ThroughBoltSpec" @bind:after="RunCalculation">
                            <option>M8</option><option>M10</option><option>M12</option><option>M16</option><option>M20</option>
                        </select>
                        <span class="param-label">螺栓材质</span>
                        <select class="hb-input" @bind="Input.ThroughBoltMaterial" @bind:after="RunCalculation">
                            <option>碳钢4.8</option><option>碳钢8.8</option><option>不锈钢A2-70</option>
                        </select>
                        <span class="param-label">数量</span>
                        <input class="hb-input" style="width:60px" type="number" @bind="Input.ThroughBoltCount" min="2" @bind:after="RunCalculation"/>
                        <span class="param-label">最薄壁厚</span>
                        <div style="display:flex;align-items:center;gap:2px">
                            <input class="hb-input" style="width:60px" type="number" @bind="Input.ThroughBoltMinThickness" step="0.5" @bind:after="RunCalculation"/>
                            <span class="param-unit">mm</span>
                        </div>
                    </div>
                </fieldset>
            }

            <!-- 埋件验算结果 -->
            <fieldset class="groupbox" style="background:var(--bg-page);margin-top:6px">
                <legend class="groupbox-title" style="font-size:11px">埋件验算结果</legend>
                <table class="hb-table" style="font-size:12px;width:100%">
                    <thead><tr><th>验算项目</th><th>利用率</th><th>结果</th></tr></thead>
                    <tbody>
                    @if (Input.EmbedType == "土建预埋")
                    {
                        <tr>
                            <td>锚筋抗拉 N/(n·Nt)</td>
                            <td>@(Input.AnchorTensionRatio.ToString("F2"))</td>
                            <td><span class="@(Input.AnchorTensionPass?"badge-pass":"badge-fail")">@(Input.AnchorTensionPass?"✅通过":"❌不通过")</span></td>
                        </tr>
                        <tr>
                            <td>锚筋抗剪 V/(n·Nv)</td>
                            <td>@(Input.AnchorShearRatio.ToString("F2"))</td>
                            <td><span class="@(Input.AnchorShearPass?"badge-pass":"badge-fail")">@(Input.AnchorShearPass?"✅通过":"❌不通过")</span></td>
                        </tr>
                        <tr>
                            <td>拉剪联合 √(η²+ξ²)</td>
                            <td>@(Input.TensionShearCombinedRatio.ToString("F2"))</td>
                            <td><span class="@(Input.TensionShearCombinedPass?"badge-pass":"badge-fail")">@(Input.TensionShearCombinedPass?"✅通过":"❌不通过")</span></td>
                        </tr>
                        <tr>
                            <td>锚板抗弯 σ/f</td>
                            <td>@(Input.AnchorPlateBendRatio.ToString("F2"))</td>
                            <td><span class="@(Input.AnchorPlateBendPass?"badge-pass":"badge-fail")">@(Input.AnchorPlateBendPass?"✅通过":"❌不通过")</span></td>
                        </tr>
                        <tr>
                            <td>混凝土局部承压 σc/fc</td>
                            <td>@(Input.ConcreteLocalBearingRatio.ToString("F2"))</td>
                            <td><span class="@(Input.ConcreteLocalBearingPass?"badge-pass":"badge-fail")">@(Input.ConcreteLocalBearingPass?"✅通过":"❌不通过")</span></td>
                        </tr>
                    }
                    else if (Input.EmbedType == "后补锚栓")
                    {
                        <tr>
                            <td>钢材破坏 NSd/NRd,s</td>
                            <td>@(Input.PostAnchorSteelRatio.ToString("F2"))</td>
                            <td><span class="@(Input.PostAnchorSteelPass?"badge-pass":"badge-fail")">@(Input.PostAnchorSteelPass?"✅通过":"❌不通过")</span></td>
                        </tr>
                        <tr>
                            <td>混凝土锥体破坏 NSd/NRd,c</td>
                            <td>@(Input.PostAnchorConcreteRatio.ToString("F2"))</td>
                            <td><span class="@(Input.PostAnchorConcretePass?"badge-pass":"badge-fail")">@(Input.PostAnchorConcretePass?"✅通过":"❌不通过")</span></td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" style="text-align:center;color:var(--text-muted)">@(Input.EmbedType)验算（参数输入后自动计算）</td>
                        </tr>
                    }
                    </tbody>
                </table>
                <div class="metric-grid" style="margin-top:6px">
                    <div class="metric-card">
                        <div class="metric-label">最大利用率</div>
                        <div class="metric-value">@(Input.AnchorUtilization.ToString("F0"))%</div>
                    </div>
                    <div class="metric-card">
                        <div class="metric-label">综合判定</div>
                        <span class="@(Input.AnchorPass?"badge-pass":"badge-fail")">@(Input.AnchorPass?"✅通过":"❌不通过")</span>
                    </div>
                </div>
            </fieldset>
        </fieldset>

        <!-- 转接件+焊缝参数 -->
        <fieldset class="groupbox">
            <legend class="groupbox-title">转接件与焊缝参数</legend>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
                <!-- 转接件 -->
                <fieldset class="groupbox" style="background:var(--bg-page)">
                    <legend class="groupbox-title" style="font-size:11px">转接件</legend>
                    <div style="display:grid;grid-template-columns:auto 1fr;gap:4px 8px;align-items:center;font-size:12px">
                        <span class="param-label">型材号</span>
                        <select class="hb-input" @bind="Input.TransferSpec" @bind:after="OnTransferSpecChanged">
                            <option>10#槽钢</option><option>12#槽钢</option><option>14#槽钢</option>
                        </select>
                        <span class="param-label">抗扭矩Wt</span>
                        <div style="display:flex;align-items:center;gap:2px">
                            <input class="hb-input" style="width:80px;background:#f0f0f0" type="number" value="@Input.TransferWt" readonly/>
                            <span class="param-unit">cm³</span>
                        </div>
                        <span class="param-label">惯性矩Ix</span>
                        <div style="display:flex;align-items:center;gap:2px">
                            <input class="hb-input" style="width:80px;background:#f0f0f0" type="number" value="@Input.TransferIx" readonly/>
                            <span class="param-unit">cm⁴</span>
                        </div>
                        <span class="param-label">截面积A</span>
                        <div style="display:flex;align-items:center;gap:2px">
                            <input class="hb-input" style="width:80px;background:#f0f0f0" type="number" value="@Input.TransferArea" readonly/>
                            <span class="param-unit">mm²</span>
                        </div>
                        <span class="param-label">钢材材质</span>
                        <select class="hb-input" @bind="Input.TransferSteelGrade" @bind:after="RunCalculation">
                            <option>Q235</option><option>Q355</option>
                        </select>
                        <span class="param-label">布置方式</span>
                        <div class="hb-radio-group horizontal">
                            <label><input type="radio" name="channelLayout" value="单片" checked="@(Input.ChannelLayout=="单片")"
                                @onchange='() => { Input.ChannelLayout="单片"; RunCalculation(); }'/>单片</label>
                            <label><input type="radio" name="channelLayout" value="双片" checked="@(Input.ChannelLayout=="双片")"
                                @onchange='() => { Input.ChannelLayout="双片"; RunCalculation(); }'/>双片</label>
                        </div>
                    </div>
                </fieldset>

                <!-- 焊缝 -->
                <fieldset class="groupbox" style="background:var(--bg-page)">
                    <legend class="groupbox-title" style="font-size:11px">焊缝参数</legend>
                    <div style="display:grid;grid-template-columns:auto 1fr;gap:4px 8px;align-items:center;font-size:12px">
                        <span class="param-label">焊接形式</span>
                        <div class="hb-radio-group horizontal">
                            <label><input type="radio" name="weldForm" value="L型焊" checked="@(Input.WeldForm=="L型焊")"
                                @onchange='() => { Input.WeldForm="L型焊"; RunCalculation(); }'/>L型焊</label>
                            <label><input type="radio" name="weldForm" value="三边围焊" checked="@(Input.WeldForm=="三边围焊")"
                                @onchange='() => { Input.WeldForm="三边围焊"; RunCalculation(); }'/>三边围焊</label>
                        </div>
                        <span class="param-label">焊缝高度hf</span>
                        <div style="display:flex;align-items:center;gap:2px">
                            <input class="hb-input" style="width:60px" type="number" @bind="Input.WeldHeight" step="1" @bind:after="RunCalculation"/>
                            <span class="param-unit">mm</span>
                        </div>
                        <span class="param-label">水平段焊缝长</span>
                        <div style="display:flex;align-items:center;gap:2px">
                            <input class="hb-input" style="width:60px" type="number" @bind="Input.HorizontalWeldLength" step="5" @bind:after="RunCalculation"/>
                            <span class="param-unit">mm</span>
                        </div>
                        <span class="param-label">垂直段焊缝长</span>
                        <div style="display:flex;align-items:center;gap:2px">
                            <input class="hb-input" style="width:60px" type="number" @bind="Input.VerticalWeldLength" step="5" @bind:after="RunCalculation"/>
                            <span class="param-unit">mm</span>
                        </div>
                    </div>
                </fieldset>
            </div>

            <!-- 焊缝+转接件验算结果 -->
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px">
                <fieldset class="groupbox" style="background:var(--bg-page)">
                    <legend class="groupbox-title" style="font-size:11px">焊缝验算</legend>
                    <div style="font-size:12px;padding:4px">
                        <div>角焊缝抗剪: τf = V / (0.7×hf×Σlw)</div>
                        <div style="margin-top:2px">有效焊缝长 Σlw = @(_calcWeldEffectiveLength.ToString("F0")) mm</div>
                        <div style="margin-top:2px">τf = @(_calcWeldStress.ToString("F1")) MPa ≤ ffw = @(_calcFfw.ToString("F0")) MPa</div>
                        <div style="margin-top:4px">利用率: @(Input.WeldRatio.ToString("F2"))
                            <span class="@(Input.WeldPass?"badge-pass":"badge-fail")" style="margin-left:8px">@(Input.WeldPass?"✅通过":"❌不通过")</span>
                        </div>
                    </div>
                </fieldset>
                <fieldset class="groupbox" style="background:var(--bg-page)">
                    <legend class="groupbox-title" style="font-size:11px">转接件验算</legend>
                    <div style="font-size:12px;padding:4px">
                        <div>弯矩: M = V × e = @(_calcTransferM.ToString("F1")) N·mm</div>
                        <div style="margin-top:2px">应力: σ = M/Wt = @(_calcTransferStress.ToString("F1")) MPa ≤ f = @(_calcTransferF.ToString("F0")) MPa</div>
                        <div style="margin-top:4px">利用率: @(Input.TransferBendRatio.ToString("F2"))
                            <span class="@(Input.TransferPass?"badge-pass":"badge-fail")" style="margin-left:8px">@(Input.TransferPass?"✅通过":"❌不通过")</span>
                        </div>
                    </div>
                </fieldset>
            </div>
        </fieldset>
    </div>

    <!-- 右侧：受力方式计算简图 -->
    <div style="flex:5;min-width:220px">
        <fieldset class="groupbox">
            <legend class="groupbox-title">受力方式简图 - @Input.ForceMode</legend>
            @if (Input.ForceMode == "梁底吊挂")
            {
                <svg viewBox="0 0 240 280" width="220" height="260" style="display:block;margin:auto;background:#fafafa">
                    <!-- 梁截面 -->
                    <rect x="40" y="20" width="160" height="50" fill="#B0BEC5" stroke="#37474F" stroke-width="1.5"/>
                    <text x="120" y="50" text-anchor="middle" font-size="11" fill="#333">混凝土梁</text>
                    <!-- 吊挂板 -->
                    <rect x="95" y="70" width="50" height="8" fill="#607D8B" stroke="#37474F" stroke-width="1"/>
                    <text x="155" y="78" font-size="9" fill="#455A64">锚板</text>
                    <!-- 螺栓 -->
                    <circle cx="108" cy="74" r="3" fill="#D32F2F"/><circle cx="132" cy="74" r="3" fill="#D32F2F"/>
                    <!-- 立柱 -->
                    <rect x="112" y="78" width="16" height="140" fill="#78909C" stroke="#37474F" stroke-width="1"/>
                    <text x="140" y="155" font-size="9" fill="#455A64">立柱</text>
                    <!-- N箭头(向下) -->
                    <line x1="120" y1="218" x2="120" y2="250" stroke="#1976D2" stroke-width="1.5"/>
                    <polygon points="120,250 116,242 124,242" fill="#1976D2"/>
                    <text x="130" y="248" font-size="10" fill="#1976D2" font-weight="bold">N</text>
                    <!-- V箭头(水平) -->
                    <line x1="128" y1="150" x2="170" y2="150" stroke="#E65100" stroke-width="1.5"/>
                    <polygon points="170,150 162,146 162,154" fill="#E65100"/>
                    <text x="172" y="148" font-size="10" fill="#E65100" font-weight="bold">V</text>
                    <!-- e0标注 -->
                    <line x1="120" y1="78" x2="170" y2="78" stroke="#9C27B0" stroke-width="0.8" stroke-dasharray="3"/>
                    <line x1="120" y1="74" x2="120" y2="92" stroke="#9C27B0" stroke-width="0.5"/>
                    <line x1="170" y1="74" x2="170" y2="92" stroke="#9C27B0" stroke-width="0.5"/>
                    <text x="145" y="92" text-anchor="middle" font-size="9" fill="#9C27B0">e₀=@(Input.ForceE0)</text>
                </svg>
