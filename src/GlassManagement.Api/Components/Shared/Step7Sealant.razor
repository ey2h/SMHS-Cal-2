@using static GlassManagement.Api.Components.Pages.Wizard
@using System.Text.Json
@inject GlassApiClient GlassApi

<!-- 标题条 -->
<div class="hb-title-bar">@CurtainWallType 幕墙计算 - 胶类、伸缩及紧固计算</div>

<div style="display:flex;gap:12px;align-items:flex-start">
    <!-- 左侧参数区 -->
    <div style="flex:6;min-width:0">

        <!-- 公用参数 -->
        <fieldset class="groupbox">
            <legend class="groupbox-title">公用参数</legend>
            <div style="display:grid;grid-template-columns:auto 1fr auto 1fr;gap:4px 8px;align-items:center;font-size:12px">
                <span class="param-label">建筑类型</span>
                <select class="hb-input" @bind="Input.BuildingType" @bind:after="RunCalculation">
                    <option>框架</option>
                    <option>板柱-剪力墙</option>
                    <option>框架-剪力墙</option>
                    <option>框架-核心筒</option>
                    <option>框筒</option>
                    <option>筒中筒</option>
                    <option>剪力墙</option>
                    <option>框支层</option>
                    <option>多高层钢结构</option>
                </select>
                <span class="param-label">立柱伸缩缝</span>
                <div style="display:flex;align-items:center;gap:2px">
                    <input class="hb-input" style="width:70px" type="number" @bind="Input.ExpansionJoint" step="1" @bind:after="RunCalculation"/>
                    <span class="param-unit">mm</span>
                </div>
            </div>
            <div style="margin-top:6px;display:flex;gap:16px;flex-wrap:wrap">
                <label class="hb-checkbox" title="勾选后将额外计算副框及承托件的受力">
                    <input type="checkbox" @bind="Input.CalcSubFrame" /> 计算副框和承托件
                </label>
                <label class="hb-checkbox" title="勾选后跳过压板(耳板)验算">
                    <input type="checkbox" @bind="Input.NoClampCalc" @bind:after="RunCalculation" /> 不计算压板(耳板)
                </label>
                <label class="hb-checkbox" title="开放式幕墙不打耐候胶，勾选后禁用耐候胶参数">
                    <input type="checkbox" @bind="Input.OpenStyle" @bind:after="RunCalculation" /> 开放式
                </label>
            </div>
        </fieldset>

        <!-- 全隐框参数 (仅全隐/半隐) -->
        @if (NeedStructuralSealant)
        {
            <fieldset class="groupbox">
                <legend class="groupbox-title">@(IsHalfHidden ? "半隐框" : "全隐框")参数</legend>
                <div style="display:flex;gap:16px;align-items:center;flex-wrap:wrap;font-size:12px">
                    <label class="hb-checkbox" title="勾选后结构胶验算不考虑玻璃自重荷载分量">
                        <input type="checkbox" @bind="Input.NoGravityOnSealant" @bind:after="RunCalculation" /> 不考虑自重对结构胶的影响
                    </label>
                    <span class="param-label">规范选择</span>
                    <select class="hb-input" style="width:160px" @bind="Input.StandardChoice" @bind:after="RunCalculation">
                        <option>按JGJ102规范</option>
                        <option>另按上海规范</option>
                    </select>
                </div>
            </fieldset>
        }

        <!-- 耐候胶胶缝 -->
        <div style="position:relative">
            @if (Input.OpenStyle)
            {
                <div style="position:absolute;top:0;left:0;right:0;bottom:0;z-index:2;background:rgba(200,200,200,0.5);display:flex;align-items:center;justify-content:center;font-size:13px;color:#666;border-radius:6px">
                    开放式不打耐候胶
                </div>
            }
            <fieldset class="groupbox" style="@(Input.OpenStyle ? "opacity:0.5;pointer-events:none" : "")">
                <legend class="groupbox-title">耐候胶胶缝</legend>
                <div style="display:grid;grid-template-columns:auto 1fr auto 1fr;gap:4px 8px;align-items:center;font-size:12px">
                    <span class="param-label">耐候胶位移能力</span>
                    <input class="hb-input" style="width:70px" type="number" @bind="Input.WeatherSealantDisplacement" step="0.05" @bind:after="RunCalculation"/>
                    <span class="param-label">耐候胶缝值</span>
                    <div style="display:flex;align-items:center;gap:2px">
                        <input class="hb-input" style="width:70px" type="number" @bind="Input.WeatherSealantGap" step="1" @bind:after="RunCalculation"/>
                        <span class="param-unit">mm</span>
                    </div>
                </div>
            </fieldset>
        </div>

        <!-- 结构胶参数 (仅全隐/半隐) -->
        @if (!NeedStructuralSealant)
        {
            <fieldset class="groupbox" style="background:var(--bg-page)">
                <legend class="groupbox-title">结构胶参数</legend>
                <div style="padding:12px;text-align:center;color:var(--text-muted);font-size:12px">
                    此幕墙类型（@CurtainWallType）不需要结构胶验算
                </div>
            </fieldset>
        }
        @if (NeedStructuralSealant)
        {
        <fieldset class="groupbox">
            <legend class="groupbox-title">结构胶参数@(IsHalfHidden ? "（隐框方向）" : "")</legend>
            <div style="display:grid;grid-template-columns:auto 1fr auto 1fr auto 1fr;gap:4px 8px;align-items:center;font-size:12px">
                <span class="param-label">铝框胶厚</span>
                <select class="hb-input" @bind="Input.FrameSealantThickness" @bind:after="RunCalculation">
                    @for (int i = 6; i <= 12; i++) { <option value="@i">@i</option> }
                </select>
                <span class="param-label">铝框胶宽</span>
                <select class="hb-input" @bind="Input.FrameSealantWidth" @bind:after="RunCalculation">
                    @for (int i = 6; i <= 29; i++) { <option value="@i">@i</option> }
                </select>
                <span></span><span></span>

                <span class="param-label">中空层胶厚</span>
                <select class="hb-input" @bind="Input.HollowSealantThickness" @bind:after="RunCalculation">
                    @for (int i = 6; i <= 12; i++) { <option value="@i">@i</option> }
                </select>
                <span class="param-label">中空层胶宽</span>
                <select class="hb-input" @bind="Input.HollowSealantWidth" @bind:after="RunCalculation"
                        disabled="@(Input.JointMethod == "铝框对接")"
                        title="@(Input.JointMethod == "铝框对接" ? "铝框对接时中空层胶宽跟随铝框胶宽" : "")">
                    @for (int i = 6; i <= 29; i++) { <option value="@i">@i</option> }
                </select>
                <span></span><span></span>

                <span class="param-label">位移能力</span>
                <select class="hb-input" @bind="Input.SealantDisplacement" @bind:after="RunCalculation">
                    <option value="0.1">0.1</option>
                    <option value="0.12">0.12</option>
                    <option value="0.125">0.125</option>
                    <option value="0.14">0.14</option>
                    <option value="0.15">0.15</option>
                </select>
                <span class="param-label">长期强度</span>
                <select class="hb-input" @bind="Input.LongTermStrength" @bind:after="RunCalculation">
                    <option value="0.01">0.01</option>
                </select>
                <span class="param-label">短期强度</span>
                <select class="hb-input" @bind="Input.ShortTermStrength" @bind:after="RunCalculation">
                    <option value="0.2">0.2</option>
                </select>
            </div>
        </fieldset>

        } @* end NeedStructuralSealant *@

        <!-- 板块间对接方式 (仅玻璃类) -->
        @if (IsGlassType)
        {
        <fieldset class="groupbox">
            <legend class="groupbox-title">板块间对接方式</legend>
            <div class="hb-radio-group horizontal">
                <label title="玻璃面板直接对接，结构胶传力">
                    <input type="radio" name="jointMethod" value="玻璃对接"
                           checked="@(Input.JointMethod == "玻璃对接")"
                           @onchange='() => { Input.JointMethod = "玻璃对接"; RunCalculation(); }' /> 玻璃对接
                </label>
                <label title="通过铝合金型材框对接传力">
                    <input type="radio" name="jointMethod" value="铝框对接"
                           checked="@(Input.JointMethod == "铝框对接")"
                           @onchange='() => { Input.JointMethod = "铝框对接"; RunCalculation(); }' /> 铝框对接
                </label>
            </div>
        </fieldset>

        } @* end IsGlassType 板块间对接方式 *@

        <!-- 中空玻璃形式 (仅玻璃类) -->
        @if (IsGlassType)
        {
        <fieldset class="groupbox">
            <legend class="groupbox-title">中空玻璃形式</legend>
            <div class="hb-radio-group horizontal">
                <label><input type="radio" name="hollowForm" value="等片"
                              checked="@(Input.HollowGlassForm == "等片")"
                              @onchange='() => { Input.HollowGlassForm = "等片"; RunCalculation(); }' /> 等片</label>
                <label><input type="radio" name="hollowForm" value="不等片"
                              checked="@(Input.HollowGlassForm == "不等片")"
                              @onchange='() => { Input.HollowGlassForm = "不等片"; RunCalculation(); }' /> 不等片</label>
            </div>
        </fieldset>

        } @* end IsGlassType 中空玻璃形式 *@

        <!-- 压板参数 (仅需要压板的类型) -->
        @if (NeedClampPlate)
        {
        <div style="position:relative">
            @if (Input.NoClampCalc)
            {
                <div style="position:absolute;top:0;left:0;right:0;bottom:0;z-index:2;background:rgba(200,200,200,0.5);display:flex;align-items:center;justify-content:center;font-size:13px;color:#666;border-radius:6px">
                    已选择不计算压板
                </div>
            }
            <fieldset class="groupbox" style="@(Input.NoClampCalc ? "opacity:0.5;pointer-events:none" : "")">
                <legend class="groupbox-title">压板参数</legend>
                <div style="display:grid;grid-template-columns:auto 1fr auto 1fr auto 1fr;gap:4px 8px;align-items:center;font-size:12px">
                    <span class="param-label">长度</span>
                    <div style="display:flex;align-items:center;gap:2px">
                        <input class="hb-input" style="width:60px" type="number" @bind="Input.ClampLength" step="5" @bind:after="RunCalculation"/>
                        <span class="param-unit">mm</span>
                    </div>
                    <span class="param-label">宽度</span>
                    <div style="display:flex;align-items:center;gap:2px">
                        <input class="hb-input" style="width:60px" type="number" @bind="Input.ClampWidth" step="5" @bind:after="RunCalculation"/>
                        <span class="param-unit">mm</span>
                    </div>
                    <span class="param-label">厚度</span>
                    <div style="display:flex;align-items:center;gap:2px">
                        <input class="hb-input" style="width:60px" type="number" @bind="Input.ClampThickness" step="1" @bind:after="RunCalculation"/>
                        <span class="param-unit">mm</span>
                    </div>
                    <span class="param-label">间距</span>
                    <div style="display:flex;align-items:center;gap:2px">
                        <input class="hb-input" style="width:60px" type="number" @bind="Input.ClampSpacing" step="10" @bind:after="RunCalculation"/>
                        <span class="param-unit">mm</span>
                    </div>
                    <span class="param-label">材质</span>
                    <select class="hb-input" @bind="Input.ClampMaterial" @bind:after="RunCalculation">
                        <option>6063-T5</option><option>6063-T6</option>
                        <option>6063A-T5</option><option>6063A-T6</option>
                        <option>6061-T4</option><option>6061-T6</option>
                        <option>Q235</option><option>304不锈钢</option>
                    </select>
                    <span></span><span></span>
                </div>
            </fieldset>
        </div>

        } @* end NeedClampPlate 压板参数 *@

        <!-- 紧固螺钉表格 (仅需要压板的类型) -->
        @if (NeedClampPlate)
        {
        <div style="position:relative">
            @if (Input.NoClampCalc)
            {
                <div style="position:absolute;top:0;left:0;right:0;bottom:0;z-index:2;background:rgba(200,200,200,0.5);display:flex;align-items:center;justify-content:center;font-size:13px;color:#666;border-radius:6px">
                    已选择不计算压板，螺钉表格禁用
                </div>
            }
            <fieldset class="groupbox" style="@(Input.NoClampCalc ? "opacity:0.5;pointer-events:none" : "")">
                <legend class="groupbox-title">紧固螺钉选择</legend>
                <div style="max-height:200px;overflow:auto">
                    <table class="hb-table" style="font-size:11px;width:100%">
                        <thead>
                            <tr><th></th><th>型号</th><th>公称直径</th><th>有效直径</th><th>材质</th><th>剪应力</th><th>拉应力</th><th>孔径</th></tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < _screwRows.Count; i++)
                            {
                                var idx = i;
                                var row = _screwRows[i];
                                <tr style="cursor:pointer;background:@(Input.SelectedScrewIndex == idx ? "#E3F2FD" : "transparent")"
                                    @onclick="() => { Input.SelectedScrewIndex = idx; RunCalculation(); }">
                                    <td><input type="radio" name="screwSelect" checked="@(Input.SelectedScrewIndex == idx)" @onchange="() => { Input.SelectedScrewIndex = idx; RunCalculation(); }"/></td>
                                    <td>@row.Model</td>
                                    <td>@row.NominalDia</td>
                                    <td>@row.EffectiveDia</td>
                                    <td>@row.Material</td>
                                    <td>@row.ShearStress</td>
                                    <td>@row.TensileStress</td>
                                    <td>@row.HoleDia</td>
                                </tr>
                            }
                            @if (_screwRows.Count == 0)
                            {
                                <tr><td colspan="8" style="text-align:center;color:var(--text-muted)">加载中...</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </fieldset>
        </div>
        } @* end NeedClampPlate 螺钉表格 *@
    </div>

    <!-- 右侧验算结果 -->
    <div style="flex:4;min-width:0">

        <!-- 伸缩缝验算 -->
        <fieldset class="groupbox">
            <legend class="groupbox-title">伸缩缝验算</legend>
            <div style="font-size:12px;padding:4px">
                <div>Δ = α × L × ΔT</div>
                <div style="margin-top:2px">α = 23.6×10⁻⁶ /℃（铝合金线膨胀系数）</div>
                <div style="margin-top:2px">L = @(_columnSpan.ToString("F0")) mm，ΔT = @(_tempDiff.ToString("F0")) ℃</div>
                <div style="margin-top:2px">Δ = @(_expansionCalc.ToString("F2")) mm</div>
                <div style="margin-top:2px">设定伸缩缝 = @(Input.ExpansionJoint.ToString("F0")) mm</div>
                <div style="margin-top:4px">
                    利用率: @(Input.ExpansionJointUtilization.ToString("F1"))%
                    <span class="@(Input.ExpansionJointPass ? "badge-pass" : "badge-fail")" style="margin-left:8px">
                        @(Input.ExpansionJointPass ? "✅通过" : "❌不通过")
                    </span>
                </div>
            </div>
        </fieldset>

        <!-- 结构胶验算 -->
        @if (NeedStructuralSealant)
        {
        <fieldset class="groupbox">
            <legend class="groupbox-title">结构胶验算@(IsHalfHidden ? "（隐框方向）" : "")</legend>

            <!-- 铝框结构胶 -->
            <fieldset class="groupbox" style="background:var(--bg-page)">
                <legend class="groupbox-title" style="font-size:11px">铝框结构胶</legend>
                <div style="font-size:12px;padding:4px">
                    <div>σs = W / (2 × Cs × a)</div>
                    <div style="margin-top:2px">Cs = @(Input.FrameSealantWidth) mm, a = @(_glassShortSide.ToString("F0")) mm</div>
                    <div style="margin-top:2px">σs = @(_frameSealantStress.ToString("F4")) MPa ≤ f = @(Input.ShortTermStrength) MPa</div>
                    <div style="margin-top:4px">
                        利用率: @(Input.FrameSealantUtilization.ToString("F1"))%
                        <span class="@(Input.FrameSealantPass ? "badge-pass" : "badge-fail")" style="margin-left:8px">
                            @(Input.FrameSealantPass ? "✅通过" : "❌不通过")
                        </span>
                    </div>
                </div>
            </fieldset>

            <!-- 中空层结构胶 -->
            <fieldset class="groupbox" style="background:var(--bg-page)">
                <legend class="groupbox-title" style="font-size:11px">中空层结构胶</legend>
                <div style="font-size:12px;padding:4px">
                    <div>σs = W / (2 × Cs × a)</div>
                    <div style="margin-top:2px">Cs = @(Input.HollowSealantWidth) mm, a = @(_glassShortSide.ToString("F0")) mm</div>
                    <div style="margin-top:2px">σs = @(_hollowSealantStress.ToString("F4")) MPa ≤ f = @(Input.ShortTermStrength) MPa</div>
                    <div style="margin-top:4px">
                        利用率: @(Input.HollowSealantUtilization.ToString("F1"))%
                        <span class="@(Input.HollowSealantPass ? "badge-pass" : "badge-fail")" style="margin-left:8px">
                            @(Input.HollowSealantPass ? "✅通过" : "❌不通过")
                        </span>
                    </div>
                </div>
            </fieldset>

            <!-- 耐候胶 -->
            <fieldset class="groupbox" style="background:var(--bg-page)">
                <legend class="groupbox-title" style="font-size:11px">耐候胶验算</legend>
                <div style="font-size:12px;padding:4px">
                    @if (Input.OpenStyle)
                    {
                        <div style="color:var(--text-muted)">开放式，不打耐候胶，跳过验算</div>
                    }
                    else
                    {
                        <div>δ需 = Δ / (2 × e) ≤ 耐候胶缝值</div>
                        <div style="margin-top:2px">Δ = @(_expansionCalc.ToString("F2")) mm, e = @(Input.WeatherSealantDisplacement)</div>
                        <div style="margin-top:4px">
                            利用率: @(Input.WeatherSealantUtilization.ToString("F1"))%
                            <span class="@(Input.WeatherSealantPass ? "badge-pass" : "badge-fail")" style="margin-left:8px">
                                @(Input.WeatherSealantPass ? "✅通过" : "❌不通过")
                            </span>
                        </div>
                    }
                </div>
            </fieldset>
        </fieldset>
        } @* end NeedStructuralSealant 结构胶验算 *@

        @if (!NeedStructuralSealant)
        {
            <!-- 非结构胶类型的耐候胶验算 -->
            <fieldset class="groupbox">
                <legend class="groupbox-title">耐候胶验算</legend>
                <div style="font-size:12px;padding:4px">
                    @if (Input.OpenStyle)
                    {
                        <div style="color:var(--text-muted)">开放式，不打耐候胶，跳过验算</div>
                    }
                    else
                    {
                        <div>δ需 = Δ / (2 × e) ≤ 耐候胶缝值</div>
                        <div style="margin-top:2px">Δ = @(_expansionCalc.ToString("F2")) mm, e = @(Input.WeatherSealantDisplacement)</div>
                        <div style="margin-top:4px">
                            利用率: @(Input.WeatherSealantUtilization.ToString("F1"))%
                            <span class="@(Input.WeatherSealantPass ? "badge-pass" : "badge-fail")" style="margin-left:8px">
                                @(Input.WeatherSealantPass ? "✅通过" : "❌不通过")
                            </span>
                        </div>
                    }
                </div>
            </fieldset>
        }

        <!-- 压板验算 (仅需要压板的类型) -->
        @if (NeedClampPlate)
        {
            <fieldset class="groupbox">
                <legend class="groupbox-title">压板验算</legend>
                @if (Input.NoClampCalc)
                {
                    <div style="font-size:12px;color:var(--text-muted);padding:8px">已选择不计算压板</div>
                }
                else
                {
                    <div style="font-size:12px;padding:4px">
                        <div>简支梁弯曲验算: σ = M / W ≤ f</div>
                        <div style="margin-top:2px">q = W_wind × 间距 / 1000</div>
                        <div style="margin-top:2px">M = q×L²/8, W = b×t²/6</div>
                        <div style="margin-top:2px">σ = @(_clampStress.ToString("F1")) MPa ≤ f = @(_clampAllowable.ToString("F0")) MPa</div>
                        <div style="margin-top:4px">
                            利用率: @(Input.ClampUtilization.ToString("F1"))%
                            <span class="@(Input.ClampPass ? "badge-pass" : "badge-fail")" style="margin-left:8px">
                                @(Input.ClampPass ? "✅通过" : "❌不通过")
                            </span>
                        </div>
                    </div>
                }
            </fieldset>

            <!-- 螺钉验算 -->
            @if (!Input.NoClampCalc)
            {
                <fieldset class="groupbox">
                    <legend class="groupbox-title">螺钉验算</legend>
                    <div style="font-size:12px;padding:4px">
                        <div>利用率: @(Input.ScrewUtilization.ToString("F1"))%
                            <span class="@(Input.ScrewPass ? "badge-pass" : "badge-fail")" style="margin-left:8px">
                                @(Input.ScrewPass ? "✅通过" : "❌不通过")
                            </span>
                        </div>
                    </div>
                </fieldset>
            }
        }

        <!-- 状态栏 -->
        @{
            var checks = GetAllChecks();
            int total = checks.Count;
            int passed = checks.Count(c => c);
        }
        <div class="status-bar" style="margin-top:8px">
            <div class="metric-grid">
                <div class="metric-card" style="border-left:3px solid var(--accent-green)">
                    <div class="metric-label">通过项</div>
                    <div class="metric-value" style="color:var(--accent-green)">@passed / @total</div>
                </div>
                @if (passed < total)
                {
                    <div class="metric-card" style="border-left:3px solid var(--accent-red)">
                        <div class="metric-label">不通过</div>
                        <div class="metric-value" style="color:var(--accent-red)">@(total - passed)</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public Step7Data Input { get; set; } = new();
    [Parameter] public Step2Data? Step2Input { get; set; }
    [Parameter] public Step3Data? Step3Input { get; set; }
    [Parameter] public string CurtainWallType { get; set; } = "全隐框玻璃";

    // 幕墙类型判断
    private bool IsGlassType => CurtainWallType.Contains("玻璃");
    private bool IsFullHidden => CurtainWallType == "全隐框玻璃";
    private bool IsHalfHidden => CurtainWallType == "半隐框玻璃";
    private bool IsExposed => CurtainWallType == "明框玻璃";
    private bool IsMetalPanel => CurtainWallType == "金属板";
    private bool IsStone => CurtainWallType == "天然石材";
    private bool IsArtificial => CurtainWallType == "人造板材";
    private bool NeedStructuralSealant => IsFullHidden || IsHalfHidden;
    private bool NeedClampPlate => IsExposed || IsHalfHidden || IsMetalPanel;

    private record ScrewRow(string Model, string NominalDia, string EffectiveDia, string Material, string ShearStress, string TensileStress, string HoleDia);
    private List<ScrewRow> _screwRows = new();

    // 计算中间量
    private double _columnSpan;
    private double _tempDiff;
    private double _expansionCalc;
    private double _glassShortSide;
    private double _windLoad;
    private double _frameSealantStress;
    private double _hollowSealantStress;
    private double _clampStress;
    private double _clampAllowable;

    protected override async Task OnInitializedAsync()
    {
        await LoadScrews();
        RunCalculation();
    }

    protected override void OnParametersSet()
    {
        RunCalculation();
    }

    private async Task LoadScrews()
    {
        try
        {
            var allBolts = await GlassApi.GetBoltsAsync();
            // 取螺栓5范围 idx 192-239，fallback取前48条
            if (allBolts.Count > 239)
            {
                var subset = allBolts.GetRange(192, 48);
                _screwRows = ParseBolts(subset);
            }
            else if (allBolts.Count >= 48)
            {
                _screwRows = ParseBolts(allBolts.GetRange(0, 48));
            }
            else
            {
                _screwRows = ParseBolts(allBolts);
            }
        }
        catch
        {
            _screwRows = new();
        }
        StateHasChanged();
    }

    private List<ScrewRow> ParseBolts(List<JsonElement> bolts)
    {
        var list = new List<ScrewRow>();
        foreach (var b in bolts)
        {
            string Get(string name) { return b.TryGetProperty(name, out var v) ? v.ToString() : "—"; }
            // Try common column names
            list.Add(new ScrewRow(
                Get("model"), Get("nominalDiameter"), Get("effectiveDiameter"),
                Get("material"), Get("shearStress"), Get("tensileStress"), Get("holeDiameter")
            ));
        }
        return list;
    }

    private List<bool> GetAllChecks()
    {
        var list = new List<bool> { Input.ExpansionJointPass, Input.FrameSealantPass, Input.HollowSealantPass };
        if (!Input.OpenStyle) list.Add(Input.WeatherSealantPass);
        if (!Input.NoClampCalc) { list.Add(Input.ClampPass); list.Add(Input.ScrewPass); }
        return list;
    }

    private double GetClampAllowable(string mat) => mat switch
    {
        "6063-T5" => 85, "6063-T6" => 150, "6063A-T5" => 85, "6063A-T6" => 150,
        "6061-T4" => 100, "6061-T6" => 205, "Q235" => 215, "304不锈钢" => 137,
        _ => 85
    };

    private void RunCalculation()
    {
        // 从上游获取参数
        _columnSpan = Step3Input?.Span ?? 3000;
        _tempDiff = 80; // 极限温差默认
        _glassShortSide = Step2Input?.GlassShortSide ?? 1200;
        _windLoad = Step3Input?.WindLoadStd ?? 1.285; // kPa

        // ===== 伸缩缝验算 =====
        double alpha = 23.6e-6; // 铝合金线膨胀系数
        _expansionCalc = alpha * _columnSpan * _tempDiff;
        double halfExpansion = _expansionCalc / 2.0;
        if (Input.ExpansionJoint > 0)
        {
            Input.ExpansionJointUtilization = halfExpansion / (Input.ExpansionJoint / 2.0) * 100;
            Input.ExpansionJointPass = halfExpansion <= Input.ExpansionJoint / 2.0;
        }
        else
        {
            Input.ExpansionJointUtilization = 999;
            Input.ExpansionJointPass = false;
        }

        // ===== 结构胶验算 (JGJ102-2003 5.6.3) =====
        // 铝框对接时中空层胶宽取铝框胶宽（原程序联动规则5）
        int effectiveHollowWidth = Input.JointMethod == "铝框对接" ? Input.FrameSealantWidth : Input.HollowSealantWidth;

        // 风荷载分量: σ₁ = wk(kPa) × a/2(mm) / (2 × Cs(mm))
        // 单位: kPa × mm / mm = kPa = 0.001 MPa → 需要 × 0.001 转MPa
        // wk(kPa) * 0.001 = N/mm², 所以 σ₁ = wk * 0.001 * (a/2) / (2 * Cs) MPa
        double a_half = _glassShortSide / 2.0; // 半短边 mm
        double sigma1_frame = _windLoad * 0.001 * a_half / (2.0 * Input.FrameSealantWidth); // MPa
        double sigma1_hollow = _windLoad * 0.001 * a_half / (2.0 * effectiveHollowWidth); // MPa

        // 自重分量(仅全隐框且未勾选不考虑自重): σ₂ = Gk(N) / (2 × b(mm) × Cs(mm))
        double sigma2_frame = 0;
        double sigma2_hollow = 0;
        if (!Input.NoGravityOnSealant)
        {
            double glassThickM = (Step2Input?.OuterThickness ?? 6.0) / 1000.0;
            double glassLongSide = Step2Input?.GlassLongSide ?? 1500.0;
            double Gk = 25.6 * glassThickM * (_glassShortSide / 1000.0) * (glassLongSide / 1000.0); // kN
            double GkN = Gk * 1000.0; // N
            sigma2_frame = GkN / (2.0 * glassLongSide * Input.FrameSealantWidth); // MPa
            sigma2_hollow = GkN / (2.0 * glassLongSide * effectiveHollowWidth); // MPa
        }

        // 铝框结构胶: σ = √(σ₁² + σ₂²)
        _frameSealantStress = Math.Sqrt(sigma1_frame * sigma1_frame + sigma2_frame * sigma2_frame);
        if (Input.ShortTermStrength > 0)
        {
            Input.FrameSealantUtilization = _frameSealantStress / Input.ShortTermStrength * 100;
            Input.FrameSealantPass = _frameSealantStress <= Input.ShortTermStrength;
        }

        // 中空层结构胶
        _hollowSealantStress = Math.Sqrt(sigma1_hollow * sigma1_hollow + sigma2_hollow * sigma2_hollow);
        if (Input.ShortTermStrength > 0)
        {
            Input.HollowSealantUtilization = _hollowSealantStress / Input.ShortTermStrength * 100;
            Input.HollowSealantPass = _hollowSealantStress <= Input.ShortTermStrength;
        }

        // 耐候胶验算 — 含层间位移角影响
        if (Input.OpenStyle)
        {
            Input.WeatherSealantUtilization = 0;
            Input.WeatherSealantPass = true;
        }
        else
        {
            // 层间位移角限值(建筑类型)
            double driftAngleLimit = Input.BuildingType switch
            {
                "框架" => 1.0 / 550.0,
                "板柱-剪力墙" => 1.0 / 800.0,
                "框架-剪力墙" or "框架-核心筒" => 1.0 / 800.0,
                "框筒" or "筒中筒" => 1.0 / 800.0,
                "剪力墙" => 1.0 / 1000.0,
                "框支层" => 1.0 / 1000.0,
                "多高层钢结构" => 1.0 / 300.0,
                _ => 1.0 / 550.0
            };
            // 层间位移量 δd = 层高 × 位移角限值
            double storyHeight = _columnSpan; // mm (近似取立柱跨度)
            double driftDisp = storyHeight * driftAngleLimit; // mm
            // 温度变形
            double thermalNeeded = Input.WeatherSealantDisplacement > 0 ? _expansionCalc / (2.0 * Input.WeatherSealantDisplacement) : 9999;
            // 层间位移所需胶缝
            double driftNeeded = Input.WeatherSealantDisplacement > 0 ? driftDisp / (2.0 * Input.WeatherSealantDisplacement) : 9999;
            // 取较大值
            double needed = Math.Max(thermalNeeded, driftNeeded);
            if (Input.WeatherSealantGap > 0)
            {
                Input.WeatherSealantUtilization = needed / Input.WeatherSealantGap * 100;
                Input.WeatherSealantPass = needed <= Input.WeatherSealantGap;
            }
            else
            {
                Input.WeatherSealantUtilization = 999;
                Input.WeatherSealantPass = false;
            }
        }

        // ===== 压板验算 =====
        _clampAllowable = GetClampAllowable(Input.ClampMaterial);
        if (!Input.NoClampCalc)
        {
            double q = _windLoad * Input.ClampSpacing / 1000.0; // N/mm
            double L = Input.ClampLength; // mm
            double M = q * L * L / 8.0; // N·mm
            double W_sect = Input.ClampWidth * Input.ClampThickness * Input.ClampThickness / 6.0; // mm³
            _clampStress = W_sect > 0 ? M / W_sect : 9999;
            Input.ClampUtilization = _clampAllowable > 0 ? _clampStress / _clampAllowable * 100 : 999;
            Input.ClampPass = _clampStress <= _clampAllowable;
        }
        else
        {
            _clampStress = 0;
            Input.ClampUtilization = 0;
            Input.ClampPass = true;
        }

        // ===== 螺钉验算 =====
        if (!Input.NoClampCalc && Input.SelectedScrewIndex >= 0 && Input.SelectedScrewIndex < _screwRows.Count)
        {
            var selScrew = _screwRows[Input.SelectedScrewIndex];
            // 从选中行获取螺栓参数
            double dScrew = 0;
            double.TryParse(selScrew.NominalDia, out dScrew);
            double ftbScrew = 0;
            double.TryParse(selScrew.TensileStress, out ftbScrew);
            double fvbScrew = 0;
            double.TryParse(selScrew.ShearStress, out fvbScrew);

            if (dScrew > 0 && ftbScrew > 0)
            {
                double AsScrew = Math.PI / 4.0 * dScrew * dScrew; // mm²
                double NtScrew = ftbScrew * AsScrew; // N 抗拉
                double NvScrew = fvbScrew > 0 ? fvbScrew * AsScrew : 0.4 * ftbScrew * AsScrew; // N 抗剪
                // 每颗螺钉承担的荷载: q_spacing × spacing
                double qScrew = _windLoad * Input.ClampSpacing / 1000.0; // N/mm
                double F_screw = qScrew * Input.ClampLength / 2.0; // N (简支梁支反力)
                double screwRatio = Math.Max(
                    NtScrew > 0 ? F_screw / NtScrew : 9999,
                    NvScrew > 0 ? F_screw / NvScrew : 9999
                );
                Input.ScrewUtilization = screwRatio * 100;
                Input.ScrewPass = screwRatio <= 1.0;
            }
            else
            {
                Input.ScrewUtilization = Input.ClampUtilization * 0.5;
                Input.ScrewPass = Input.ScrewUtilization <= 100;
            }
        }
        else if (!Input.NoClampCalc)
        {
            Input.ScrewUtilization = Input.ClampUtilization * 0.5;
            Input.ScrewPass = Input.ScrewUtilization <= 100;
        }
        else
        {
            Input.ScrewUtilization = 0;
            Input.ScrewPass = true;
        }
    }
}
