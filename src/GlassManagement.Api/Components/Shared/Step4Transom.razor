@code {
    [Parameter] public Step4Data Input { get; set; } = new();
    [Parameter] public string CurtainWallType { get; set; } = "全隐框玻璃";
    [Parameter] public Step2Data? Step2Input { get; set; }

    private List<JsonElement>? _allProfiles;
    private List<JsonElement> _filteredProfiles = new();
    private string _profileSearch = "";
    private bool _loading = true;
    private bool _showUnitModal;

    // 钢铝结合
    private List<JsonElement>? _allSaAluProfiles;
    private List<JsonElement> _filteredSaAluProfiles = new();
    private string _saAluSearch = "";
    private string _selectedSaAluCode = "";
    private List<JsonElement>? _allSaSteelProfiles;
    private List<JsonElement> _filteredSaSteelProfiles = new();
    private string _saSteelSearch = "";
    private string _selectedSaSteelCode = "";
    private bool _saLoading;

    private bool IsAluminum => Input.Material == "铝合金";
    private bool IsSteel => Input.Material == "钢材";

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        _allProfiles = await GlassApi.GetProfileBeamsAsync();
        _loading = false;
        FilterProfiles();
    }

    private void FilterProfiles()
    {
        if (_allProfiles == null) { _filteredProfiles = new(); return; }
        if (string.IsNullOrWhiteSpace(_profileSearch))
            _filteredProfiles = _allProfiles;
        else
            _filteredProfiles = _allProfiles
                .Where(p => GetStr(p,"code").Contains(_profileSearch,StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private void SelectProfile(JsonElement p)
    {
        Input.ProfileCode = GetStr(p, "code");
        Input.Ix = GetDbl(p, "ix");
        Input.Iy = GetDbl(p, "iy");
        Input.Wx1 = GetDbl(p, "wx1");
        Input.Wx2 = GetDbl(p, "wx2");
        Input.Wy1 = GetDbl(p, "wy1");
        Input.Wy2 = GetDbl(p, "wy2");
        Input.Wxx = GetDbl(p, "wx1");
        Input.Wyy = GetDbl(p, "wy1");
        Input.WallThickness = GetDbl(p, "wallThickness");
        Input.Area = GetDbl(p, "area");
        Input.StaticMomentSx = GetDbl(p, "staticMomentSx");
        Input.StaticMomentSy = GetDbl(p, "staticMomentSy");
        Recalc();
    }

    private void SelectAluGrade(string g)
    {
        Input.AluminumGrade = g;
        Input.Material = "铝合金";
        Input.ColdFormedSteel = false;
        Recalc();
    }

    private void SelectSteelGrade(string g)
    {
        Input.SteelGrade = g;
        Input.Material = "钢材";
        Input.IsThermalBreak = false;
        Recalc();
    }

    private void SelectOtherMaterial()
    {
        Input.Material = "其它";
        Input.IsThermalBreak = false;
        Input.ColdFormedSteel = false;
        Recalc();
    }

    private async Task OnSteelAlumChanged()
    {
        if (Input.SteelAlumComposite && _allSaAluProfiles == null)
        {
            _saLoading = true;
            _allSaAluProfiles = await GlassApi.GetSteelAlumAluBeamsAsync();
            _allSaSteelProfiles = await GlassApi.GetSteelAlumSteelBeamsAsync();
            _saLoading = false;
            FilterSaAluProfiles();
            FilterSaSteelProfiles();
        }
        Recalc();
    }

    private void FilterSaAluProfiles()
    {
        if (_allSaAluProfiles == null) { _filteredSaAluProfiles = new(); return; }
        _filteredSaAluProfiles = string.IsNullOrWhiteSpace(_saAluSearch)
            ? _allSaAluProfiles
            : _allSaAluProfiles.Where(p => GetStr(p,"code").Contains(_saAluSearch, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private void FilterSaSteelProfiles()
    {
        if (_allSaSteelProfiles == null) { _filteredSaSteelProfiles = new(); return; }
        _filteredSaSteelProfiles = string.IsNullOrWhiteSpace(_saSteelSearch)
            ? _allSaSteelProfiles
            : _allSaSteelProfiles.Where(p => GetStr(p,"code").Contains(_saSteelSearch, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private static string GetStr(JsonElement e, string prop) => e.TryGetProperty(prop, out var v) ? v.GetString() ?? "" : "";
    private static double GetDbl(JsonElement e, string prop) => e.TryGetProperty(prop, out var v) ? v.GetDouble() : 0;
    private static string GetNum(JsonElement e, string prop) => e.TryGetProperty(prop, out var v) ? v.ToString() : "—";

    /// <summary>
    /// 横梁验算 — JGJ102-2003 §5.4
    /// 双向弯曲: σ = Mx/Wx + My/Wy ≤ [σ]
    /// 合成挠度: δ = √(δx² + δy²) ≤ L/180
    /// </summary>
    private void Recalc()
    {
        if (Input.Wxx <= 0 || Input.Wyy <= 0) return;
        double L = Input.Span; // mm
        double E;
        if (Input.Material == "铝合金")
        {
            E = 70000; // MPa
            Input.AllowableStress = Input.AluminumGrade switch
            {
                "6063-T5" => 85, "6063-T6" => 100, "6061-T4" => 55, "6061-T6" => 135,
                "6063A-T5" => 85, "6063A-T6" => 100, _ => 85
            };
            Input.AllowableShear = Input.AluminumGrade switch
            {
                "6063-T5" => 50, "6063-T6" => 60, "6061-T4" => 32, "6061-T6" => 80,
                "6063A-T5" => 50, "6063A-T6" => 60, _ => 50
            };
        }
        else if (Input.Material == "钢材")
        {
            E = 206000;
            Input.AllowableStress = Input.SteelGrade == "Q355" ? 310 : 215;
            Input.AllowableShear = Input.SteelGrade == "Q355" ? 180 : 125;
        }
        else
        {
            E = Input.ElasticModulus > 0 ? Input.ElasticModulus : 70000;
        }

        // ===== 荷载计算 =====
        // 水平向(x): 风荷载 — 从Step2玻璃短边或上/下分格高取从属高度
        // qx = Wk(kPa) × H_tributary(mm) / 1000 → N/mm
        double wk = Step2Input != null ? 1.285 : 1.0; // 默认风荷载 kPa，实际应从Step1传入
        double H_tributary = Step2Input?.GlassShortSide ?? 1500; // 从属高度 mm(取玻璃短边近似)
        double qx = wk * H_tributary / 1e6; // kPa × mm = Pa·mm = 1e-3 N/mm² × mm = 1e-3 N/mm → ×1000 → N/mm
        qx = wk * H_tributary / 1000.0; // N/mm (wk in kPa=N/m²×1e-3/mm × mm)
        // 实际: wk(kPa) = wk(N/m²)/1000 → wk(N/mm²) = wk(kPa)/1000
        // qx = wk(N/mm²) × H(mm) = wk(kPa)/1000 × H(mm) → N/mm
        qx = wk / 1000.0 * H_tributary; // N/mm

        // 竖向(y): 玻璃自重 — 均布荷载
        // 玻璃单位面积重 ≈ 25.6 kN/m³ × 厚度(m)
        double glassThick = (Step2Input?.OuterThickness ?? 6) + (Step2Input?.InnerThickness ?? 6); // mm (双片)
        double glassUnitWeight = 25.6 * glassThick / 1000.0; // kN/m² (25.6kN/m³ × t(m))
        // 从属宽度取玻璃长边的一半(横梁上下各分担一半)
        double glassLongSide = Step2Input?.GlassLongSide ?? 2400;
        double qy_total = glassUnitWeight * (glassLongSide / 2.0) / 1000.0; // kN/m → 转为 N/mm
        double qy = qy_total; // N/mm (glassUnitWeight(kN/m²) × (mm/2)/1000 = kN/m²×m/2 = kN/m → kN/m / 1000mm/m × 1000N/kN = N/mm)
        qy = glassUnitWeight * (glassLongSide / 2.0) / 1e6 * 1000; // N/mm
        // 简化: qy(N/mm) = glassUnitWeight(kN/m²) × tributaryWidth(m) × 1000(N/kN) / 1000(mm/m)
        qy = glassUnitWeight * (glassLongSide / 2.0 / 1000.0); // kN/m
        qy = qy * 1000.0 / 1000.0; // N/mm (kN/m → N/mm: ×1000/1000=×1)
        // kN/m = N/mm，所以 qy(N/mm) = glassUnitWeight(kN/m²) × (glassLongSide/2)(mm) / 1000(mm→m)
        qy = glassUnitWeight * (glassLongSide / 2.0) / 1000.0; // N/mm

        // ===== 弯矩计算 =====
        // JGJ102-2003 §5.4: 横梁水平方向(风荷载)
        // 三角形分布: Mmax = qx·L²/12 (简支梁三角形荷载)
        // 均布: Mmax = qx·L²/8
        double Mx = Input.LoadModel == "三角形分布"
            ? qx * L * L / 12.0   // N·mm
            : qx * L * L / 8.0;   // N·mm

        // 竖向(自重): 均布荷载 My = qy·L²/8
        // 若玻璃自重为集中力: My = F·L/4 (中点集中力)
        double My;
        if (Input.GlassWeightConcentrated)
        {
            double F_gravity = qy * L; // 总自重 N (近似)
            double a = Input.ForcePointDistance; // 受力点到支座距离 mm
            My = F_gravity * a * (L - a) / L; // 偏心集中力弯矩
        }
        else
        {
            My = qy * L * L / 8.0; // N·mm
        }

        // ===== 双向弯曲应力验算 — JGJ102-2003 §5.4.2 =====
        // σ = Mx/Wx + My/Wy ≤ [σ]
        double WxMm3 = Input.Wxx * 1e3; // cm³ → mm³
        double WyMm3 = Input.Wyy * 1e3;
        Input.CombinedStress = Math.Round(Mx / WxMm3 + My / WyMm3, 1); // MPa
        Input.StressPass = Input.CombinedStress <= Input.AllowableStress;

        // ===== 合成挠度验算 — JGJ102-2003 §5.4.3 =====
        // δ = √(δx² + δy²) ≤ L/180
        double IxMm4 = Input.Ix * 1e4; // cm⁴ → mm⁴
        double IyMm4 = Input.Iy * 1e4;
        // 三角形分布挠度: δ = qx·L⁴/(120·EI)  均布: δ = 5·qx·L⁴/(384·EI)
        double dfx;
        if (Input.LoadModel == "三角形分布")
            dfx = IxMm4 > 0 ? qx * Math.Pow(L, 4) / (120.0 * E * IxMm4) : 0;
        else
            dfx = IxMm4 > 0 ? 5.0 * qx * Math.Pow(L, 4) / (384.0 * E * IxMm4) : 0;
        double dfy = IyMm4 > 0 ? 5.0 * qy * Math.Pow(L, 4) / (384.0 * E * IyMm4) : 0;
        Input.CombinedDeflection = Math.Round(Math.Sqrt(dfx * dfx + dfy * dfy), 2);
        Input.DeflectionLimit = Math.Round(L / 180.0, 2);
        Input.DeflectionPass = Input.CombinedDeflection <= Input.DeflectionLimit;

        // ===== 支反力 =====
        double Vx = Input.LoadModel == "三角形分布" ? qx * L / 3.0 : qx * L / 2.0;
        double Vy = qy * L / 2.0;
        Input.ReactionForce = Math.Round(Math.Sqrt(Vx * Vx + Vy * Vy) / 1000.0, 3); // kN
    }
}
