@code {
    [Parameter] public Step3Data Input { get; set; } = new();
    [Parameter] public string CurtainWallType { get; set; } = "全隐框玻璃";
    [Parameter] public Step2Data? Step2Input { get; set; }

    private List<JsonElement>? _allProfiles;
    private List<JsonElement> _filteredProfiles = new();
    private string _profileSearch = "";
    private bool _loading = true;
    private bool _showUnitModal;
    private static readonly int[] _glassThicknesses = { 3, 4, 5, 6, 8, 10, 12, 15, 19 };

    // 钢铝结合
    private List<JsonElement>? _allSaAluProfiles;
    private List<JsonElement> _filteredSaAluProfiles = new();
    private string _saAluSearch = "";
    private string _selectedSaAluCode = "";
    private List<JsonElement>? _allSaSteelProfiles;
    private List<JsonElement> _filteredSaSteelProfiles = new();
    private string _saSteelSearch = "";
    private string _selectedSaSteelCode = "";
    private bool _saLoading;

    // 材质分类判断
    private bool IsAluminum => Input.Material == "铝合金";
    private bool IsSteel => Input.Material == "钢材";

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        _allProfiles = await GlassApi.GetProfileColumnsAsync();
        _loading = false;
        FilterProfiles();
        Recalc();
    }

    private void FilterProfiles()
    {
        if (_allProfiles == null) { _filteredProfiles = new(); return; }
        if (string.IsNullOrWhiteSpace(_profileSearch))
            _filteredProfiles = _allProfiles;
        else
            _filteredProfiles = _allProfiles
                .Where(p => GetStr(p,"code").Contains(_profileSearch, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private void SelectProfile(JsonElement p)
    {
        Input.ProfileCode = GetStr(p, "code");
        Input.Ix = GetDbl(p, "ix");
        Input.Iy = GetDbl(p, "iy");
        Input.Wx1 = GetDbl(p, "wx1");
        Input.Wx2 = GetDbl(p, "wx2");
        Input.WallThickness = GetDbl(p, "wallThickness");
        Input.Area = GetDbl(p, "area");
        Input.Sx = GetDbl(p, "staticMoment");
        Input.Tw = GetDbl(p, "shearWebWidth");
        if (Input.Tw <= 0) Input.Tw = Input.WallThickness * 2;
        Recalc();
    }

    private void SelectAluGrade(string g)
    {
        Input.AluminumGrade = g;
        Input.Material = "铝合金";
        Input.IsThermalBreak = false;
        Input.ColdFormedSteel = false;
        Recalc();
    }

    private void SelectSteelGrade(string g)
    {
        Input.SteelGrade = g;
        Input.Material = "钢材";
        Input.IsThermalBreak = false;
        Recalc();
    }

    private void SelectOtherMaterial()
    {
        Input.Material = "其它";
        Input.IsThermalBreak = false;
        Input.ColdFormedSteel = false;
        Recalc();
    }

    private async Task OnSteelAlumChanged()
    {
        if (Input.SteelAlumComposite && _allSaAluProfiles == null)
        {
            _saLoading = true;
            _allSaAluProfiles = await GlassApi.GetSteelAlumAluColumnsAsync();
            _allSaSteelProfiles = await GlassApi.GetSteelAlumSteelColumnsAsync();
            _saLoading = false;
            FilterSaAluProfiles();
            FilterSaSteelProfiles();
        }
        Recalc();
    }

    private void FilterSaAluProfiles()
    {
        if (_allSaAluProfiles == null) { _filteredSaAluProfiles = new(); return; }
        _filteredSaAluProfiles = string.IsNullOrWhiteSpace(_saAluSearch)
            ? _allSaAluProfiles
            : _allSaAluProfiles.Where(p => GetStr(p,"code").Contains(_saAluSearch, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private void FilterSaSteelProfiles()
    {
        if (_allSaSteelProfiles == null) { _filteredSaSteelProfiles = new(); return; }
        _filteredSaSteelProfiles = string.IsNullOrWhiteSpace(_saSteelSearch)
            ? _allSaSteelProfiles
            : _allSaSteelProfiles.Where(p => GetStr(p,"code").Contains(_saSteelSearch, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private void SelectSaAluProfile(JsonElement p) { _selectedSaAluCode = GetStr(p, "code"); }
    private void SelectSaSteelProfile(JsonElement p) { _selectedSaSteelCode = GetStr(p, "code"); }

    private static string GetStr(JsonElement e, string prop) => e.TryGetProperty(prop, out var v) ? v.GetString() ?? "" : "";
    private static double GetDbl(JsonElement e, string prop) => e.TryGetProperty(prop, out var v) ? v.GetDouble() : 0;
    private static string GetNum(JsonElement e, string prop) => e.TryGetProperty(prop, out var v) ? v.ToString() : "—";

