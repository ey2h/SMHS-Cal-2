          <TextBox Classes="hb" Canvas.Left="60" Canvas.Top="361" Width="88" Height="19" FontSize="12" Text="4000"/>
          <TextBlock Classes="hb" Canvas.Left="15" Canvas.Top="364" Width="36" Height="13" Text="剪力V=" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
          <ComboBox Classes="hb" Canvas.Left="115" Canvas.Top="380" Width="57" Height="20"/>
