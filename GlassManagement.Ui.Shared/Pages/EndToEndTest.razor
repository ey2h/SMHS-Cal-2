@page "/e2e-test"
@using GlassManagement.Ui.Shared.Models
@using System.Text.Json
@inject HttpClient Http
<div class="e2e-test" style="padding:16px;">
  <h3>End-to-End Test (Phase 1)</h3>
  <button class="btn btn-secondary" @onclick="RunTest">Run Test</button>
  <pre class="log" style="background:#fff; border:1px solid #ddd; padding:8px; margin-top:12px; max-height:260px; overflow:auto;">@logContent</pre>
</div>

@code {
  private string logContent = string.Empty;
  private async Task RunTest()
  {
    try
    {
      var panel = new GlassPanelInput { PanelId = "e2e1", Type = GlassPanelType.Single, Width = 1200, Height = 2400, Thickness = 6.0, Layers = new List<GlassLayerInput> { new() { MaterialId = "default", Thickness = 6.0 } } };
      var input = new GlassInput { ProjectId = "e2e-demo", RegionId = "default", Panels = new List<GlassPanelInput> { panel } };
      var json = JsonSerializer.Serialize(input);
      var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");
      var resp = await Http.PostAsync("/api/calculation/multi", content);
      logContent = $"Status: {resp.StatusCode}\n";
      if (resp.IsSuccessStatusCode)
      {
        var body = await resp.Content.ReadAsStringAsync();
        logContent += body.Substring(0, Math.Min(4000, body.Length));
      }
    }
    catch (Exception ex)
    {
      logContent = $"Error: {ex.Message}";
    }
  }
}
