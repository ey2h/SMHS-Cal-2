    private static string GetStr(JsonElement e, string p) => e.TryGetProperty(p, out var v) ? v.GetString() ?? "" : "";
    private static string GetNum(JsonElement e, string p) => e.TryGetProperty(p, out var v) ? v.ToString() : "-";
    private static double GetDouble(JsonElement e, string p)
    {
        if (!e.TryGetProperty(p, out var v)) return 0;
        if (v.ValueKind == JsonValueKind.Number) return v.GetDouble();
        if (double.TryParse(v.GetString(), out var d)) return d;
        return 0;
    }
}
