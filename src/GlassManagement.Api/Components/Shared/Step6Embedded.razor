                    <path d="M55,160 L55,148" fill="none" stroke="#D32F2F" stroke-width="2.5"/>
                    <!-- 立柱 -->
                    <rect x="108" y="100" width="16" height="130" fill="#78909C" stroke="#37474F" stroke-width="1"/>
                    <text x="138" y="170" font-size="9" fill="#455A64">立柱</text>
                    <!-- N箭头 -->
                    <line x1="116" y1="230" x2="116" y2="260" stroke="#1976D2" stroke-width="1.5"/>
                    <polygon points="116,260 112,252 120,252" fill="#1976D2"/>
                    <text x="126" y="258" font-size="10" fill="#1976D2" font-weight="bold">N</text>
                    <!-- V箭头 -->
                    <line x1="124" y1="130" x2="180" y2="130" stroke="#E65100" stroke-width="1.5"/>
                    <polygon points="180,130 172,126 172,134" fill="#E65100"/>
                    <text x="182" y="128" font-size="10" fill="#E65100" font-weight="bold">V</text>
                    <!-- e0 -->
                    <line x1="104" y1="68" x2="180" y2="68" stroke="#9C27B0" stroke-width="0.8" stroke-dasharray="3"/>
                    <text x="142" y="64" text-anchor="middle" font-size="9" fill="#9C27B0">e₀=@(Input.ForceE0)</text>
                </svg>
            }
            else if (Input.ForceMode == "梁顶埋")
            {
                <svg viewBox="0 0 260 280" width="240" height="260" style="display:block;margin:auto;background:#fafafa">
                    <!-- 梁截面 -->
                    <rect x="50" y="100" width="160" height="60" fill="#B0BEC5" stroke="#37474F" stroke-width="1.5"/>
                    <text x="130" y="135" text-anchor="middle" font-size="11" fill="#333">混凝土梁</text>
                    <!-- 预埋板(梁顶) -->
                    <rect x="80" y="90" width="100" height="10" fill="#607D8B" stroke="#37474F" stroke-width="1"/>
                    <!-- 锚筋(向下) -->
                    <line x1="100" y1="100" x2="100" y2="150" stroke="#D32F2F" stroke-width="2.5"/>
                    <line x1="160" y1="100" x2="160" y2="150" stroke="#D32F2F" stroke-width="2.5"/>
                    <!-- L弯钩 -->
                    <path d="M100,150 L100,155 L112,155" fill="none" stroke="#D32F2F" stroke-width="2.5"/>
