          <TextBox Classes="hb" Canvas.Left="171" Canvas.Top="420" Width="37" Height="18" FontSize="12" Text="320"/>
          <TextBlock Classes="hb" Canvas.Left="31" Canvas.Top="423" Width="132" Height="13" Text="挂轴材料抗弯强度设计值" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
          <TextBlock Classes="hb" Canvas.Left="243" Canvas.Top="431" Width="105" Height="30" Text="连接件与立柱螺栓个数（单侧）" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
          <TextBox Classes="hb" Canvas.Left="349" Canvas.Top="433" Width="36" Height="18" FontSize="12" Text="2"/>
          <TextBox Classes="hb" Canvas.Left="171" Canvas.Top="444" Width="37" Height="18" FontSize="12" Text="265"/>
          <TextBlock Classes="hb" Canvas.Left="31" Canvas.Top="447" Width="132" Height="13" Text="螺栓材料抗剪强度设计值" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
          <TextBlock Classes="hb" Canvas.Left="215" Canvas.Top="447" Width="18" Height="13" Text="MPa" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
          </Canvas>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="横梁与立柱">
