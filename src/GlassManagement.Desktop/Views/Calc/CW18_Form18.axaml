<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GlassManagement.Desktop.Views.Calc.CW18_Form18"
             FontFamily="SimSun" FontSize="12">
  <!-- VB6 form: 幕墙计算-胶类、伸缩及紧固计算 | client 784x537 | 158 nodes (73 labels) | pairs=36 spread=8px dropped=0 declutter:drop=0 move=2 -->
  <DockPanel>
    <Border DockPanel.Dock="Top" Height="19" Background="{DynamicResource HbTitleBarBg}" BorderBrush="{DynamicResource HbBorder}" BorderThickness="0,0,0,1">
      <TextBlock Text="幕墙计算-胶类、伸缩及紧固计算" FontSize="11" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource HbText}"/>
