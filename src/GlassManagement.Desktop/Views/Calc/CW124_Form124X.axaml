<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GlassManagement.Desktop.Views.Calc.CW124_Form124X"
             FontFamily="SimSun" FontSize="12">
  <!-- VB6 form: 门窗系统计算 | client 931x530 | 32 nodes (27 labels) | pairs=5 spread=0px dropped=0 declutter:drop=0 move=0 -->
  <DockPanel>
    <Border DockPanel.Dock="Top" Height="19" Background="#E8EEF7" BorderBrush="#A0A0A0" BorderThickness="0,0,0,1">
      <TextBlock Text="门窗系统计算" FontSize="11" Margin="8,0" VerticalAlignment="Center" Foreground="#1F2937"/>
    </Border>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
    <Canvas Width="931" Height="530" Background="#F0F0F0" ClipToBounds="True">
      <Border Classes="hbFrame" Canvas.Left="11" Canvas.Top="15" Width="912" Height="482"/>
      <TextBlock Classes="hbFrameTitle" Canvas.Left="17" Canvas.Top="6" Text="聚氨酯门窗槽口计算"/>
      <TextBlock Classes="hb" Canvas.Left="19" Canvas.Top="31" Width="72" Height="13" Text="植筋钢筋材质" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
      <TextBlock Classes="hb" Canvas.Left="259" Canvas.Top="31" Width="144" Height="13" Text="轴力N=                 N" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
      <TextBox Classes="hb" Canvas.Left="584" Canvas.Top="31" Width="331" Height="401" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" IsReadOnly="True"/>
      <TextBlock Classes="hb" Canvas.Left="27" Canvas.Top="39" Width="120" Height="13" Text="槽口尺寸a         mm" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
      <TextBlock Classes="hb" Canvas.Left="19" Canvas.Top="56" Width="162" Height="13" Text="植筋钢筋直径             mm" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
      <TextBlock Classes="hb" Canvas.Left="259" Canvas.Top="56" Width="144" Height="13" Text="剪力V=                 N" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
      <TextBlock Classes="hb" Canvas.Left="27" Canvas.Top="63" Width="120" Height="13" Text="槽口厚度t         mm" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
      <TextBlock Classes="hb" Canvas.Left="19" Canvas.Top="83" Width="60" Height="13" Text="混凝土等级" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
      <TextBlock Classes="hb" Canvas.Left="259" Canvas.Top="83" Width="180" Height="13" Text="弯矩M=                    N.mm" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
      <TextBlock Classes="hb" Canvas.Left="19" Canvas.Top="108" Width="72" Height="13" Text="结构重要系数" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
      <TextBlock Classes="hb" Canvas.Left="259" Canvas.Top="108" Width="132" Height="13" Text="*荷载参数不要输入符号*" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
      <TextBlock Classes="hb" Canvas.Left="259" Canvas.Top="133" Width="72" Height="13" Text="植筋行(排)数" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
      <TextBlock Classes="hb" Canvas.Left="19" Canvas.Top="157" Width="48" Height="13" Text="场地类型" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
      <TextBlock Classes="hb" Canvas.Left="259" Canvas.Top="157" Width="48" Height="13" Text="植筋列数" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
      <TextBlock Classes="hb" Canvas.Left="19" Canvas.Top="181" Width="216" Height="13" Text="横向钢筋（箍筋）直径              mm" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
      <TextBlock Classes="hb" Canvas.Left="259" Canvas.Top="182" Width="162" Height="13" Text="最外排植筋间距H          mm" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
      <TextBlock Classes="hb" Canvas.Left="19" Canvas.Top="206" Width="132" Height="13" Text="混凝土孔壁潮湿影响系数" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
      <TextBlock Classes="hb" Canvas.Left="259" Canvas.Top="206" Width="162" Height="13" Text="植筋锚固的深度           mm" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
      <TextBlock Classes="hb" Canvas.Left="19" Canvas.Top="230" Width="132" Height="13" Text="使用环境的温度影响系数" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
      <TextBlock Classes="hb" Canvas.Left="331" Canvas.Top="230" Width="120" Height="13" Text="植筋间距          mm" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
      <Border Classes="hbFrame" Canvas.Left="155" Canvas.Top="247" Width="217" Height="81"/>
      <TextBlock Classes="hbFrameTitle" Canvas.Left="161" Canvas.Top="238" Text="型材槽口参数"/>
      <TextBlock Classes="hb" Canvas.Left="19" Canvas.Top="254" Width="72" Height="13" Text="构件受力状态" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
      <TextBlock Classes="hb" Canvas.Left="331" Canvas.Top="255" Width="120" Height="13" Text="植筋边距          mm" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
      <TextBox Classes="hb" Canvas.Left="235" Canvas.Top="268" Width="41" Height="18" FontSize="12" Text="24"/>
      <TextBlock Classes="hb" Canvas.Left="19" Canvas.Top="279" Width="306" Height="13" Text="混凝土保护层厚度（植筋表面至构件表面距离）       mm" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
      <TextBox Classes="hb" Canvas.Left="235" Canvas.Top="292" Width="41" Height="18" FontSize="12" Text="1.5"/>
      <TextBlock Classes="hb" Canvas.Left="299" Canvas.Top="303" Width="60" Height="13" Text="粘结剂等级" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
      <Button Classes="hb" Canvas.Left="794" Canvas.Top="440" Width="59" Height="24" FontSize="12" HorizontalContentAlignment="Left"><TextBlock Classes="hb" Text="预演" FontSize="12" TextTrimming="CharacterEllipsis"/></Button>
      <Button Classes="hb" Canvas.Left="854" Canvas.Top="440" Width="59" Height="24" FontSize="12" HorizontalContentAlignment="Left"><TextBlock Classes="hb" Text="上一步" FontSize="12" TextTrimming="CharacterEllipsis"/></Button>
      <Button Classes="hb" Canvas.Left="794" Canvas.Top="464" Width="59" Height="24" FontSize="12" HorizontalContentAlignment="Left"><TextBlock Classes="hb" Text="退出" FontSize="12" TextTrimming="CharacterEllipsis"/></Button>
      <Button Classes="hb" Canvas.Left="854" Canvas.Top="464" Width="59" Height="24" FontSize="12" HorizontalContentAlignment="Left"><TextBlock Classes="hb" Text="下一步" FontSize="12" TextTrimming="CharacterEllipsis"/></Button>
    </Canvas>
    </ScrollViewer>
  </DockPanel>
</UserControl>