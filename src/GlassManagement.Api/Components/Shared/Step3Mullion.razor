@using System.Text.Json
@using static GlassManagement.Api.Components.Pages.Wizard
@inject GlassApiClient GlassApi

<!-- 标题条 -->
<div class="hb-title-bar">@CurtainWallType 幕墙计算 - 立柱计算</div>

<div style="display:flex;gap:10px;align-items:flex-start">
    <!-- ====== 左侧参数区 ====== -->
    <div style="flex:1;min-width:0">

        <!-- 力学模型 -->
        <fieldset class="groupbox">
            <legend class="groupbox-title">力学模型</legend>
            <div class="hb-radio-card-group" style="grid-template-columns:repeat(3,1fr)">
                @for (int i = 1; i <= 6; i++)
                {
                    var model = i;
                    <label class="hb-radio-card">
                        <input type="radio" name="mechModel" value="@model"
                               checked="@(Input.MechanicalModel == model)"
                               @onchange="() => { Input.MechanicalModel = model; Recalc(); }" />
                        @RenderModelSvg(model)
                        <div style="font-size:10px;font-weight:600;margin-top:2px">@GetModelName(model)</div>
                    </label>
                }
            </div>
            <!-- 力学模型红色提示文字 -->
            <div style="margin-top:6px;font-size:11px;color:red;line-height:1.5">
                @GetModelHint(Input.MechanicalModel)
            </div>
            @if (Input.MechanicalModel == 3)
            {
                <div style="margin-top:4px;font-size:11px;color:darkorange;font-weight:600">
                    ⚠ 注意：连续梁模型要求连接点具有足够刚度，请确认端戊惯性矩 ≥ 立柱惯性矩且插入足够深。
                </div>
            }
        </fieldset>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
            <!-- 跨度 -->
            <fieldset class="groupbox">
                <legend class="groupbox-title">跨度参数</legend>
                <div class="param-row">
                    <span class="param-label">立柱跨度</span>
                    <input class="hb-input" style="width:70px" type="number" @bind="Input.Span" step="1" @bind:after="Recalc"/>
                    <span class="param-unit">mm</span>
                </div>
                @if (Input.MechanicalModel >= 3)
                {
                    <div class="param-row" style="margin-top:4px">
                        <span class="param-label">短跨长</span>
                        <input class="hb-input" style="width:70px" type="number" @bind="Input.ShortSpan" step="1" @bind:after="Recalc"/>
                        <span class="param-unit">mm</span>
                    </div>
                    @if (Input.MechanicalModel == 5 && Input.ShortSpan < 500 && Input.ShortSpan > 0)
                    {
                        <div style="margin-top:4px;font-size:11px;color:red;font-weight:600">
                            ⚠ 短跨长小于500mm，作用不大且性价比不高
                        </div>
                    }
                }
            </fieldset>

            <!-- 龙骨挠度执行规范 -->
            <fieldset class="groupbox">
                <legend class="groupbox-title">龙骨挠度执行规范（横梁同）</legend>
                <select class="hb-input" style="width:100%" @bind="Input.DeflectionStandard" @bind:after="Recalc">
                    <option value="JGJ133-2001">JGJ133-2001</option>
                    <option value="JGJ102-2003">JGJ102-2003</option>
                    <option value="JGJ336-2016">JGJ336-2016</option>
                    <option value="GB/T21086-2007">GB/T 21086-2007</option>
                    <option value="上海规范">上海规范</option>
                </select>
                <div class="param-row" style="margin-top:4px">
                    <label class="hb-checkbox" title="不选此项表示为按单跨计算的多跨结构，选中则表示只有一跨的结构">
                        <input type="checkbox" @bind="Input.AbsoluteSpan" @bind:after="Recalc" />绝对单跨
                    </label>
                </div>
                <div style="margin-top:4px">
                    <button class="hb-btn" style="height:22px;padding:0 8px;font-size:11px" type="button">帮助</button>
                </div>
            </fieldset>
        </div>

        <!-- 玻璃配置 -->
        <fieldset class="groupbox">
            <legend class="groupbox-title">玻璃配置</legend>
            <div style="display:grid;grid-template-columns:auto 1fr auto 1fr;gap:6px;align-items:center">
                <span class="param-label">外片</span>
                <select class="hb-input" @bind="Input.OuterGlassThickness" @bind:after="Recalc">
                    @foreach (var t in _glassThicknesses)
                    {
                        <option value="@t">@t mm</option>
                    }
                </select>
                <span class="param-label">内片</span>
                <select class="hb-input" @bind="Input.InnerGlassThickness" @bind:after="Recalc">
                    @foreach (var t in _glassThicknesses)
                    {
                        <option value="@t">@t mm</option>
                    }
                </select>
            </div>
        </fieldset>

        <!-- 立柱选材 -->
        <fieldset class="groupbox">
            <legend class="groupbox-title">立柱选材</legend>
            <!-- 铝合金牌号组 -->
            <div class="hb-radio-group horizontal" style="margin-bottom:4px">
                @foreach (var g in new[] { "6063-T5", "6063-T6", "6061-T4", "6061-T6", "6063A-T5", "6063A-T6" })
                {
                    var grade = g;
                    <label><input type="radio" name="materialGrade3" checked="@(Input.Material=="铝合金" && Input.AluminumGrade==grade)" @onchange="() => SelectAluGrade(grade)" />@grade</label>
                }
            </div>
            <!-- 钢材牌号组 -->
            <div class="hb-radio-group horizontal" style="margin-bottom:4px">
                @foreach (var g in new[] { "Q235", "Q355" })
                {
                    var grade = g;
                    <label><input type="radio" name="materialGrade3" checked="@(Input.Material=="钢材" && Input.SteelGrade==grade)" @onchange="() => SelectSteelGrade(grade)" />@grade</label>
                }
                <!-- 其它材质 radio -->
                <label><input type="radio" name="materialGrade3" checked="@(Input.Material=="其它")" @onchange="() => SelectOtherMaterial()" />其它材质</label>
            </div>

            <!-- 其它材质输入区 -->
            @if (Input.Material == "其它")
            {
                <fieldset class="groupbox" style="margin-top:4px;background:var(--bg-page)">
                    <legend class="groupbox-title" style="font-size:11px">其它材质参数</legend>
                    <div style="display:grid;grid-template-columns:auto 1fr auto auto 1fr auto;gap:4px;align-items:center;font-size:11px">
                        <span class="param-label">名称</span>
                        <input class="hb-input" style="width:100%" @bind="Input.OtherMaterialName" />
                        <span class="param-label">弹性模量</span>
                        <input class="hb-input" style="width:70px" type="number" @bind="Input.ElasticModulus" step="100" @bind:after="Recalc" />
                        <span class="param-unit">MPa</span>
                        <span></span>
                        <span class="param-label">类别</span>
                        <select class="hb-input" @bind="Input.MaterialCategory">
                            <option>铝</option><option>钢</option>
                        </select>
                        <span class="param-label">抗弯强度</span>
                        <input class="hb-input" style="width:70px" type="number" @bind="Input.AllowableStress" step="1" @bind:after="Recalc" />
                        <span class="param-unit">MPa</span>
                        <span></span>
                        <span></span>
                        <span></span>
                        <span class="param-label">抗剪强度</span>
                        <input class="hb-input" style="width:70px" type="number" @bind="Input.AllowableShear" step="1" @bind:after="Recalc" />
                        <span class="param-unit">MPa</span>
                        <span></span>
                    </div>
                </fieldset>
            }

            <!-- 条件选项 -->
            <div style="margin-top:4px;display:flex;gap:12px;flex-wrap:wrap">
                @if (IsAluminum)
                {
                    <label class="hb-checkbox"><input type="checkbox" @bind="Input.IsThermalBreak" @bind:after="Recalc" />断热</label>
                }
                @if (IsSteel)
                {
                    <label class="hb-checkbox"><input type="checkbox" @bind="Input.ColdFormedSteel" @bind:after="Recalc" />冷弯薄壁型钢</label>
                }
                <label class="hb-checkbox"><input type="checkbox" @bind="Input.SteelAlumComposite" @bind:after="OnSteelAlumChanged" />钢铝结合</label>
            </div>
        </fieldset>
    </div>

    <!-- ====== 中间：型材表格 / 钢铝结合面板 ====== -->
    @if (Input.SteelAlumComposite)
    {
        <!-- 钢铝结合专用面板 -->
        <div style="flex:1.2;min-width:0">
            <!-- 铝框型材 -->
            <fieldset class="groupbox">
                <legend class="groupbox-title">铝框型材（钢铝结合）</legend>
                <div class="hb-search" style="margin-bottom:4px">
                    <input class="hb-input" style="width:100%" placeholder="搜索铝框型材..." @bind="_saAluSearch" @bind:event="oninput" @bind:after="FilterSaAluProfiles"/>
                </div>
                @if (_saLoading)
                {
                    <div style="text-align:center;padding:12px;color:var(--text-muted)"><span class="spinner"></span> 加载中...</div>
                }
                else
                {
                    <div style="max-height:200px;overflow:auto">
                        <table class="hb-table" style="font-size:11px">
                            <thead><tr><th>型材代号</th><th>Ix</th><th>Iy</th><th>Wx1</th><th>Wx2</th><th>壁厚</th><th>截面积</th></tr></thead>
                            <tbody>
                                @foreach (var p in _filteredSaAluProfiles)
                                {
                                    var pCode = GetStr(p, "code");
                                    var sel = pCode == _selectedSaAluCode;
                                    <tr class="@(sel?"selected":"")" style="cursor:pointer" @onclick="() => SelectSaAluProfile(p)">
                                        <td style="font-weight:600">@pCode</td>
                                        <td>@GetNum(p,"ix")</td><td>@GetNum(p,"iy")</td>
                                        <td>@GetNum(p,"wx1")</td><td>@GetNum(p,"wx2")</td>
                                        <td>@GetNum(p,"wallThickness")</td><td>@GetNum(p,"area")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div style="font-size:10px;color:var(--text-muted);text-align:right">共 @(_allSaAluProfiles?.Count ?? 0) 条</div>
                }
            </fieldset>

            <!-- 钢框型材 -->
            <fieldset class="groupbox">
                <legend class="groupbox-title">钢框型材（钢铝结合）</legend>
                <div class="hb-search" style="margin-bottom:4px">
                    <input class="hb-input" style="width:100%" placeholder="搜索钢框型材..." @bind="_saSteelSearch" @bind:event="oninput" @bind:after="FilterSaSteelProfiles"/>
                </div>
                @if (_saLoading)
                {
                    <div style="text-align:center;padding:12px;color:var(--text-muted)"><span class="spinner"></span> 加载中...</div>
                }
                else
                {
                    <div style="max-height:200px;overflow:auto">
                        <table class="hb-table" style="font-size:11px">
                            <thead><tr><th>型材代号</th><th>Ix</th><th>Iy</th><th>Wx1</th><th>Wx2</th><th>壁厚</th><th>截面积</th></tr></thead>
                            <tbody>
                                @foreach (var p in _filteredSaSteelProfiles)
                                {
                                    var pCode = GetStr(p, "code");
                                    var sel = pCode == _selectedSaSteelCode;
                                    <tr class="@(sel?"selected":"")" style="cursor:pointer" @onclick="() => SelectSaSteelProfile(p)">
                                        <td style="font-weight:600">@pCode</td>
                                        <td>@GetNum(p,"ix")</td><td>@GetNum(p,"iy")</td>
                                        <td>@GetNum(p,"wx1")</td><td>@GetNum(p,"wx2")</td>
                                        <td>@GetNum(p,"wallThickness")</td><td>@GetNum(p,"area")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div style="font-size:10px;color:var(--text-muted);text-align:right">共 @(_allSaSteelProfiles?.Count ?? 0) 条</div>
                }
            </fieldset>
        </div>
    }
    else
    {
        <!-- 普通型材表格 -->
        <div style="flex:1.2;min-width:0">
            <fieldset class="groupbox">
                <legend class="groupbox-title">立柱选材</legend>
                <div style="margin-bottom:4px;font-size:11px;color:var(--text-muted)">
                    快速查找型材 → 请在此处输入待查找型材代号或其关键字
                    <span style="float:right;color:var(--primary);font-weight:600;cursor:pointer" @onclick="() => _showUnitModal = true">单位说明</span>
                </div>
                <div class="hb-search" style="margin-bottom:4px">
                    <input class="hb-input" style="width:100%" placeholder="搜索型材代号..." @bind="_profileSearch" @bind:event="oninput" @bind:after="FilterProfiles"/>
                </div>
                @if (_loading)
                {
                    <div style="text-align:center;padding:20px;color:var(--text-muted)"><span class="spinner"></span> 加载中...</div>
                }
                else
                {
                    <div style="max-height:420px;overflow:auto">
                        <table class="hb-table" style="font-size:11px">
                            <thead>
                                <tr>
                                    <th style="min-width:90px">型材代号</th>
                                    <th>Ix惯性矩</th><th>Iy惯性矩</th><th>Wx1抵抗矩</th><th>Wx2抵抗矩</th>
                                    <th>壁厚</th><th>截面积</th><th>面积矩</th><th>翼缘宽度</th><th>备</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in _filteredProfiles)
                                {
                                    var pCode = GetStr(p, "code");
                                    var sel = pCode == Input.ProfileCode;
                                    <tr class="@(sel?"selected":"")" style="cursor:pointer" @onclick="() => SelectProfile(p)">
                                        <td style="text-align:left;font-weight:600">@pCode</td>
                                        <td>@GetNum(p,"ix")</td><td>@GetNum(p,"iy")</td>
                                        <td>@GetNum(p,"wx1")</td><td>@GetNum(p,"wx2")</td>
                                        <td>@GetNum(p,"wallThickness")</td><td>@GetNum(p,"area")</td>
                                        <td>@GetNum(p,"staticMoment")</td><td>@GetNum(p,"shearWebWidth")</td><td></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div style="font-size:11px;color:var(--text-muted);margin-top:4px;text-align:right">
                        共 @(_allProfiles?.Count ?? 0) 条型材 · 显示 @_filteredProfiles.Count 条
                    </div>
                }
            </fieldset>
        </div>
    }

    <!-- ====== 右侧：实时验算结果 ====== -->
    <div style="flex:0.8;min-width:220px">
        <fieldset class="groupbox" style="background:var(--bg-page)">
            <legend class="groupbox-title">立柱验算结果</legend>
            <div style="font-size:11px;line-height:1.8;font-family:'Consolas','Microsoft YaHei UI',monospace">
                <div style="border:2px dashed var(--primary);padding:6px;margin-bottom:6px;background:var(--bg-white)">
                    <div>风荷载标准值为：<b>@(Input.WindLoadStd.ToString("F3")) kPa</b></div>
                </div>

                <div style="margin-bottom:4px">
                    <div>抗弯矩标选：<b>@(Input.MomentRequired.ToString("F0")) mm²</b></div>
                    <div>选用型材的抗弯矩设计值为：<b>@(Input.Wx1.ToString("F0")) cm³</b></div>
                    <div class="@(Input.BendingMomentPass ? "result-pass" : "result-fail")">
                        @(Input.BendingMomentPass ? "满足要求(√)" : "● 不满足要求(✗)")
                    </div>
                </div>

                <div style="margin-bottom:4px">
                    <div>惯性矩标选：<b>@(Input.InertiaRequired.ToString("F0")) mm⁴</b></div>
                    <div>选用型材的惯性矩设计值为：<b>@(Input.Ix.ToString("F0")) cm⁴</b></div>
                    <div class="@(Input.InertiaPass ? "result-pass" : "result-fail")">
                        @(Input.InertiaPass ? "满足要求(√)" : "● 不满足要求(✗)")
                    </div>
                </div>

                <div style="margin-bottom:4px">
                    <div>实际挠度计算值为：<b>@(Input.ActualDeflection.ToString("F3")) mm</b></div>
                    <div>规范要求的挠度值为：<b>@(Input.DeflectionLimit.ToString("F3")) mm</b></div>
                    <div class="@(Input.DeflectionPass ? "result-pass" : "result-fail")">
                        @(Input.DeflectionPass ? "满足要求(√)" : "● 不满足要求(✗)")
                    </div>
                </div>

                <div style="margin-bottom:4px">
                    <div>抗弯强度计算值：<b>@(Input.BendingStress.ToString("F3")) MPa</b></div>
                    <div>选用型材的抗弯强度设计值为：<b>@(Input.AllowableStress.ToString("F0")) MPa</b></div>
                    <div class="@(Input.BendingPass ? "result-pass" : "result-fail")">
                        @(Input.BendingPass ? "满足要求(√)" : "● 不满足要求(✗)")
                    </div>
                </div>

                <div style="margin-bottom:4px">
                    <div>抗剪强度计算值：<b>@(Input.ShearStress.ToString("F3")) MPa</b></div>
                    <div>选用型材的抗剪强度设计值为：<b>@(Input.AllowableShear.ToString("F0")) MPa</b></div>
                    <div class="@(Input.ShearPass ? "result-pass" : "result-fail")">
                        @(Input.ShearPass ? "满足要求(√)" : "● 不满足要求(✗)")
                    </div>
                </div>

                <div style="border-top:1px solid var(--border-color);padding-top:6px;margin-top:8px">
                    <div>支反力：<b>@(Input.ReactionForce.ToString("F3")) kN</b></div>
                </div>
            </div>
        </fieldset>

        @if (Input.SteelAlumComposite)
        {
            <fieldset class="groupbox" style="background:var(--bg-page);margin-top:8px">
                <legend class="groupbox-title">钢铝结合验算</legend>
                <div style="font-size:11px;line-height:1.6">
                    <div><b>铝框：</b>@(_selectedSaAluCode != "" ? _selectedSaAluCode : "未选择")</div>
                    <div><b>钢框：</b>@(_selectedSaSteelCode != "" ? _selectedSaSteelCode : "未选择")</div>
                </div>
            </fieldset>
        }
    </div>
</div>

<!-- ====== 力学模型 SVG 图 ====== -->
<fieldset class="groupbox" style="margin-top:10px">
    <legend class="groupbox-title">📐 力学模型图 — @GetModelName(Input.MechanicalModel)</legend>
    <div style="display:flex;justify-content:center">
        @if (Input.MechanicalModel == 1)
        {
            @* ① 双端简支-均布荷载 *@
            <svg width="100%" viewBox="0 0 500 520" xmlns="http://www.w3.org/2000/svg" style="max-width:600px" font-family="'Segoe UI','Microsoft YaHei UI',sans-serif">
                <defs>
                    <marker id="arrD1" markerWidth="6" markerHeight="4" refX="6" refY="2" orient="auto"><polygon points="0,0 6,2 0,4" fill="var(--accent-red,#e74c3c)"/></marker>
                    <marker id="arrB1" markerWidth="6" markerHeight="4" refX="6" refY="2" orient="auto"><polygon points="0,0 6,2 0,4" fill="var(--primary,#007AFF)"/></marker>
                </defs>
                <!-- Panel 1: Structural Model -->
                <text x="20" y="16" font-size="10" font-weight="600" fill="var(--text-muted,#888)" letter-spacing="0.6">STRUCTURAL MODEL · 结构模型</text>
                <rect x="80" y="55" width="340" height="12" rx="2" fill="var(--primary,#007AFF)" opacity="0.15" stroke="var(--primary,#007AFF)" stroke-width="1"/>
                <line x1="80" y1="61" x2="420" y2="61" stroke="var(--primary,#007AFF)" stroke-width="0.5" stroke-dasharray="4,3"/>
                <!-- pin A -->
                <polygon points="80,69 70,87 90,87" fill="none" stroke="var(--text-primary,#333)" stroke-width="1.2"/>
                <line x1="65" y1="89" x2="95" y2="89" stroke="var(--text-primary,#333)" stroke-width="1"/>
                <g stroke="var(--text-muted,#888)" stroke-width="0.6"><line x1="67" y1="89" x2="63" y2="94"/><line x1="73" y1="89" x2="69" y2="94"/><line x1="79" y1="89" x2="75" y2="94"/><line x1="85" y1="89" x2="81" y2="94"/><line x1="91" y1="89" x2="87" y2="94"/></g>
                <!-- roller B -->
                <polygon points="420,69 410,84 430,84" fill="none" stroke="var(--text-primary,#333)" stroke-width="1.2"/>
                <circle cx="416" cy="88" r="2.5" fill="none" stroke="var(--text-primary,#333)" stroke-width="0.8"/><circle cx="424" cy="88" r="2.5" fill="none" stroke="var(--text-primary,#333)" stroke-width="0.8"/>
                <line x1="408" y1="91" x2="436" y2="91" stroke="var(--text-primary,#333)" stroke-width="1"/>
                <!-- UDL arrows -->
                <line x1="95" y1="28" x2="405" y2="28" stroke="var(--accent-red,#e74c3c)" stroke-width="1" opacity="0.6"/>
                <g stroke="var(--accent-red,#e74c3c)" stroke-width="0.8" opacity="0.6" marker-end="url(#arrD1)">
                    @for(int x=100;x<=400;x+=25){<line x1="@x" y1="30" x2="@x" y2="50"/>}
                </g>
                <text x="250" y="24" font-size="10" fill="var(--accent-red,#e74c3c)" text-anchor="middle" font-weight="600">q</text>
                <!-- dimension -->
                <line x1="80" y1="102" x2="420" y2="102" stroke="var(--text-muted,#888)" stroke-width="0.6"/>
                <line x1="80" y1="97" x2="80" y2="107" stroke="var(--text-muted,#888)" stroke-width="0.6"/>
                <line x1="420" y1="97" x2="420" y2="107" stroke="var(--text-muted,#888)" stroke-width="0.6"/>
                <text x="250" y="100" font-size="9" fill="var(--text-muted,#888)" text-anchor="middle">L</text>
                <text x="80" y="116" font-size="8" fill="var(--text-muted,#888)" text-anchor="middle">A</text>
                <text x="420" y="116" font-size="8" fill="var(--text-muted,#888)" text-anchor="middle">B</text>

                <!-- Panel 2: Shear V -->
                <line x1="20" y1="130" x2="480" y2="130" stroke="var(--border-color,#ddd)" stroke-width="0.5"/>
                <text x="20" y="145" font-size="10" font-weight="600" fill="var(--text-muted,#888)" letter-spacing="0.6">SHEAR FORCE · 剪力图 V(x)</text>
                <line x1="80" y1="185" x2="420" y2="185" stroke="var(--text-muted,#888)" stroke-width="0.6"/>
                <polygon points="80,185 80,160 250,185" fill="#FF9500" opacity="0.12"/>
