          <Border Classes="hbFrame" Canvas.Left="211" Canvas.Top="386" Width="240" Height="65"/>
          <TextBlock Classes="hbFrameTitle" Canvas.Left="217" Canvas.Top="377" Text="计算普通粘结锚栓时的长期荷载参数(?)"/>
