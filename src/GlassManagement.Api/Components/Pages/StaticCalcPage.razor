@page "/static-calc"
@rendermode InteractiveServer
@inject WizardApiClient Api

<div class="page-enter">
    <h1 class="page-title">📊 静力计算器</h1>
    <p class="page-subtitle">梁构件力学分析 · 弯矩/剪力/挠度图</p>

    <div style="display:grid;grid-template-columns:280px 1fr;gap:16px">
        <!-- 左侧参数 -->
        <div>
            <div class="card">
                <div class="section-title">
                    <span class="material-symbols-outlined">settings</span> 模型参数
                </div>
                <div class="form-group" style="margin-bottom:12px">
                    <label class="label">力学模型</label>
                    <select class="input-field" @bind="_model">
                        <option value="simply-supported">简支梁</option>
                        <option value="cantilever">悬臂梁</option>
                        <option value="fixed-fixed">两端固定</option>
                        <option value="fixed-pinned">一端固定一端铰</option>
                        <option value="two-span">双跨连续</option>
                    </select>
                </div>

                <!-- 模型示意SVG -->
                <div style="background:var(--bg-input);border-radius:var(--radius-xs);padding:12px;margin-bottom:12px">
                    <svg viewBox="0 0 240 70" style="width:100%;height:60px">
                        <line x1="20" y1="35" x2="220" y2="35" stroke="var(--text-1)" stroke-width="2.5"/>
                        @if (_model == "simply-supported" || _model == "two-span")
                        {
                            <polygon points="20,35 14,50 26,50" fill="var(--blue)"/>
                            <polygon points="220,35 214,50 226,50" fill="var(--blue)"/>
                        }
                        @if (_model == "two-span")
                        {
                            <polygon points="120,35 114,50 126,50" fill="var(--blue)"/>
                        }
                        @if (_model == "cantilever")
                        {
                            <rect x="14" y="20" width="8" height="30" fill="var(--blue)" opacity="0.5"/>
                            <line x1="18" y1="20" x2="18" y2="50" stroke="var(--blue)" stroke-width="2"/>
                        }
                        @if (_model == "fixed-fixed")
                        {
                            <rect x="14" y="20" width="8" height="30" fill="var(--blue)" opacity="0.5"/>
                            <rect x="218" y="20" width="8" height="30" fill="var(--blue)" opacity="0.5"/>
                        }
                        @if (_model == "fixed-pinned")
                        {
                            <rect x="14" y="20" width="8" height="30" fill="var(--blue)" opacity="0.5"/>
                            <polygon points="220,35 214,50 226,50" fill="var(--blue)"/>
                        }
                        @for (int i = 40; i <= 200; i += 25)
                        {
                            <line x1="@i" y1="10" x2="@i" y2="30" stroke="var(--red)" stroke-width="1" opacity="0.6"/>
                            <polygon points="@(i-2),28 @(i+2),28 @i,33" fill="var(--red)" opacity="0.6"/>
                        }
                        <text x="120" y="65" font-size="9" fill="var(--text-3)" text-anchor="middle">@GetModelName()</text>
                    </svg>
                </div>

                <div class="form-group" style="margin-bottom:12px">
                    <label class="label">跨度 L (mm)</label>
                    <input class="input-field" type="number" @bind="_span" />
                </div>
                <div class="form-group" style="margin-bottom:12px">
                    <label class="label">均布荷载 q (kN/m)</label>
                    <input class="input-field" type="number" @bind="_load" step="0.01" />
                </div>
                <div class="form-group" style="margin-bottom:12px">
                    <label class="label">弹性模量 E (MPa)</label>
                    <input class="input-field" type="number" @bind="_E" />
                </div>
                <div class="form-group" style="margin-bottom:16px">
                    <label class="label">惯性矩 I (mm⁴)</label>
                    <input class="input-field" type="number" @bind="_I" />
                </div>
                <button class="btn-primary" style="width:100%" @onclick="Calculate" disabled="@_loading">
                    @if (_loading) { <span class="spinner"></span> }
                    <span class="material-symbols-outlined">calculate</span> 计算
                </button>
            </div>
        </div>

        <!-- 右侧图表 -->
        <div>
            @if (_hasResult)
            {
                <div class="card">
                    <div class="section-title">
                        <span class="material-symbols-outlined">show_chart</span> 内力图
                    </div>
                    <!-- 弯矩图 -->
                    <div style="margin-bottom:20px">
                        <div style="font-size:12px;font-weight:600;color:var(--text-2);margin-bottom:8px">弯矩图 M (kN·m)</div>
                        <svg viewBox="0 0 600 180" style="width:100%;height:180px;background:var(--bg-input);border-radius:var(--radius-xs)">
                            @RenderDiagram(_momentPoints, "var(--blue)", true)
                        </svg>
                    </div>
                    <!-- 剪力图 -->
                    <div style="margin-bottom:20px">
                        <div style="font-size:12px;font-weight:600;color:var(--text-2);margin-bottom:8px">剪力图 V (kN)</div>
                        <svg viewBox="0 0 600 150" style="width:100%;height:150px;background:var(--bg-input);border-radius:var(--radius-xs)">
                            @RenderDiagram(_shearPoints, "var(--orange)", false)
                        </svg>
                    </div>
                    <!-- 挠度图 -->
                    <div>
                        <div style="font-size:12px;font-weight:600;color:var(--text-2);margin-bottom:8px">挠度图 δ (mm)</div>
                        <svg viewBox="0 0 600 150" style="width:100%;height:150px;background:var(--bg-input);border-radius:var(--radius-xs)">
                            @RenderDiagram(_deflPoints, "var(--green)", true)
                        </svg>
                    </div>
                </div>

                <!-- 结果表格 -->
                <div class="card">
                    <div class="section-title">
                        <span class="material-symbols-outlined">table_chart</span> 计算结果
                    </div>
                    <div class="metric-grid">
                        <div class="metric-card">
                            <div class="metric-label">最大弯矩 Mmax</div>
                            <div class="metric-value">@_mMax.ToString("F2")</div>
                            <div class="metric-unit">kN·m</div>
                        </div>
                        <div class="metric-card">
                            <div class="metric-label">最大剪力 Vmax</div>
                            <div class="metric-value">@_vMax.ToString("F2")</div>
                            <div class="metric-unit">kN</div>
                        </div>
                        <div class="metric-card">
                            <div class="metric-label">最大挠度 δmax</div>
                            <div class="metric-value">@_dMax.ToString("F2")</div>
                            <div class="metric-unit">mm</div>
                        </div>
                        <div class="metric-card">
                            <div class="metric-label">挠度限值 L/@_deflLimit</div>
                            <div class="metric-value" style="color:@(_dMax <= _span / _deflLimit ? "var(--green)" : "var(--red)")">
                                @((_span / _deflLimit).ToString("F2"))
                            </div>
                            <div class="metric-unit">mm</div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card" style="min-height:400px;display:flex;align-items:center;justify-content:center">
                    <div style="text-align:center;color:var(--text-3)">
                        <span class="material-symbols-outlined" style="font-size:48px;opacity:0.3">show_chart</span>
                        <div style="margin-top:12px">设置参数后点击「计算」查看结果</div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string _model = "simply-supported";
    private double _span = 3600;
    private double _load = 2.5;
    private double _E = 70000;
    private double _I = 500000;
    private bool _loading, _hasResult;
    private double _mMax, _vMax, _dMax;
    private int _deflLimit = 180;

    private List<(double X, double Y)> _momentPoints = new();
    private List<(double X, double Y)> _shearPoints = new();
    private List<(double X, double Y)> _deflPoints = new();

    private string GetModelName() => _model switch
    {
        "simply-supported" => "简支梁 - 均布荷载",
        "cantilever" => "悬臂梁 - 均布荷载",
        "fixed-fixed" => "两端固定 - 均布荷载",
        "fixed-pinned" => "固定-铰支 - 均布荷载",
        "two-span" => "双跨连续 - 均布荷载",
        _ => ""
    };

    private async Task Calculate()
    {
        _loading = true;
        try
        {
            var result = await Api.CalcBeamAsync(new
            {
                model = _model,
                span = _span,
                load = _load,
                elasticModulus = _E,
                momentOfInertia = _I
            });

            // Generate points locally as fallback
            GenerateLocalPoints();
            _hasResult = true;
        }
        catch
        {
            GenerateLocalPoints();
            _hasResult = true;
        }
        _loading = false;
    }

    private void GenerateLocalPoints()
    {
        _momentPoints.Clear(); _shearPoints.Clear(); _deflPoints.Clear();
        int n = 100;
        double L = _span / 1000.0; // m
        double q = _load; // kN/m

        for (int i = 0; i <= n; i++)
        {
            double x = i * L / n;
            double mx, vx, dx;

            if (_model == "simply-supported")
            {
                mx = q * x * (L - x) / 2;
                vx = q * (L / 2 - x);
                dx = q * x * (L * L * L - 2 * L * x * x + x * x * x) / (24 * _E * _I * 1e-12) * 1e9;
            }
            else if (_model == "cantilever")
            {
                mx = -q * (L - x) * (L - x) / 2;
                vx = q * (L - x);
                dx = q * (6 * L * L * x * x - 4 * L * x * x * x + x * x * x * x) / (24 * _E * _I * 1e-12) * 1e9;
            }
            else // fixed-fixed approx
            {
                mx = q * (6 * L * x - 6 * x * x - L * L) / 12;
                vx = q * (L / 2 - x);
                dx = q * x * x * (L - x) * (L - x) / (24 * _E * _I * 1e-12) * 1e9;
            }

            _momentPoints.Add((x / L, mx));
            _shearPoints.Add((x / L, vx));
            _deflPoints.Add((x / L, dx));
        }

        _mMax = _momentPoints.Max(p => Math.Abs(p.Y));
        _vMax = _shearPoints.Max(p => Math.Abs(p.Y));
        _dMax = _deflPoints.Max(p => Math.Abs(p.Y));
    }

    private Microsoft.AspNetCore.Components.RenderFragment RenderDiagram(List<(double X, double Y)> points, string color, bool flipPositive)
    {
        return builder =>
        {
            if (points.Count == 0) return;

            double maxAbs = points.Max(p => Math.Abs(p.Y));
            if (maxAbs < 1e-10) maxAbs = 1;

            double svgW = 600, svgH = points == _momentPoints ? 180 : 150;
            double margin = 40;
            double plotW = svgW - margin * 2;
            double plotH = svgH - 30;
            double midY = svgH / 2;

            // Axis
            builder.OpenElement(0, "line");
            builder.AddAttribute(1, "x1", margin.ToString());
            builder.AddAttribute(2, "y1", midY.ToString());
            builder.AddAttribute(3, "x2", (svgW - margin).ToString());
            builder.AddAttribute(4, "y2", midY.ToString());
            builder.AddAttribute(5, "stroke", "var(--text-3)");
            builder.AddAttribute(6, "stroke-width", "1");
            builder.AddAttribute(7, "stroke-dasharray", "4,3");
            builder.CloseElement();

            // Supports
            double[] supX = { margin, svgW - margin };
            foreach (var sx in supX)
            {
                builder.OpenElement(10, "polygon");
                builder.AddAttribute(11, "points", $"{sx},{midY} {sx - 6},{midY + 12} {sx + 6},{midY + 12}");
                builder.AddAttribute(12, "fill", "var(--text-3)");
                builder.AddAttribute(13, "opacity", "0.4");
                builder.CloseElement();
            }

            // Build path
            var pathData = new System.Text.StringBuilder();
            pathData.Append($"M {margin},{midY} ");
            int maxIdx = 0; double maxVal = 0;
            for (int i = 0; i < points.Count; i++)
            {
                var (px, py) = points[i];
                double sx2 = margin + px * plotW;
                double sign = flipPositive ? 1 : -1;
                double sy = midY - sign * (py / maxAbs) * (plotH / 2 - 5);
                pathData.Append($"L {sx2:F1},{sy:F1} ");
                if (Math.Abs(py) > Math.Abs(maxVal)) { maxVal = py; maxIdx = i; }
            }
            pathData.Append($"L {svgW - margin},{midY} Z");

            // Fill
            builder.OpenElement(20, "path");
            builder.AddAttribute(21, "d", pathData.ToString());
            builder.AddAttribute(22, "fill", color);
            builder.AddAttribute(23, "fill-opacity", "0.12");
            builder.AddAttribute(24, "stroke", color);
            builder.AddAttribute(25, "stroke-width", "2");
            builder.CloseElement();

            // Max annotation
            var maxP = points[maxIdx];
            double maxSx = margin + maxP.X * plotW;
            double signM = flipPositive ? 1 : -1;
            double maxSy = midY - signM * (maxP.Y / maxAbs) * (plotH / 2 - 5);
            builder.OpenElement(30, "circle");
            builder.AddAttribute(31, "cx", maxSx.ToString("F1"));
            builder.AddAttribute(32, "cy", maxSy.ToString("F1"));
            builder.AddAttribute(33, "r", "4");
            builder.AddAttribute(34, "fill", color);
            builder.CloseElement();

            builder.OpenElement(40, "text");
            builder.AddAttribute(41, "x", maxSx.ToString("F1"));
            builder.AddAttribute(42, "y", (maxSy + (signM > 0 ? -10 : 14)).ToString("F1"));
            builder.AddAttribute(43, "font-size", "10");
            builder.AddAttribute(44, "fill", color);
            builder.AddAttribute(45, "text-anchor", "middle");
            builder.AddAttribute(46, "font-weight", "600");
            builder.AddContent(47, maxVal.ToString("F2"));
            builder.CloseElement();
        };
    }
}
