@using GlassManagement.Ui.Shared.Models

@if (CloudViz == null || CloudViz.Points == null || CloudViz.Points.Count == 0)
{
    <div class="cloudviz-placeholder" style="height:200px; border:1px dashed #ccc; display:flex; align-items:center; justify-content:center;">云图数据占位</div>
}
else
{
    <div class="cloudviz-container" style="border:1px solid #eee; padding:4px; border-radius:6px; background:#fff;">
      <div style="font-size:12px; color:#666; margin-bottom:6px;">云图（应力/挠度）</div>
<svg width="100%" height="260" viewBox="0 0 600 260" preserveAspectRatio="xMidYMid meet">
    <g stroke="#eeeeee" stroke-width="1">
      @for (int x = 0; x <= 600; x += 60)
      {
        <line x1="@x" y1="0" x2="@x" y2="260" />
      }
      @for (int y = 0; y <= 260; y += 20)
      {
        <line x1="0" y1="@y" x2="600" y2="@y" />
      }
    </g>
    @foreach (var p in CloudViz.Points)
    {
        var cx = (double)p.X * 2.0;
        var cy = (double)p.Y;
        var color = p.Value > 0 ? "#e74c3c" : "#3498db";
        <circle cx="@cx" cy="@cy" r="4" fill="@color" />
    }
    </svg>
    </div>
}

@code {
    [Parameter]
    public CloudVizData CloudViz { get; set; }
}
