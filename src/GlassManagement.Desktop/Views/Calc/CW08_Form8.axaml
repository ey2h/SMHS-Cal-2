<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GlassManagement.Desktop.Views.Calc.CW08_Form8"
             FontFamily="SimSun" FontSize="12">
  <!-- VB6 form: 点式肋（无肋）驳接幕墙设计计算 | client 909x434 | 112 nodes (60 labels) | pairs=55 spread=5px dropped=0 declutter:drop=0 move=0 -->
  <DockPanel>
    <Border DockPanel.Dock="Top" Height="19" Background="{DynamicResource HbTitleBarBg}" BorderBrush="{DynamicResource HbBorder}" BorderThickness="0,0,0,1">
      <TextBlock Text="点式肋（无肋）驳接幕墙设计计算" FontSize="11" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource HbText}"/>
    </Border>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
    <Canvas Width="909" Height="434" Background="{DynamicResource HbFormBg}" ClipToBounds="True">
      <!-- 互斥参数面板（源程序按选项切换显示），共 2 套 -->
      <TabControl Canvas.Left="8" Canvas.Top="11" Width="896" Height="400">
        <TabItem Header="玻璃计算模型">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <Canvas Width="258" Height="55" Background="{DynamicResource HbFormBg}" ClipToBounds="True">
