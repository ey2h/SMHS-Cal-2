          <ComboBox Classes="hb" Canvas.Left="292" Canvas.Top="11" Width="104" Height="20"/>
          <TextBlock Classes="hb" Canvas.Left="16" Canvas.Top="15" Width="60" Height="13" Text="立柱与主体" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
          <TextBlock Classes="hb" Canvas.Left="219" Canvas.Top="15" Width="60" Height="13" Text="横框与立柱" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
          </Canvas>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="单元连接件">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <Canvas Width="418" Height="471" Background="#F0F0F0" ClipToBounds="True">
