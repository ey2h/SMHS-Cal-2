@using System.Text.Json
@using static GlassManagement.Api.Components.Pages.Wizard
@inject GlassApiClient GlassApi

<div class="hb-title-bar">@CurtainWallType 幕墙计算 - 连接件验算</div>

<div class="status-bar" style="margin-bottom:8px;padding:6px 12px;font-size:11px;background:var(--blue-light);border-radius:4px">
    💡 @(CurtainWallType == "天然石材" || CurtainWallType == "金属板" ? "石材/金属板幕墙建议使用钢螺栓(JGJ133)" : "铝合金螺栓(GB50429)，注意区分铝材和钢材下螺栓参数的差异")，直径不小于10mm
</div>

<div style="display:flex;gap:12px;align-items:flex-start">
    <!-- 左侧参数区 -->
    <div style="flex:6;min-width:0">

        <!-- 顶部连接形式选择 -->
        <fieldset class="groupbox">
            <legend class="groupbox-title">连接形式</legend>
            <div class="param-cols-2">
                <div class="param-row">
                    <span class="param-label">立柱与主体</span>
                    <select class="hb-input" @bind="Input.MullionToMainMethod" @bind:after="OnConnectionMethodChanged">
                        <option>螺栓连接</option>
                        <option>焊接</option>
                    </select>
                </div>
                <div class="param-row">
                    <span class="param-label">横框与立柱</span>
                    <select class="hb-input" @bind="Input.TransomToMullionMethod" @bind:after="OnConnectionMethodChanged">
                        <option>螺栓连接</option>
                        <option>焊接</option>
                        <option>半焊接半栓接</option>
                    </select>
                </div>
            </div>
        </fieldset>

        <!-- ================== 横框与立柱区域 ================== -->
        <fieldset class="groupbox">
            <legend class="groupbox-title">横框与立柱连接 — @Input.TransomToMullionMethod</legend>

            <!-- 只读材质信息 -->
            <div class="param-cols-2" style="margin-bottom:6px">
                <div class="param-row">
                    <span class="param-label">立柱材质</span>
                    <input class="hb-input" value="@_mullionMaterialDisplay" readonly style="background:var(--bg-page)" />
                </div>
                <div class="param-row">
                    <span class="param-label">横梁材质</span>
                    <input class="hb-input" value="@_transomMaterialDisplay" readonly style="background:var(--bg-page)" />
                </div>
            </div>

            @if (Input.TransomToMullionMethod == "螺栓连接" || Input.TransomToMullionMethod == "半焊接半栓接")
            {
                <!-- 栓接参数 -->
                @if (Input.TransomToMullionMethod == "半焊接半栓接")
                {
                    <div style="display:flex;gap:12px">
                        <div style="flex:1">
                            <div style="font-size:11px;font-weight:600;margin-bottom:4px;color:var(--text-muted)">▸ 焊缝参数</div>
                            @RenderTransomWeldParams()
                        </div>
                        <div style="flex:1">
                            <div style="font-size:11px;font-weight:600;margin-bottom:4px;color:var(--text-muted)">▸ 栓接参数</div>
                            @RenderTransomBoltParams()
                        </div>
                    </div>
                }
                else
                {
                    @RenderTransomBoltParams()
                }

                <!-- 螺栓1表格: 立柱与角片 -->
                <div style="margin-top:8px;font-size:11px;font-weight:600">立柱与角片连接螺栓（螺栓1）</div>
                @RenderBoltTable(_bolt1Data, Input.SelectedBolt1Index, idx => Input.SelectedBolt1Index = idx)

                <!-- 螺栓2表格: 横框与角片 -->
                <div style="margin-top:8px;font-size:11px;font-weight:600">横框与角片连接螺栓（螺栓2）</div>
                @RenderBoltTable(_bolt2Data, Input.SelectedBolt2Index, idx => Input.SelectedBolt2Index = idx)
            }

            @if (Input.TransomToMullionMethod == "焊接")
            {
                @RenderTransomWeldParams()
            }

            <!-- 验算结果 -->
            <div class="metric-grid" style="margin-top:8px">
                @if (Input.TransomToMullionMethod != "焊接")
                {
                    <div class="metric-card">
                        <div class="metric-label">螺栓抗剪</div>
                        <span class="@(Input.TransomBoltShearPass?"badge-pass":"badge-fail")">@(Input.TransomBoltShearPass?"✅通过":"❌不通过")</span>
                    </div>
                    <div class="metric-card">
                        <div class="metric-label">螺栓承压</div>
                        <span class="@(Input.TransomBoltBearingPass?"badge-pass":"badge-fail")">@(Input.TransomBoltBearingPass?"✅通过":"❌不通过")</span>
                    </div>
                }
                @if (Input.TransomToMullionMethod != "螺栓连接")
                {
                    <div class="metric-card">
                        <div class="metric-label">焊缝验算</div>
                        <span class="@(Input.TransomWeldPass?"badge-pass":"badge-fail")">@(Input.TransomWeldPass?"✅通过":"❌不通过")</span>
                    </div>
                }
                <div class="metric-card">
                    <div class="metric-label">利用率</div>
                    <div class="metric-value">@(Input.TransomBoltUtilization.ToString("F1"))%</div>
                </div>
            </div>
        </fieldset>

        <!-- ================== 立柱与主体区域 ================== -->
        <fieldset class="groupbox">
            <legend class="groupbox-title">立柱与主体连接（钢转接件）— @Input.MullionToMainMethod</legend>

            @if (Input.MullionToMainMethod == "螺栓连接")
            {
                <div class="param-cols-4">
                    <div class="param-row">
                        <span class="param-label">角片材质</span>
                        <select class="hb-input" @bind="Input.MainAngleMaterial">
                            <option>Q235</option><option>Q355</option>
                        </select>
                    </div>
                    <div class="param-row">
                        <span class="param-label">角片壁厚</span>
                        <input class="hb-input" type="number" @bind="Input.MainAngleThickness" step="0.5" />
                        <span class="param-unit">mm</span>
                    </div>
                    <div class="param-row">
                        <span class="param-label">竖框螺栓数</span>
                        <select class="hb-input" @bind="Input.MainMullionBoltCount">
                            <option value="2">2</option>
                        </select>
                    </div>
                    <div class="param-row">
                        <span class="param-label">触面面数</span>
                        <select class="hb-input" @bind="Input.ContactSurfaces">
                            <option value="1">1</option>
                            <option value="2">2</option>
                        </select>
                    </div>
                </div>
                <div style="margin-top:4px">
                    <label style="font-size:12px;cursor:pointer" title="有角部处理或单臂型材立柱时一般多用单侧角码，正常情况下角码是两侧的">
                        <input type="checkbox" @bind="Input.SingleSideBracket" /> 单侧角码
                        <span style="font-size:10px;color:var(--text-muted);margin-left:4px">ⓘ 角部处理或单臂型材立柱时使用</span>
                    </label>
                </div>

                <!-- 螺栓4表格: 立柱与主体 -->
                <div style="margin-top:8px;font-size:11px;font-weight:600">立柱与主体连接螺栓（螺栓4）</div>
                @RenderBolt4Table()
            }
            else
            {
                <!-- 焊接模式 -->
                <div style="margin-bottom:4px">
                    <label style="font-size:12px;cursor:pointer">
                        <input type="checkbox" @bind="Input.SingleSideAdapter" /> 单侧转接件
                    </label>
                </div>
                <div class="param-cols-2">
                    <div class="param-row">
                        <span class="param-label">角焊缝高度</span>
                        <input class="hb-input" type="number" @bind="Input.MainWeldHeight" step="0.5" />
                        <span class="param-unit">mm</span>
                        <button class="hb-btn" type="button" style="height:18px;width:18px;padding:0;font-size:10px;margin-left:4px;border-radius:50%" @onclick="() => _showWeldHelp = true" title="焊缝帮助">?</button>
                    </div>
                    <div class="param-row">
                        <span class="param-label">每角码总焊缝有效长</span>
                        <input class="hb-input" type="number" @bind="Input.MainWeldLength" step="1" />
                        <span class="param-unit">mm</span>
                    </div>
                </div>
            }

            <!-- 验算结果 -->
            <div class="metric-grid" style="margin-top:8px">
                @if (Input.MullionToMainMethod == "螺栓连接")
                {
                    <div class="metric-card">
                        <div class="metric-label">螺栓抗剪</div>
                        <span class="@(Input.MainBoltShearPass?"badge-pass":"badge-fail")">@(Input.MainBoltShearPass?"✅通过":"❌不通过")</span>
                    </div>
                    <div class="metric-card">
                        <div class="metric-label">螺栓承压</div>
                        <span class="@(Input.MainBoltBearingPass?"badge-pass":"badge-fail")">@(Input.MainBoltBearingPass?"✅通过":"❌不通过")</span>
                    </div>
                }
                else
                {
                    <div class="metric-card">
                        <div class="metric-label">焊缝验算</div>
                        <span class="@(Input.MainWeldPass?"badge-pass":"badge-fail")">@(Input.MainWeldPass?"✅通过":"❌不通过")</span>
                    </div>
                }
                <div class="metric-card">
                    <div class="metric-label">利用率</div>
                    <div class="metric-value">@(Input.MainBoltUtilization.ToString("F1"))%</div>
                </div>
            </div>
        </fieldset>
    </div>

    <!-- 右侧：连接简图 -->
    <div style="flex:4;min-width:0">
        <fieldset class="groupbox">
            <legend class="groupbox-title">连接节点示意图</legend>
            <div style="text-align:center;margin-bottom:12px">
                @if (Input.TransomToMullionMethod != "焊接")
                {
                    <div style="font-size:11px;font-weight:600;margin-bottom:6px">横框与立柱 — 角码螺栓连接</div>
                    @((MarkupString)SvgBoltConnection())
                }
                else
                {
                    <div style="font-size:11px;font-weight:600;margin-bottom:6px">横框与立柱 — 焊缝连接</div>
                    @((MarkupString)SvgWeldConnection())
                }
            </div>
            <div style="text-align:center">
                <div style="font-size:11px;font-weight:600;margin-bottom:6px">立柱与主体结构 — 转接件连接</div>
                @((MarkupString)SvgAdapterConnection())
            </div>
        </fieldset>

        <!-- 验算公式参考 -->
        <fieldset class="groupbox" style="margin-top:8px">
            <legend class="groupbox-title">验算公式</legend>
            <div style="font-size:11px;line-height:1.8;color:var(--text-muted)">
                @if (Input.TransomToMullionMethod != "焊接" || Input.MullionToMainMethod == "螺栓连接")
                {
                    <div><b>螺栓抗剪:</b> N<sub>vb</sub> = 0.4 × f<sub>ub</sub> × A</div>
                    <div><b>螺栓承压:</b> N<sub>cb</sub> = d × t × f<sub>b</sub></div>
                    <div><b>验算:</b> V ≤ n × min(N<sub>vb</sub>, N<sub>cb</sub>)</div>
                }
                @if (Input.TransomToMullionMethod != "螺栓连接" || Input.MullionToMainMethod == "焊接")
                {
                    <div style="margin-top:6px"><b>焊缝抗剪:</b> τ<sub>f</sub> = V / (h<sub>e</sub> × l<sub>w</sub>) ≤ f<sub>fw</sub></div>
                    <div><b>有效厚度:</b> h<sub>e</sub> = 0.7 × h<sub>f</sub></div>
                    <div><b>f<sub>fw</sub>:</b> Q235=160MPa, Q355=200MPa</div>
                }
            </div>
        </fieldset>
    </div>
</div>

<!-- 焊缝帮助弹窗 -->
@if (_showWeldHelp)
{
    <div style="position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.4);z-index:9999;display:flex;align-items:center;justify-content:center" @onclick="() => _showWeldHelp = false">
        <div style="background:var(--bg-white);border-radius:8px;padding:24px;min-width:320px;box-shadow:0 8px 32px rgba(0,0,0,0.2)" @onclick:stopPropagation>
            <h3 style="margin:0 0 12px;font-size:15px">📐 焊缝说明</h3>
            <div style="font-size:13px;line-height:1.8">
                <p><b>有效焊缝长度 = 实际焊缝长度 - 2h<sub>f</sub></b></p>
                <p style="color:var(--text-muted);font-size:12px">其中 h<sub>f</sub> 为焊缝高度（焊脚尺寸）。每段焊缝的有效长度均需扣减两端各 h<sub>f</sub>。</p>
                @((MarkupString)SvgWeldHelp())
            </div>
            <div style="text-align:right;margin-top:12px">
                <button class="hb-btn" @onclick="() => _showWeldHelp = false">关闭</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Step5Data Input { get; set; } = new();
    [Parameter] public Step3Data? Step3Input { get; set; }
    [Parameter] public Step4Data? Step4Input { get; set; }
    [Parameter] public string CurtainWallType { get; set; } = "全隐框玻璃";

    private List<JsonElement> _bolt1Data = new();
    private List<JsonElement> _bolt2Data = new();
    private List<JsonElement> _bolt4Data = new();
    private bool _loading = true;
    private bool _showWeldHelp;

    private string _mullionMaterialDisplay => Step3Input?.Material == "铝合金"
        ? $"铝合金 {Step3Input.AluminumGrade}" : Step3Input?.Material == "钢材"
        ? $"钢材 {Step3Input.SteelGrade}" : Step3Input?.Material ?? "未设置";

    private string _transomMaterialDisplay => Step4Input?.Material == "铝合金"
        ? $"铝合金 {Step4Input.AluminumGrade}" : Step4Input?.Material == "钢材"
        ? $"钢材 {Step4Input.SteelGrade}" : Step4Input?.Material ?? "未设置";

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            var allBolts = await GlassApi.GetBoltsAsync();
            // Split by bolt category: 螺栓1(0-47), 螺栓2(48-95), 螺栓4(144-191)
            // If not enough data, use all for each
            if (allBolts.Count >= 192)
            {
                _bolt1Data = allBolts.GetRange(0, 48);
                _bolt2Data = allBolts.GetRange(48, 48);
                _bolt4Data = allBolts.GetRange(144, 48);
            }
            else
            {
                // Fallback: use same data for all tables
                _bolt1Data = allBolts.Take(48).ToList();
                _bolt2Data = _bolt1Data;
                _bolt4Data = _bolt1Data;
            }
        }
        catch { /* silent */ }
        _loading = false;
        RunVerification();
    }

    private void OnConnectionMethodChanged()
    {
        RunVerification();
        StateHasChanged();
    }

    /// <summary>
    /// 连接件验算 — JGJ133-2001 / GB50429
    /// 螺栓抗剪: Nvb = 0.4·fub·A  (单螺栓抗剪承载力)
    /// 螺栓承压: Ncb = d·t·fb  (单螺栓承压承载力)
    /// 焊缝: τf = V/(he·lw) ≤ ffw  (角焊缝抗剪)
    /// </summary>
    private void RunVerification()
    {
        double reactionV = Step3Input?.ReactionForce ?? 0; // kN

        // 横框与立柱螺栓验算
        if (Input.TransomToMullionMethod != "焊接")
        {
            var bolt = GetSelectedBolt(_bolt1Data, Input.SelectedBolt1Index);
            if (bolt != null)
            {
                double d = GetDouble(bolt.Value, "diameter");
                double A = GetDouble(bolt.Value, "effectiveDiameter");
                A = Math.PI * A * A / 4.0; // effective area mm²
                double fub = GetDouble(bolt.Value, "shearStress"); // MPa
                double Nvb = 0.4 * fub * A / 1000.0; // kN
                double t = Input.AnglePieceThickness;
                double fb = fub * 0.6; // approximate bearing strength
                double Ncb = d * t * fb / 1000.0; // kN
                int n = Input.MullionBoltCount;
                double capacity = n * Math.Min(Nvb, Ncb);
                Input.TransomBoltShearPass = reactionV <= capacity || reactionV == 0;
                Input.TransomBoltBearingPass = Input.TransomBoltShearPass;
                Input.TransomBoltUtilization = capacity > 0 ? reactionV / capacity * 100 : 0;
            }
        }

        // 横框焊缝验算
        if (Input.TransomToMullionMethod != "螺栓连接")
        {
            double he = 0.7 * Input.TransomWeldHeight;
            double lw = Input.TransomWeldLength;
            if (he > 0 && lw > 0)
            {
                double tau = reactionV * 1000 / (he * lw); // MPa
                double ffw = 160; // Q235 default
                Input.TransomWeldPass = tau <= ffw || reactionV == 0;
                Input.TransomWeldUtilization = ffw > 0 ? tau / ffw * 100 : 0;
            }
        }

        // 立柱与主体螺栓验算
        if (Input.MullionToMainMethod == "螺栓连接")
        {
            var bolt = GetSelectedBolt(_bolt4Data, Input.SelectedBolt4Index);
            if (bolt != null)
            {
                double d = GetDouble(bolt.Value, "diameter");
                double A = GetDouble(bolt.Value, "effectiveDiameter");
                A = Math.PI * A * A / 4.0;
                double fub = GetDouble(bolt.Value, "shearStress");
                double Nvb = 0.4 * fub * A / 1000.0;
                double t = Input.MainAngleThickness;
                double fb = fub * 0.6;
                double Ncb = d * t * fb / 1000.0;
                int n = Input.MainMullionBoltCount * Input.ContactSurfaces;
                if (Input.SingleSideBracket) n = (int)Math.Ceiling(n / 2.0);
                double capacity = n * Math.Min(Nvb, Ncb);
                Input.MainBoltShearPass = reactionV <= capacity || reactionV == 0;
                Input.MainBoltBearingPass = Input.MainBoltShearPass;
                Input.MainBoltUtilization = capacity > 0 ? reactionV / capacity * 100 : 0;
            }
        }
        else
        {
            // 立柱与主体焊缝验算
            double he = 0.7 * Input.MainWeldHeight;
            double lw = Input.MainWeldLength;
            if (he > 0 && lw > 0)
            {
                double multiplier = Input.SingleSideAdapter ? 1.0 : 2.0;
                double tau = reactionV * 1000 / (he * lw * multiplier);
                double ffw = Input.MainAngleMaterial == "Q355" ? 200 : 160;
                Input.MainWeldPass = tau <= ffw || reactionV == 0;
                Input.MainWeldUtilization = ffw > 0 ? tau / ffw * 100 : 0;
            }
        }
    }

    private JsonElement? GetSelectedBolt(List<JsonElement> data, int idx)
    {
        if (idx >= 0 && idx < data.Count) return data[idx];
        if (data.Count > 0) return data[0];
        return null;
    }

    // ===== Render helpers =====

    private RenderFragment RenderTransomBoltParams() => __builder =>
    {
        <div class="param-cols-4">
            <div class="param-row">
                <span class="param-label">角片材质</span>
                <select class="hb-input" @bind="Input.AnglePieceMaterial">
                    <option>6063-T5</option><option>6063-T6</option><option>6063A-T5</option><option>6063A-T6</option><option>6061-T4</option><option>6061-T6</option>
                </select>
            </div>
            <div class="param-row">
                <span class="param-label">角片厚度</span>
                <input class="hb-input" type="number" @bind="Input.AnglePieceThickness" step="0.5" />
                <span class="param-unit">mm</span>
            </div>
            <div class="param-row">
                <span class="param-label">竖框螺栓数</span>
                <select class="hb-input" @bind="Input.MullionBoltCount">
                    <option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option>
                </select>
            </div>
            <div class="param-row">
                <span class="param-label">横框螺栓数</span>
                <select class="hb-input" @bind="Input.TransomBoltCount">
                    <option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option>
                </select>
            </div>
        </div>
    };

    private RenderFragment RenderTransomWeldParams() => __builder =>
    {
        <div class="param-cols-2">
            <div class="param-row">
                <span class="param-label">角焊缝高度 h<sub>f</sub></span>
                <input class="hb-input" type="number" @bind="Input.TransomWeldHeight" step="0.5" />
                <span class="param-unit">mm</span>
                <button class="hb-btn" type="button" style="height:18px;width:18px;padding:0;font-size:10px;margin-left:4px;border-radius:50%" @onclick="() => _showWeldHelp = true" title="焊缝帮助">?</button>
            </div>
            <div class="param-row">
                <span class="param-label">总有效长度</span>
                <input class="hb-input" type="number" @bind="Input.TransomWeldLength" step="1" />
                <span class="param-unit">mm</span>
            </div>
        </div>
    };

    private RenderFragment RenderBoltTable(List<JsonElement> data, int selectedIdx, Action<int> onSelect) => __builder =>
    {
        if (_loading)
        {
            <div style="text-align:center;padding:8px;color:var(--text-muted)"><span class="spinner"></span> 加载中...</div>
        }
        else
        {
            <div style="max-height:180px;overflow:auto;margin-top:4px">
                <table class="hb-table" style="font-size:11px">
                    <thead>
                        <tr><th>型号</th><th>公称直径</th><th>有效直径</th><th>材质</th><th>剪应力</th><th>拉应力</th><th>备注</th></tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < data.Count; i++)
                        {
                            var idx = i;
                            var b = data[i];
                            var sel = idx == selectedIdx;
                            <tr class="@(sel?"selected":"")" @onclick="() => { onSelect(idx); RunVerification(); StateHasChanged(); }" style="cursor:pointer">
                                <td>@GetStr(b,"model")</td>
                                <td>@GetNum(b,"diameter")</td>
                                <td>@GetNum(b,"effectiveDiameter")</td>
                                <td>@GetStr(b,"material")</td>
                                <td>@GetNum(b,"shearStress")</td>
                                <td>@GetNum(b,"tensileStress")</td>
                                <td>@GetStr(b,"remark")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    };

    private RenderFragment RenderBolt4Table() => __builder =>
    {
        if (_loading)
        {
            <div style="text-align:center;padding:8px;color:var(--text-muted)"><span class="spinner"></span> 加载中...</div>
        }
        else
        {
            <div style="max-height:180px;overflow:auto;margin-top:4px">
                <table class="hb-table" style="font-size:11px">
                    <thead>
                        <tr><th>型号</th><th>公称直径</th><th>有效直径</th><th>材质</th><th>剪应力</th><th>拉应力</th><th>孔径</th><th>备注</th></tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < _bolt4Data.Count; i++)
                        {
                            var idx = i;
                            var b = _bolt4Data[i];
                            var sel = idx == Input.SelectedBolt4Index;
                            <tr class="@(sel?"selected":"")" @onclick="() => { Input.SelectedBolt4Index = idx; RunVerification(); StateHasChanged(); }" style="cursor:pointer">
                                <td>@GetStr(b,"model")</td>
                                <td>@GetNum(b,"diameter")</td>
                                <td>@GetNum(b,"effectiveDiameter")</td>
                                <td>@GetStr(b,"material")</td>
                                <td>@GetNum(b,"shearStress")</td>
                                <td>@GetNum(b,"tensileStress")</td>
                                <td>@GetNum(b,"holeDiameter")</td>
                                <td>@GetStr(b,"remark")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    };

