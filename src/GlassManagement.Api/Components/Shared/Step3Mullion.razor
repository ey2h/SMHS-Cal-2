    /// <summary>
    /// 立柱验算 — JGJ102-2003 §5.3
    /// 抗弯验算: σ = M/W ≤ [σ]  (§5.3.2)
    /// 挠度验算: δ = deflCoeff·q·L⁴/(EI) ≤ L/180  (§5.3.3)
    /// 抗剪验算: τ = V·S/(I·b) ≤ [τ]  (§5.3.4)
    /// </summary>
    private void Recalc()
    {
        // 材料参数
        double E;
        if (Input.Material == "铝合金")
        {
            E = 70000;
            Input.AllowableStress = Input.AluminumGrade switch
            {
                "6063-T5" => 85, "6063-T6" => 100, "6061-T4" => 55, "6061-T6" => 135,
                "6063A-T5" => 85, "6063A-T6" => 100, _ => 85
            };
            Input.AllowableShear = Input.AluminumGrade switch
            {
                "6063-T5" => 50, "6063-T6" => 60, "6061-T4" => 32, "6061-T6" => 80,
                "6063A-T5" => 50, "6063A-T6" => 60, _ => 50
            };
        }
        else if (Input.Material == "钢材")
        {
            E = 206000;
            Input.AllowableStress = Input.SteelGrade == "Q355" ? 310 : 215;
            Input.AllowableShear = Input.SteelGrade == "Q355" ? 180 : 125;
        }
        else
        {
            E = Input.ElasticModulus > 0 ? Input.ElasticModulus : 70000;
        }

        if (Input.Wx1 <= 0 || Input.Ix <= 0) return;

        double L = Input.Span;
        double wk = Input.WindLoadStd > 0 ? Input.WindLoadStd : 1.0;
        double B = Input.TributaryWidth > 0 ? Input.TributaryWidth : 1200;
        double q = wk * B / 1000.0;

        // 力学模型系数 — 按力学模型区分弯矩/挠度系数
        // ①②单跨简支: M=qL²/8, δ=5qL⁴/(384EI)
        // ③连续梁(四点三跨): M=qL²/10, δ≈qL⁴/(145EI)
        // ④多跨铰接静定梁: M=qL²/8(每跨简支), δ=5qL⁴/(384EI)
        // ⑤双跨梁: M=9qL²/128, δ≈qL⁴/(185EI)
        // ⑥多跨超静定: M=qL²/12(中间跨), δ≈qL⁴/(384EI)
        double momentCoeff = Input.MechanicalModel switch
        {
            1 or 2 => 1.0 / 8.0,           // qL²/8
            3 => 1.0 / 10.0,               // qL²/10
            4 => 1.0 / 8.0,                // qL²/8 (每跨简支)
            5 => 9.0 / 128.0,              // 9qL²/128
            6 => 1.0 / 12.0,               // qL²/12
            _ => 1.0 / 8.0
        };
        double deflCoeff = Input.MechanicalModel switch
        {
            1 or 2 => 5.0 / 384.0,         // 5/(384)
            3 => 1.0 / 145.0,              // 1/145
            4 => 5.0 / 384.0,              // 同单跨简支
            5 => 1.0 / 185.0,              // 1/185
            6 => 1.0 / 384.0,              // 1/384
            _ => 5.0 / 384.0
        };

        double M = momentCoeff * q * L * L;
        Input.MomentRequired = Math.Round(M / (Input.AllowableStress * 1000), 0);

        bool isSteel = Input.Material == "钢材";
        double defLimit;
        switch (Input.DeflectionStandard)
        {
            case "JGJ133-2001":
                defLimit = L <= 7500
                    ? (isSteel ? Math.Min(L / 300.0, 15.0) : Math.Min(L / 180.0, 20.0))
                    : L / 250.0;
                break;
            case "JGJ102-2003":
                defLimit = isSteel ? L / 250.0 : L / 180.0;
                break;
            case "JGJ336-2016":
                defLimit = L <= 4500 ? L / 180.0 : L <= 7000 ? L / 250.0 + 7.0 : L / 200.0;
                break;
            case "GB/T21086-2007":
                defLimit = isSteel ? L / 250.0 : L / 180.0;
                double absMax = L <= 4500 ? 20.0 : 30.0;
                defLimit = Math.Min(defLimit, absMax);
                break;
            case "上海规范":
                defLimit = L / 200.0;
                break;
            default:
                defLimit = L / 180.0;
                break;
        }
        Input.DeflectionLimit = Math.Round(defLimit, 3);
        Input.InertiaRequired = Input.DeflectionLimit > 0
            ? Math.Round(deflCoeff * q * Math.Pow(L, 3) / (E * Input.DeflectionLimit) / 10, 0) : 0;

        double IxMm4 = Input.Ix * 1e4;
        Input.InertiaPass = Input.Ix >= Input.InertiaRequired / 1e4;
        Input.BendingMomentPass = Input.Wx1 >= Input.MomentRequired / 1e3;
        Input.ActualDeflection = Math.Round(deflCoeff * q * Math.Pow(L, 4) / (E * IxMm4), 3);
        Input.DeflectionPass = Input.ActualDeflection <= Input.DeflectionLimit;
        Input.BendingStress = Math.Round(M / (Input.Wx1 * 1e3), 3);
        Input.BendingPass = Input.BendingStress <= Input.AllowableStress;

        double V = q * L / 2.0;
        double SxVal = Input.Sx > 0 ? Input.Sx * 1e3 : Input.Wx1 * 1e3 * 0.5;
        Input.ShearStress = Math.Round(V * SxVal / (IxMm4 * (Input.Tw > 0 ? Input.Tw : 3)), 3);
        Input.ShearPass = Input.ShearStress <= Input.AllowableShear;
        Input.ReactionForce = Math.Round(q * L / 2.0 / 1e3, 3);
    }

