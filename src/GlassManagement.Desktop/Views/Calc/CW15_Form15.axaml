          <TextBlock Classes="hb" Canvas.Left="31" Canvas.Top="350" Width="54" Height="13" Text="尺寸参数B" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
          <TextBlock Classes="hb" Canvas.Left="151" Canvas.Top="350" Width="12" Height="13" Text="mm" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
          <TextBlock Classes="hb" Canvas.Left="207" Canvas.Top="350" Width="72" Height="13" Text="钢转接件壁厚" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
          <ComboBox Classes="hb" Canvas.Left="15" Canvas.Top="355" Width="73" Height="20"/>
          <ComboBox Classes="hb" Canvas.Left="150" Canvas.Top="355" Width="57" Height="20"/>
          <TextBox Classes="hb" Canvas.Left="94" Canvas.Top="356" Width="33" Height="18" FontSize="12" Text="6"/>
          <TextBox Classes="hb" Canvas.Left="205" Canvas.Top="367" Width="44" Height="18" FontSize="12" Text="6"/>
          <TextBlock Classes="hb" Canvas.Left="56" Canvas.Top="370" Width="60" Height="13" Text="角焊缝高度" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
          <TextBox Classes="hb" Canvas.Left="106" Canvas.Top="371" Width="42" Height="18" FontSize="12" Text="20"/>
          <TextBox Classes="hb" Canvas.Left="295" Canvas.Top="371" Width="45" Height="18" FontSize="12" Text="10"/>
          <TextBlock Classes="hb" Canvas.Left="31" Canvas.Top="374" Width="72" Height="13" Text="挂轴有效直径" FontSize="10" TextWrapping="Wrap" LineHeight="13"/>
